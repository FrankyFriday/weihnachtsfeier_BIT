<label class="framework-select">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span>@Label</span>
    }
    <select value="@Value" disabled="@Disabled" @onchange="OnValueChanged">
        @if (!string.IsNullOrWhiteSpace(Placeholder))
        {
            <option value="">@Placeholder</option>
        }
        @foreach (var option in Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
</label>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<FrameworkSelectOption> Options { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }

    private Task OnValueChanged(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString());
}