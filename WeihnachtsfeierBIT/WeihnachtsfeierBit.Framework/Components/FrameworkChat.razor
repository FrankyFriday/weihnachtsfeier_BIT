    private void RequestDeleteGroup(Guid groupId)
    {
        if (IsAdmin) _groupToDeleteId = groupId;
    }

    private void CancelDeleteGroup()
    {
        _groupToDeleteId = null;
    }

    private async Task ConfirmDeleteGroupAsync()
    {
        if (!_groupToDeleteId.HasValue || !IsAdmin || string.IsNullOrEmpty(AccessToken)) return;
        var groupId = _groupToDeleteId.Value;
        _groupToDeleteId = null;

        try
        {
            await ProjectApiClient.DeleteChatGroupAsync(AccessToken, ProjectId, groupId);
