    private async Task OnMessagesScroll(EventArgs e)
    {
        try
        {
            var res = await JS.InvokeAsync<JsonElement>("eval", "(() => { const el = document.querySelector('div[style*=\"overflow-y: auto\"]'); if(!el) return {scrollTop:0, scrollHeight:0, clientHeight:0}; return {scrollTop: el.scrollTop, scrollHeight: el.scrollHeight, clientHeight: el.clientHeight}; })()");
            double scrollTop = res.GetProperty("scrollTop").GetDouble();
            double scrollHeight = res.GetProperty("scrollHeight").GetDouble();
            double clientHeight = res.GetProperty("clientHeight").GetDouble();

            _isScrolledUp = (scrollHeight - scrollTop - clientHeight) > 100;
            StateHasChanged();
        }
        catch
        {
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "(() => { const el = document.querySelector('div[style*=\"overflow-y: auto\"]'); if(el) el.scrollTop = el.scrollHeight; })()");
            _isScrolledUp = false;
            StateHasChanged();
        }
        catch
        {
        }
    }

    private async Task SetupSignalRAsync()
    {
        if (_handlersRegistered) return;

        if (HubConnection is not null)
        {
            _activeConnection = HubConnection;
            _isLocalHubConnection = false;
        }
        else
        {
            if (string.IsNullOrEmpty(AccessToken)) return;
            var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https+http://apiservice";
            var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/gamestate";

            _activeConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                    options.AccessTokenProvider = () => Task.FromResult<string?>(AccessToken))
                .Build();
            _isLocalHubConnection = true;
        }

        _activeConnection.On<ChatMessageResponse>("ReceiveChatMessage", async msg =>
        {
            await InvokeAsync(async () =>
            {
                if (_selectedGroupId.HasValue && msg.ChatGroupId == _selectedGroupId.Value && _currentView == "room")
                {
                    _messages = [.. _messages, msg];
                    StateHasChanged();
                    if (!_isScrolledUp)
                    {
                        await ScrollToBottom();
                    }
                }

                await LoadGroupsAsync();
            });
        });

        _activeConnection.On<Guid>("ReceiveMessageDeleted", async messageId =>
        {
            await InvokeAsync(() =>
            {
                _messages = _messages.Where(m => m.Id != messageId).ToArray();
                StateHasChanged();
            });
            await LoadGroupsAsync();
        });

        _activeConnection.On<Guid>("ReceiveGroupDeleted", async groupId =>
        {
            await InvokeAsync(() =>
            {
                _groups = _groups.Where(g => g.Id != groupId).ToArray();
                if (_selectedGroupId == groupId)
                {
                    _currentView = "overview";
                    _selectedGroupId = null;
                }
                StateHasChanged();
            });
        });

        _activeConnection.On<Guid, string>("ReceiveGroupRenamed", async (groupId, newName) =>
        {
            await InvokeAsync(() =>
            {
                _groups = _groups.Select(g => g.Id == groupId ? new ChatGroupSummary(g.Id, newName, g.Type, g.AssociatedTeamId, g.MemberCount, g.LastMessageText, g.LastMessageAtUtc, g.UnreadCount, g.LastMessageSenderName) : g).ToArray();
                StateHasChanged();
            });
        });

        _activeConnection.On("ParticipantPermissionsChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                var previouslyHadChatAccess = CanReadChat;
                if (!string.IsNullOrEmpty(AccessToken))
                {
                    var participant = await ProjectApiClient.GetCurrentParticipantAsync(AccessToken, ProjectId);
                    _resolvedPermissions = participant.Permissions;
                }

                _chatAccessDenied = EffectivePermissions?.HasPermission(ParticipantPermissionKeys.CanReadChat) == false;
                if (!CanReadChat)
                {
                    _groups = [];
                    _messages = [];
                    _selectedGroupId = null;
                    _currentView = "overview";
                    _isCreateModalOpen = false;
                }
                else if (!previouslyHadChatAccess)
                {
                    await LoadGroupsAsync();
                }

                StateHasChanged();
            });
        });

        _handlersRegistered = true;

        if (_isLocalHubConnection && _activeConnection is not null)
        {
            _connectionCancellation = new CancellationTokenSource();
            _connectionRecoveryTask = RecoverConnectionAsync(_activeConnection, _connectionCancellation.Token);
        }
    }

    private async Task RecoverConnectionAsync(HubConnection connection, CancellationToken cancellationToken)
    {
        await HubConnectionRecovery.RunAsync(
            connection,
            async token =>
            {
                await connection.SendAsync("JoinProject", ProjectId, token);
                await InvokeAsync(async () =>
                {
                    if (_selectedGroupId is Guid groupId && _currentView == "room")
                    {
                        _messages = await ProjectApiClient.GetChatMessagesAsync(AccessToken, ProjectId, groupId, token);
                    }

                    await LoadGroupsAsync();
                });
            },
            exception => Logger.LogWarning(exception, "Die Chat-Liveverbindung wird erneut aufgebaut."),
            _ => Task.CompletedTask,
            cancellationToken);
    }

    public async ValueTask DisposeAsync()
    {
        if (_isLocalHubConnection)
        {
            _connectionCancellation?.Cancel();
            if (_connectionRecoveryTask is not null)
            {
                await _connectionRecoveryTask;
            }

            _connectionCancellation?.Dispose();
            if (_activeConnection is not null)
            {
                try
                {
                    await _activeConnection.SendAsync("LeaveProject", ProjectId);
                    await _activeConnection.DisposeAsync();
                }
                catch
                {
                }
            }
        }
    }
}
