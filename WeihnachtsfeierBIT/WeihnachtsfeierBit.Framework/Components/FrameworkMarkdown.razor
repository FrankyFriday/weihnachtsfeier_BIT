@namespace WeihnachtsfeierBit.Framework
@using System.Net
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components

<div class="framework-markdown @Class" style="@Style">
    @foreach (var block in RenderMarkdownBlocks(Content))
    {
        @block
    }
</div>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private static readonly Regex HeadingPattern = new(@"^(#{1,6})\s+(.+?)\s*#*\s*$", RegexOptions.Compiled);
    private static readonly Regex UnorderedListPattern = new(@"^\s*[-*+]\s+(.+)$", RegexOptions.Compiled);
    private static readonly Regex OrderedListPattern = new(@"^\s*\d+[.)]\s+(.+)$", RegexOptions.Compiled);
    private static readonly Regex HorizontalRulePattern = new(@"^\s*(?:(?:\*\s*){3,}|(?:-\s*){3,}|(?:_\s*){3,})$", RegexOptions.Compiled);
    private static readonly Regex TableSeparatorPattern = new(@"^:?-{3,}:?$", RegexOptions.Compiled);

    private static IEnumerable<RenderFragment> RenderMarkdownBlocks(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            yield break;
        }

        var lines = markdown.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var index = 0;

        while (index < lines.Length)
        {
            var line = lines[index].TrimEnd();
            if (string.IsNullOrWhiteSpace(line))
            {
                index++;
                continue;
            }

            if (line.TrimStart().StartsWith("```", StringComparison.Ordinal))
            {
                index++;
                var codeLines = new List<string>();
                while (index < lines.Length && !lines[index].TrimStart().StartsWith("```", StringComparison.Ordinal))
                {
                    codeLines.Add(lines[index]);
                    index++;
                }

                if (index < lines.Length)
                {
                    index++;
                }

                yield return RenderMarkup(
                    $"<pre class=\"framework-markdown-code\"><code>{HtmlEncoder.Default.Encode(string.Join("\n", codeLines))}</code></pre>");
                continue;
            }

            var headingMatch = HeadingPattern.Match(line.TrimStart());
            if (headingMatch.Success)
            {
                var level = headingMatch.Groups[1].Value.Length;
                var text = FormatInline(headingMatch.Groups[2].Value);
                yield return RenderMarkup($"<h{level} class=\"framework-markdown-heading\">{text}</h{level}>");
                index++;
                continue;
            }

            if (HorizontalRulePattern.IsMatch(line))
            {
                yield return RenderMarkup("<hr class=\"framework-markdown-rule\">");
                index++;
                continue;
            }

            if (IsTableStart(lines, index))
            {
                var table = RenderTable(lines, index);
                yield return table.Block;
                index = table.NextIndex;
                continue;
            }

            if (line.TrimStart().StartsWith(">"))
            {
                var quoteLines = new List<string>();
                while (index < lines.Length && lines[index].TrimStart().StartsWith(">"))
                {
                    quoteLines.Add(lines[index].TrimStart()[1..].TrimStart());
                    index++;
                }

                var quote = string.Join("<br>", quoteLines.Select(FormatInline));
                yield return RenderMarkup($"<blockquote class=\"framework-markdown-quote\"><p>{quote}</p></blockquote>");
                continue;
            }

            if (TryGetListKind(line, out var isOrdered))
            {
                var items = new List<string>();
                while (index < lines.Length && TryGetListKind(lines[index], out var currentIsOrdered) && currentIsOrdered == isOrdered)
                {
                    var match = isOrdered
                        ? OrderedListPattern.Match(lines[index])
                        : UnorderedListPattern.Match(lines[index]);
                    items.Add(FormatInline(match.Groups[1].Value));
                    index++;
                }

                var tag = isOrdered ? "ol" : "ul";
                var listItems = string.Concat(items.Select((item, itemIndex) =>
                    $"<li><span class=\"framework-markdown-list-marker\" aria-hidden=\"true\">{(isOrdered ? $"{itemIndex + 1}." : "•")}</span><span>{item}</span></li>"));
                yield return RenderMarkup($"<{tag} class=\"framework-markdown-list\">{listItems}</{tag}>");
                continue;
            }

            var paragraphLines = new List<string> { line.Trim() };
            index++;
            while (index < lines.Length &&
                   !string.IsNullOrWhiteSpace(lines[index]) &&
                   !IsBlockStart(lines, index))
            {
                paragraphLines.Add(lines[index].Trim());
                index++;
            }

            var paragraph = string.Join("<br>", paragraphLines.Select(FormatInline));
            yield return RenderMarkup($"<p class=\"framework-markdown-paragraph\">{paragraph}</p>");
        }
    }

    private static RenderFragment RenderMarkup(string markup) => builder => builder.AddMarkupContent(0, markup);

    private static bool IsBlockStart(string[] lines, int index)
    {
        var line = lines[index].TrimStart();
        return HeadingPattern.IsMatch(line) ||
               line.StartsWith("```", StringComparison.Ordinal) ||
               line.StartsWith(">", StringComparison.Ordinal) ||
               HorizontalRulePattern.IsMatch(line) ||
               TryGetListKind(line, out _) ||
               IsTableStart(lines, index);
    }

    private static bool TryGetListKind(string line, out bool isOrdered)
    {
        if (UnorderedListPattern.IsMatch(line))
        {
            isOrdered = false;
            return true;
        }

        if (OrderedListPattern.IsMatch(line))
        {
            isOrdered = true;
            return true;
        }

        isOrdered = false;
        return false;
    }

    private static bool IsTableStart(string[] lines, int index)
    {
        if (index + 1 >= lines.Length || !lines[index].Contains('|'))
        {
            return false;
        }

        var separators = SplitTableRow(lines[index + 1]);
        return separators.Length > 0 && separators.All(cell => TableSeparatorPattern.IsMatch(cell));
    }

    private static (RenderFragment Block, int NextIndex) RenderTable(string[] lines, int index)
    {
        var headers = SplitTableRow(lines[index]);
        var columnCount = headers.Length;
        index += 2;
        var rows = new List<string[]>();

        while (index < lines.Length && !string.IsNullOrWhiteSpace(lines[index]) && lines[index].Contains('|'))
        {
            var cells = SplitTableRow(lines[index]);
            rows.Add(Enumerable.Range(0, columnCount)
                .Select(column => column < cells.Length ? cells[column] : string.Empty)
                .ToArray());
            index++;
        }

        var headerHtml = string.Concat(headers.Select(header => $"<th scope=\"col\">{FormatInline(header)}</th>"));
        var rowHtml = string.Concat(rows.Select(row =>
            $"<tr>{string.Concat(row.Select(cell => $"<td>{FormatInline(cell)}</td>"))}</tr>"));

        var block = RenderMarkup(
            $"<div class=\"framework-markdown-table-wrap\"><table class=\"framework-markdown-table\"><thead><tr>{headerHtml}</tr></thead><tbody>{rowHtml}</tbody></table></div>");
        return (block, index);
    }

    private static string[] SplitTableRow(string line)
    {
        var row = line.Trim();
        if (row.StartsWith('|'))
        {
            row = row[1..];
        }

        if (row.EndsWith('|'))
        {
            row = row[..^1];
        }

        return row.Split('|').Select(cell => cell.Trim()).ToArray();
    }

    private static string FormatInline(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return string.Empty;
        }

        var fragments = new List<string>();
        string Protect(string markup)
        {
            var placeholder = $"\u0001{fragments.Count}\u0002";
            fragments.Add(markup);
            return placeholder;
        }

        var html = HtmlEncoder.Default.Encode(input);
        html = Regex.Replace(html, @"`([^`]+)`", match =>
            Protect($"<code class=\"framework-markdown-inline-code\">{match.Groups[1].Value}</code>"));
        html = Regex.Replace(html, @"\[([^\]]+)\]\(([^)\s]+)\)", match =>
        {
            var safeUrl = GetSafeLink(match.Groups[2].Value);
            if (safeUrl is null)
            {
                return match.Groups[1].Value;
            }

            var label = FormatInline(WebUtility.HtmlDecode(match.Groups[1].Value));
            var isExternal = Uri.TryCreate(WebUtility.HtmlDecode(match.Groups[2].Value), UriKind.Absolute, out var uri) &&
                (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
            var externalAttributes = isExternal ? " target=\"_blank\" rel=\"noopener noreferrer\"" : string.Empty;
            return Protect($"<a href=\"{safeUrl}\"{externalAttributes}>{label}</a>");
        });

        html = Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = Regex.Replace(html, @"(?<!\*)\*([^*\r\n]+)\*(?!\*)", "<em>$1</em>");
        html = Regex.Replace(html, @"(?<!\w)_([^_\r\n]+)_(?!\w)", "<em>$1</em>");
        html = Regex.Replace(html, @"~~(.+?)~~", "<del>$1</del>");

        for (var index = 0; index < fragments.Count; index++)
        {
            html = html.Replace($"\u0001{index}\u0002", fragments[index], StringComparison.Ordinal);
        }

        return html;
    }

    private static string? GetSafeLink(string encodedUrl)
    {
        var url = WebUtility.HtmlDecode(encodedUrl).Trim();
        if (url.Any(char.IsControl) || url.StartsWith("//", StringComparison.Ordinal) || url.StartsWith("\\\\", StringComparison.Ordinal))
        {
            return null;
        }

        if (Uri.TryCreate(url, UriKind.Absolute, out var absoluteUri))
        {
            if (absoluteUri.Scheme != Uri.UriSchemeHttp &&
                absoluteUri.Scheme != Uri.UriSchemeHttps &&
                absoluteUri.Scheme != Uri.UriSchemeMailto &&
                absoluteUri.Scheme != "tel")
            {
                return null;
            }
        }
        else if (!Uri.TryCreate(url, UriKind.Relative, out _) || url.Contains(':'))
        {
            return null;
        }

        return HtmlEncoder.Default.Encode(url);
    }
}
