@if (IsOpen)
{
    <div class="framework-modal-backdrop" @onclick="HandleBackdropClick">
        <div class="framework-modal-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="modal-heading">
            <div class="framework-modal-header">
                <h2 id="modal-heading">@Title</h2>
                <button type="button" class="framework-modal-close" @onclick="CloseAsync" aria-label="Schließen">&times;</button>
            </div>
            <div class="framework-modal-body">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task HandleBackdropClick()
    {
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}