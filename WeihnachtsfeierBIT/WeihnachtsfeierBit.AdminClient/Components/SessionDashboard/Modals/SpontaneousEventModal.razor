@namespace WeihnachtsfeierBit.AdminClient.Components.SessionDashboard.Modals
@using WeihnachtsfeierBit.Framework
@using WeihnachtsfeierBit.AdminClient.Components.SlideEditors

<FrameworkModal IsOpen="IsOpen" Title="Spontanes Event erstellen" OnClose="OnClose" DialogClass="session-config-modal">
    <div class="session-config-form">
        <FrameworkFormGroup Label="Event- bzw. Slide-Typ" ForId="modal-slide-type">
            <FrameworkSelect Id="modal-slide-type" Value="@_spontaneousType" ValueChanged="OnSpontaneousTypeChanged" Options="SlideTypeOptions" />
        </FrameworkFormGroup>

        <details class="event-settings-disclosure">
            <summary>
                <span>Event-Einstellungen</span>
                <small>Modus, Titel und Zeitplan</small>
            </summary>
            <div class="event-settings-content">
                <div class="session-config-grid">
                    <FrameworkFormGroup Label="Modus" ForId="modal-mode">
                        <FrameworkSelect Id="modal-mode" Value="@_spontaneousMode" ValueChanged='v => _spontaneousMode = v ?? "active"' Options="ModeOptions" />
                    </FrameworkFormGroup>

                    <FrameworkFormGroup Label="Folien-Steuerung" ForId="spontaneous-navigation-mode">
                        <FrameworkSelect Id="spontaneous-navigation-mode" Value="@_spontaneousNavMode" ValueChanged='v => _spontaneousNavMode = v ?? "host_controlled"' Options="NavModeOptions" />
                    </FrameworkFormGroup>

                    <FrameworkFormGroup Label="Event-Titel überschreiben (optional)">
                        <FrameworkInputText @bind-Value="_spontaneousTitleInput" Placeholder="Titel überschreiben..." />
                    </FrameworkFormGroup>

                    <FrameworkFormGroup Label="Untertitel (optional)">
                        <FrameworkInputText @bind-Value="_spontaneousSubtitleInput" Placeholder="z. B. Bitte Plätze einnehmen" />
                    </FrameworkFormGroup>
                </div>

                <FrameworkCheckbox @bind-Value="_spontaneousIsHidden" Label="Event vor Teilnehmern ausblenden" />
                <FrameworkCheckbox @bind-Value="_spontaneousIsScheduled" Label="Event zeitlich planen" />
                @if (_spontaneousIsScheduled)
                {
                    <div class="event-schedule-options">
                        <FrameworkFormGroup Label="Geplante Startzeit" ForId="spontaneous-scheduled-time">
                            <FrameworkInputText Id="spontaneous-scheduled-time" @bind-Value="_spontaneousScheduledTimeInput" Placeholder="20:00" />
                        </FrameworkFormGroup>
                        <FrameworkCheckbox @bind-Value="_spontaneousAutoStart" Label="Automatisch zur geplanten Uhrzeit starten" />
                    </div>
                }
            </div>
        </details>

        <details class="event-settings-disclosure spontaneous-slide-disclosure" open>
            <summary>
                <span>Slide-Inhalt</span>
                <small>Inhalt für den gewählten Typ konfigurieren</small>
            </summary>
            <div class="event-settings-content">
                <FrameworkFormGroup Label="Interner Name / Titel" ForId="spontaneous-title">
                    <FrameworkInputText Id="spontaneous-title" @bind-Value="_spontaneousSlide.InternalName" Placeholder="Titel eingeben..." />
                </FrameworkFormGroup>

                @switch (_spontaneousType)
                {
                    case "announcement":
                        <AnnouncementSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "poll":
                        <PollSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "quiz":
                        <QuizSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "ranking":
                        <RankingSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "estimation":
                        <EstimationSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "buzzer":
                        <BuzzerSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "hitster":
                        <HitsterSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "text":
                        <TextSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "word_cloud":
                        <WordCloudSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "slider":
                        <SliderSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "rating":
                        <RatingSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "ordering":
                        <OrderingSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "countdown":
                        <CountdownSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "point_award":
                        <PointAwardSlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "jeopardy":
                        <JeopardySlideEditor Slide="_spontaneousSlide" />
                        break;
                    case "pantomime":
                        <PantomimeSlideEditor Slide="_spontaneousSlide" />
                        break;
                }
            </div>
        </details>

        @if (!string.IsNullOrEmpty(_modalError))
        {
            <FrameworkNotice Message="@_modalError" Severity="error" />
        }

        <div class="session-config-actions">
            <FrameworkButton Label="Abbrechen" Variant="secondary" OnClick="OnClose" />
            <FrameworkButton Label="Event erstellen & starten" Variant="primary" OnClick="CreateSpontaneousEventWithEditorAsync" Busy="_isProcessing" Disabled="_isProcessing" />
        </div>
    </div>
</FrameworkModal>
