@inherits AuthenticatedComponentBase
@inject NavigationManager Navigation

<FrameworkPage>
    <div class="overview-toolbar">
        <PageHeading Eyebrow="PROJEKT" Title="Play-Session" Description="Verwalte die aktive Anmelde-Session und ihren 6-stelligen Code." />
        @if (_activeInstance is null)
        {
            <FrameworkButton Label="Session jetzt starten" Variant="primary" OnClick="StartNewSessionAsync" Busy="@_starting" Disabled="@_starting" />
        }
        else
        {
            <FrameworkButton Label="Session beenden" Variant="danger" OnClick="EndSessionAsync" Busy="@_ending" Disabled="@_ending" />
        }
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" />
    }

    @if (!string.IsNullOrEmpty(_actionNotice))
    {
        <FrameworkNotice Message="@_actionNotice" />
    }

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <FrameworkNotice Message="@_actionError" />
    }

    @if (IsLoading)
    {
        <FrameworkLoading Message="Session wird geladen ..." />
    }
    else
    {
        @if (_activeInstance is not null)
        {
            <Card Class="project-card" Style="margin-bottom: 24px; border: 2px solid #0284c7; background: #f0f9ff;">
                <ChildContent>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="font-size: 11px; font-weight: 800; color: #0284c7; text-transform: uppercase;">AKTIVE PLAY-SESSION</span>
                            <h2 style="font-size: 32px; font-weight: 800; margin: 4px 0; color: #0369a1; letter-spacing: 2px;">
                                Code: @_activeInstance.AccessCode
                            </h2>
                            <p style="margin: 0; color: #556265; font-size: 13px;">Gestartet am @_activeInstance.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") Uhr</p>
                        </div>
                        <div class="framework-button-row">
                            <FrameworkButton Label="Session-Dashboard öffnen" Variant="primary" OnClick="OpenDashboard" />
                            <FrameworkButton Label="Session beenden" Variant="danger" OnClick="EndSessionAsync" Busy="@_ending" Disabled="@_ending" />
                        </div>
                    </div>
                </ChildContent>
            </Card>
        }
        else
        {
            <EmptyState Title="Aktuell keine aktive Session" Description="Starte eine Play-Session, um einen 6-stelligen Code zu generieren, mit dem sich die Teilnehmer auf ihren Geräten anmelden können.">
                <ChildContent>
                    <FrameworkButton Label="Play-Session starten" OnClick="StartNewSessionAsync" Busy="@_starting" Disabled="@_starting" />
                </ChildContent>
            </EmptyState>
        }
    }
</FrameworkPage>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private GameInstanceSummary? _activeInstance;

    private string? _actionNotice;
    private string? _actionError;
    private bool _starting;
    private bool _ending;

    protected override async Task OnParametersSetAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        await LoadAuthenticatedAsync(async token =>
        {
            _actionError = null;
            _activeInstance = await ProjectApiClient.GetActiveGameInstanceAsync(token, ProjectId);
        });
    }

    private void OpenDashboard() => Navigation.NavigateTo($"{Navigation.BaseUri}projects/{ProjectId}/session");

    private async Task StartNewSessionAsync()
    {
        if (_starting) return;
        _starting = true;
        _actionNotice = null;
        _actionError = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                var newInst = await ProjectApiClient.StartGameInstanceAsync(token, ProjectId);
                _actionNotice = $"Neue Play-Session mit Code {newInst.AccessCode} gestartet.";
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task EndSessionAsync()
    {
        if (_ending) return;
        _ending = true;
        _actionNotice = null;
        _actionError = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.EndGameInstanceAsync(token, ProjectId);
                _actionNotice = "Die Session wurde beendet.";
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _ending = false;
        }
    }
}
