@page "/projects/{ProjectId:guid}/regie"
@namespace WeihnachtsfeierBit.AdminClient.Components.Pages
@using WeihnachtsfeierBit.AdminClient.Components.SessionDashboard
@using WeihnachtsfeierBit.AdminClient.Components.SessionDashboard.Modals
@using WeihnachtsfeierBit.AdminClient.Components.SessionDashboard.Services
@using WeihnachtsfeierBit.Framework
@inherits AuthenticatedComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ILogger<ProjectRegiePage> Logger

<FrameworkPage>
    @if (IsLoading || _state?.IsLoading == true)
    {
        <FrameworkLoading Message="Regie wird geladen ..." />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" Severity="error" />
    }
    else if (_state is not null)
    {
        <div class="overview-toolbar">
            <PageHeading Eyebrow="LIVE-REGIE" Title="Regie & Moderation" Description="Steuere Teilnehmer, Punkte, Chat und Beamer über dieselben Regie-Tabs wie im Session-Dashboard." />
        </div>

        @if (!string.IsNullOrEmpty(_state.ActionError))
        {
            <FrameworkNotice Message="@_state.ActionError" Severity="error" />
        }

        <ModerationSidebar CompactMode="true"
                           Participants="_state.Participants"
                           Teams="_state.Teams"
                           Instance="_state.Instance"
                           SessionState="_state.SessionState"
                           ActiveCanvasEventId="_state.ActiveCanvasEventId"
                           PointLogs="_state.PointLogs"
                           ProjectId="@ProjectId"
                           AccessToken="@_accessToken"
                           HubConnection="_state.HubConnection"
                           CanvasUrl="@GetCanvasUrl()"
                           CanvasSettings="_state.CanvasSettings"
                           IsProcessing="_state.IsProcessing"
                           ActionError="@_state.ActionError"
                           RunAuthenticated="RunAuthenticatedAsync"
                           OnOpenPermissions="OpenPermissionsModal"
                           OnOpenAwardPoints="OpenAwardPointsForTeam"
                           OnSetCanvasEvent="SetCanvasEventAsync"
                           OnSaveCanvasSettings="SaveCanvasSettingsAsync"
                           OnEventCreated="ReloadDataAsync" />

        <AwardPointsModal IsOpen="_isAwardPointsModalOpen"
                          ProjectId="@ProjectId"
                          Teams="_state.Teams"
                          DefaultTeamId="_awardDefaultTeamId"
                          OnClose="CloseAwardPointsModal"
                          OnPointsAwarded="ReloadDataAsync"
                          RunAuthenticated="RunAuthenticatedAsync" />

        <ParticipantPermissionsModal IsOpen="_isPermissionsModalOpen"
                                     ProjectId="ProjectId"
                                     Participant="_permissionsParticipant"
                                     OnClose="ClosePermissionsModal"
                                     OnPermissionsSaved="ReloadDataAsync"
                                     RunAuthenticated="RunAuthenticatedAsync" />
    }
</FrameworkPage>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private SessionDashboardState? _state;
    private string? _accessToken;
    private bool _isAwardPointsModalOpen;
    private Guid _awardDefaultTeamId;
    private bool _isPermissionsModalOpen;
    private ParticipantSummary? _permissionsParticipant;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAuthenticatedAsync(async token =>
        {
            _accessToken = token;
            if (_state is not null && _state.ProjectId != ProjectId)
            {
                _state.OnStateChanged -= HandleStateChanged;
                await _state.DisposeAsync();
                _state = null;
            }

            if (_state is null)
            {
                _state = new SessionDashboardState(
                    ProjectId,
                    ProjectApiClient,
                    Configuration,
                    Logger,
                    async action => await RunAuthenticatedAsync(action));
                _state.OnStateChanged += HandleStateChanged;
                await _state.InitializeAsync();
            }
        });
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    private string? GetCanvasUrl() => _state?.Instance is { } instance
        ? Navigation.ToAbsoluteUri($"/play/beamer/{instance.AccessCode}").ToString()
        : null;

    private Task ReloadDataAsync() => _state?.LoadDataAsync() ?? Task.CompletedTask;

    private Task SaveCanvasSettingsAsync(CanvasDisplaySettings settings) =>
        _state?.SetCanvasDisplaySettingsAsync(settings) ?? Task.CompletedTask;

    private Task SetCanvasEventAsync(Guid? eventId) =>
        _state?.SetCanvasEventAsync(eventId) ?? Task.CompletedTask;

    private void OpenAwardPointsForTeam(Guid teamId)
    {
        _awardDefaultTeamId = teamId;
        _isAwardPointsModalOpen = true;
    }

    private void CloseAwardPointsModal() => _isAwardPointsModalOpen = false;

    private void OpenPermissionsModal(ParticipantSummary participant)
    {
        _permissionsParticipant = participant;
        _isPermissionsModalOpen = true;
    }

    private void ClosePermissionsModal() => _isPermissionsModalOpen = false;

    public async ValueTask DisposeAsync()
    {
        if (_state is not null)
        {
            _state.OnStateChanged -= HandleStateChanged;
            await _state.DisposeAsync();
        }
    }
}
