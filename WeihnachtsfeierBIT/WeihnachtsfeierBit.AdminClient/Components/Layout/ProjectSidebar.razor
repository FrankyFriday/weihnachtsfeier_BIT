@inherits AuthenticatedComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <aside class="project-sidebar @(_isCollapsed ? "collapsed" : null)">
            <nav aria-label="Workspace-Navigation">
                <!-- COLLAPSE/EXPAND TOGGLE BUTTON (DESKTOP) -->
                <button type="button" class="sidebar-toggle-btn" @onclick="ToggleCollapse" title="@(_isCollapsed ? "Sidebar erweitern" : "Sidebar einklappen")">
                    <span class="material-symbols-outlined" style="font-size: 20px;">@(_isCollapsed ? "chevron_right" : "chevron_left")</span>
                </button>

                <div class="sidebar-section">
                    <span class="sidebar-label">WORKSPACE</span>
                    <a class="sidebar-link @(IsProjectOverview ? "active" : null)" href="@Navigation.BaseUri" @onclick="HandleLinkClick" title="Projekte">
                        <span class="material-symbols-outlined" style="font-size: 18px;">folder</span>
                        <span class="sidebar-link-text">Projekte</span>
                    </a>
                    <a class="sidebar-link @(IsShowCatalog ? "active" : null)" href="@WorkspaceShowsUrl" @onclick="HandleLinkClick" title="Shows">
                        <span class="material-symbols-outlined" style="font-size: 18px;">collections_bookmark</span>
                        <span class="sidebar-link-text">Shows</span>
                    </a>
                </div>

                @if (CurrentShow is not null)
                {
                    <div class="sidebar-section sidebar-current-project">
                        <span class="sidebar-label">AKTUELLE SHOW</span>
                        <strong class="sidebar-current-title">@CurrentShow.Name</strong>
                        <a class="sidebar-link @(CurrentShowSection == "editor" ? "active" : null)" href="@ShowUrl(CurrentShow.Id)" @onclick="HandleLinkClick" title="Slides & Editor">
                            <span class="material-symbols-outlined" style="font-size: 18px;">edit_note</span>
                            <span class="sidebar-link-text">Slides & Editor</span>
                        </a>
                        <a class="sidebar-link @(CurrentShowSection == "settings" ? "active" : null)" href="@ShowUrl(CurrentShow.Id, "settings")" @onclick="HandleLinkClick" title="Einstellungen">
                            <span class="material-symbols-outlined" style="font-size: 18px;">settings</span>
                            <span class="sidebar-link-text">Einstellungen</span>
                        </a>
                    </div>
                }
                else if (CurrentProject is not null)
                {
                    <div class="sidebar-section sidebar-current-project">
                        <span class="sidebar-label">AKTUELLES PROJEKT</span>
                        <strong class="sidebar-current-title">@CurrentProject.Name</strong>

                        @if (_activeInstance is not null)
                        {
                            <a class="sidebar-link active-session-badge @(CurrentSection == "session" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "session")" @onclick="HandleLinkClick" title="@($"Live-Session ({_activeInstance.AccessCode})")">
                                <span class="live-dot"></span>
                                <span class="sidebar-link-text">Live-Session (@_activeInstance.AccessCode)</span>
                            </a>
                        }
                        else
                        {
                            <a class="sidebar-link @(CurrentSection == "session" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "session")" @onclick="HandleLinkClick" title="Live-Session">
                                <span class="material-symbols-outlined" style="font-size: 18px;">play_circle</span>
                                <span class="sidebar-link-text">Live-Session</span>
                            </a>
                        }

                        <a class="sidebar-link @(CurrentSection == "overview" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id)" @onclick="HandleLinkClick" title="Übersicht">
                            <span class="material-symbols-outlined" style="font-size: 18px;">dashboard</span>
                            <span class="sidebar-link-text">Übersicht</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "participants" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "participants")" @onclick="HandleLinkClick" title="Teilnehmer">
                            <span class="material-symbols-outlined" style="font-size: 18px;">person</span>
                            <span class="sidebar-link-text">Teilnehmer</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "teams" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "teams")" @onclick="HandleLinkClick" title="Teams">
                            <span class="material-symbols-outlined" style="font-size: 18px;">groups</span>
                            <span class="sidebar-link-text">Teams</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "point-logs" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "point-logs")" @onclick="HandleLinkClick" title="Punkte-Log">
                            <span class="material-symbols-outlined" style="font-size: 18px;">military_tech</span>
                            <span class="sidebar-link-text">Punkte-Log</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "chat" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "chat")" @onclick="HandleLinkClick" title="Live-Chat">
                            <span class="material-symbols-outlined" style="font-size: 18px;">chat</span>
                            <span class="sidebar-link-text">Live-Chat</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "info-pages" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "info-pages")" @onclick="HandleLinkClick" title="Info-Seiten">
                            <span class="material-symbols-outlined" style="font-size: 18px;">info</span>
                            <span class="sidebar-link-text">Info-Seiten</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "jukebox" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "jukebox")" @onclick="HandleLinkClick" title="Jukebox">
                            <span class="material-symbols-outlined" style="font-size: 18px;">music_note</span>
                            <span class="sidebar-link-text">Jukebox</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "shows" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "shows")" @onclick="HandleLinkClick" title="Shows">
                            <span class="material-symbols-outlined" style="font-size: 18px;">collections_bookmark</span>
                            <span class="sidebar-link-text">Shows</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "access-sessions" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "access-sessions")" @onclick="HandleLinkClick" title="Aktive Geräte">
                            <span class="material-symbols-outlined" style="font-size: 18px;">devices</span>
                            <span class="sidebar-link-text">Aktive Geräte</span>
                        </a>
                        <a class="sidebar-link @(CurrentSection == "settings" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "settings")" @onclick="HandleLinkClick" title="Einstellungen">
                            <span class="material-symbols-outlined" style="font-size: 18px;">settings</span>
                            <span class="sidebar-link-text">Einstellungen</span>
                        </a>
                    </div>
                }

                @if (CurrentProjectId is null && CurrentShowId is null && _projects.Length > 0)
                {
                    <div class="sidebar-section">
                        <span class="sidebar-label">PROJEKTE</span>
                        @foreach (var project in _projects)
                        {
                            <a class="sidebar-link" href="@ProjectUrl(project.Id)" @key="project.Id" @onclick="HandleLinkClick" title="@project.Name">
                                <span class="sidebar-project-dot"></span>
                                <span class="sidebar-project-name sidebar-link-text">@project.Name</span>
                            </a>
                        }
                    </div>
                }
            </nav>
        </aside>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public EventCallback OnCloseMobile { get; set; }

    private ProjectSummary[] _projects = [];
    private AdminShow[] _shows = [];
    private GameInstanceSummary? _activeInstance;
    private bool _isCollapsed;

    private Guid? CurrentProjectId => GetProjectId(Navigation.Uri);
    private Guid? CurrentShowId => GetShowId(Navigation.Uri);
    private ProjectSummary? CurrentProject => _projects.FirstOrDefault(project => project.Id == CurrentProjectId);
    private AdminShow? CurrentShow => _shows.FirstOrDefault(show => show.Id == CurrentShowId);
    private string CurrentSection => GetProjectSection(Navigation.Uri);
    private string CurrentShowSection => GetShowSection(Navigation.Uri);
    private bool IsShowCatalog => Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') == "shows";
    private bool IsProjectOverview => CurrentProjectId is null && CurrentShowId is null && !IsShowCatalog;
    private string WorkspaceShowsUrl => $"{Navigation.BaseUri}shows";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        await LoadAuthenticatedAsync(async token =>
        {
            var projectsTask = ProjectApiClient.GetAdminProjectsAsync(token);
            var showsTask = ProjectApiClient.GetAdminShowsAsync(token);
            await Task.WhenAll(projectsTask, showsTask);
            _projects = await projectsTask;
            _shows = await showsTask;

            if (CurrentProjectId is Guid projectId)
            {
                _activeInstance = await ProjectApiClient.GetActiveGameInstanceAsync(token, projectId);
            }
            else
            {
                _activeInstance = null;
            }
        });
    }

    private void ToggleCollapse() => _isCollapsed = !_isCollapsed;

    private async Task HandleLinkClick()
    {
        if (OnCloseMobile.HasDelegate)
        {
            await OnCloseMobile.InvokeAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        await LoadDataAsync();
        StateHasChanged();
    });

    private string ProjectUrl(Guid projectId, string? section = null) =>
        $"{Navigation.BaseUri}projects/{projectId}{(string.IsNullOrEmpty(section) ? string.Empty : $"/{section}")}";

    private string ShowUrl(Guid showId, string? section = null) =>
        $"{Navigation.BaseUri}shows/{showId}{(string.IsNullOrEmpty(section) ? string.Empty : $"/{section}")}";

    private Guid? GetProjectId(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 2 && segments[0] == "projects" && Guid.TryParse(segments[1], out var id) ? id : null;
    }

    private Guid? GetShowId(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 2 && segments[0] == "shows" && Guid.TryParse(segments[1], out var id) ? id : null;
    }

    private string GetProjectSection(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 3 && segments[0] == "projects" ? segments[2] : "overview";
    }

    private string GetShowSection(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 3 && segments[0] == "shows" ? segments[2] : "editor";
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
