@inherits AuthenticatedComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <aside class="project-sidebar">
            <nav aria-label="Workspace-Navigation">
                <div class="sidebar-section">
                    <span class="sidebar-label">WORKSPACE</span>
                    <a class="sidebar-link @(IsProjectOverview ? "active" : null)" href="@Navigation.BaseUri">Projekte</a>
                    <a class="sidebar-link @(IsShowCatalog ? "active" : null)" href="@WorkspaceShowsUrl">Shows</a>
                </div>

                @if (CurrentShow is not null)
                {
                    <div class="sidebar-section sidebar-current-project">
                        <span class="sidebar-label">AKTUELLE SHOW</span>
                        <strong>@CurrentShow.Name</strong>
                        <a class="sidebar-link @(CurrentShowSection == "editor" ? "active" : null)" href="@ShowUrl(CurrentShow.Id)">Slides & Editor</a>
                        <a class="sidebar-link @(CurrentShowSection == "settings" ? "active" : null)" href="@ShowUrl(CurrentShow.Id, "settings")">Einstellungen</a>
                    </div>
                }
                else if (CurrentProject is not null)
                {
                    <div class="sidebar-section sidebar-current-project">
                        <span class="sidebar-label">AKTUELLES PROJEKT</span>
                        <strong>@CurrentProject.Name</strong>

                        @if (_activeInstance is not null)
                        {
                            <a class="sidebar-link active-session-badge @(CurrentSection == "session" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "session")">
                                <span class="live-dot"></span>
                                <span>Play-Session (@_activeInstance.AccessCode)</span>
                            </a>
                        }
                        else
                        {
                            <a class="sidebar-link @(CurrentSection == "session" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "session")">
                                <span>Play-Session</span>
                            </a>
                        }

                        <a class="sidebar-link @(CurrentSection == "overview" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id)">Übersicht</a>
                        <a class="sidebar-link @(CurrentSection == "participants" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "participants")">Teilnehmer</a>
                        <a class="sidebar-link @(CurrentSection == "teams" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "teams")">Teams</a>
                        <a class="sidebar-link @(CurrentSection == "chat" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "chat")">Live-Chat & Support</a>
                        <a class="sidebar-link @(CurrentSection == "shows" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "shows")">Verknüpfte Shows</a>
                        <a class="sidebar-link @(CurrentSection == "sessions" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "sessions")">Session-Historie</a>
                        <a class="sidebar-link @(CurrentSection == "settings" ? "active" : null)" href="@ProjectUrl(CurrentProject.Id, "settings")">Einstellungen</a>
                    </div>
                }

                @if (CurrentProjectId is null && CurrentShowId is null && _projects.Length > 0)
                {
                    <div class="sidebar-section">
                        <span class="sidebar-label">PROJEKTE</span>
                        @foreach (var project in _projects)
                        {
                            <a class="sidebar-link" href="@ProjectUrl(project.Id)" @key="project.Id">
                                <span class="sidebar-project-dot"></span>
                                <span class="sidebar-project-name">@project.Name</span>
                            </a>
                        }
                    </div>
                }
            </nav>
        </aside>
    </Authorized>
</AuthorizeView>

@code {
    private ProjectSummary[] _projects = [];
    private AdminShow[] _shows = [];
    private GameInstanceSummary? _activeInstance;

    private Guid? CurrentProjectId => GetProjectId(Navigation.Uri);
    private Guid? CurrentShowId => GetShowId(Navigation.Uri);
    private ProjectSummary? CurrentProject => _projects.FirstOrDefault(project => project.Id == CurrentProjectId);
    private AdminShow? CurrentShow => _shows.FirstOrDefault(show => show.Id == CurrentShowId);
    private string CurrentSection => GetProjectSection(Navigation.Uri);
    private string CurrentShowSection => GetShowSection(Navigation.Uri);
    private bool IsShowCatalog => Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') == "shows";
    private bool IsProjectOverview => CurrentProjectId is null && CurrentShowId is null && !IsShowCatalog;
    private string WorkspaceShowsUrl => $"{Navigation.BaseUri}shows";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        await LoadAuthenticatedAsync(async token =>
        {
            var projectsTask = ProjectApiClient.GetAdminProjectsAsync(token);
            var showsTask = ProjectApiClient.GetAdminShowsAsync(token);
            await Task.WhenAll(projectsTask, showsTask);
            _projects = await projectsTask;
            _shows = await showsTask;

            if (CurrentProjectId is Guid projectId)
            {
                _activeInstance = await ProjectApiClient.GetActiveGameInstanceAsync(token, projectId);
            }
            else
            {
                _activeInstance = null;
            }
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        await LoadDataAsync();
        StateHasChanged();
    });

    private string ProjectUrl(Guid projectId, string? section = null) =>
        $"{Navigation.BaseUri}projects/{projectId}{(string.IsNullOrEmpty(section) ? string.Empty : $"/{section}")}";

    private string ShowUrl(Guid showId, string? section = null) =>
        $"{Navigation.BaseUri}shows/{showId}{(string.IsNullOrEmpty(section) ? string.Empty : $"/{section}")}";

    private Guid? GetProjectId(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 2 && segments[0] == "projects" && Guid.TryParse(segments[1], out var id) ? id : null;
    }

    private Guid? GetShowId(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 2 && segments[0] == "shows" && Guid.TryParse(segments[1], out var id) ? id : null;
    }

    private string GetProjectSection(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 3 && segments[0] == "projects" ? segments[2] : "overview";
    }

    private string GetShowSection(string uri)
    {
        var segments = Navigation.ToBaseRelativePath(uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 3 && segments[0] == "shows" ? segments[2] : "editor";
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
