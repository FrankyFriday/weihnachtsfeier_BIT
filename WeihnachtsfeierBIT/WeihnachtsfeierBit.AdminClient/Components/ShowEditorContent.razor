@using System.Text.Json
@inherits AuthenticatedComponentBase

<FrameworkPage>
    @if (IsLoading)
    {
        <FrameworkLoading Message="Show wird geladen ..." />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" />
    }
    else if (_show is not null)
    {
        <div class="overview-toolbar">
            <PageHeading Eyebrow="SHOW-EDITOR" Title="@_show.Name" Description="Slides verwalten, konfigurieren und in der Reihenfolge der Show sortieren." />
        </div>

        <div class="slide-editor-layout">
            <!-- LEFT COLUMN: Slide List -->
            <div class="slide-list-column">
                <div class="slide-list-header">
                    <h3>Slides (@_slides.Length)</h3>
                </div>

                @if (_slides.Length == 0)
                {
                    <div class="slide-list-empty">
                        <p>Noch keine Slides vorhanden.</p>
                    </div>
                }
                else
                {
                    <div class="slide-list-items">
                        @foreach (var slide in _slides.OrderBy(s => s.Position))
                        {
                            var isSelected = _selectedSlide?.Id == slide.Id;
                            <div class="slide-list-item @(isSelected ? "selected" : string.Empty) @(slide.IsDisabled ? "disabled-slide" : string.Empty)" @onclick="() => SelectSlide(slide)" @key="slide.Id">
                                <div class="slide-list-item-content">
                                    <div class="slide-list-item-header">
                                        <span class="slide-position">#@(slide.Position + 1)</span>
                                        <FrameworkBadge Text="@SlideTypeLabel(slide.Type)" Variant="@slide.Type" />
                                        @if (slide.IsDisabled)
                                        {
                                            <FrameworkBadge Text="Entwurf" Variant="disabled" />
                                        }
                                    </div>
                                    <div class="slide-list-item-title">
                                        @slide.DisplayName
                                    </div>
                                </div>
                                <div class="slide-list-item-actions" @onclick:stopPropagation="true">
                                    <button type="button" class="btn-arrow" title="Nach oben" @onclick="() => MoveSlideAsync(slide, -1)" disabled="@(_busySlideId is not null || slide.Position == 0)">▲</button>
                                    <button type="button" class="btn-arrow" title="Nach unten" @onclick="() => MoveSlideAsync(slide, 1)" disabled="@(_busySlideId is not null || slide.Position == _slides.Length - 1)">▼</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="slide-list-footer">
                    <FrameworkButton Label="+ Slide hinzufügen" Variant="primary" OnClick="OpenAddModal" Disabled="@_adding" />
                </div>
            </div>

            <!-- RIGHT COLUMN: Slide Configurator -->
            <div class="slide-detail-column">
                @if (_selectedSlide is not null)
                {
                    <Card Class="slide-detail-card" @key="_selectedSlide.Id">
                        <HeaderContent>
                            <div class="slide-detail-header">
                                <div>
                                    <span class="eyebrow">SLIDE #@(_selectedSlide.Position + 1)</span>
                                    <h2>@_selectedSlide.DisplayName</h2>
                                </div>
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <FrameworkBadge Text="@SlideTypeLabel(_selectedSlide.Type)" Variant="@_selectedSlide.Type" />
                                    @if (_selectedSlide.IsDisabled)
                                    {
                                        <FrameworkBadge Text="Entwurf" Variant="disabled" />
                                    }
                                </div>
                            </div>
                        </HeaderContent>
                        <ChildContent>
                            <div class="slide-form">
                                <!-- Common Fields: Internal Name, Disabled Switch & Admin Notes -->
                                <FrameworkFormGroup Label="Interner Name" HelpText="nur im Admin-Panel sichtbar" ForId="slide-internal-name">
                                    <FrameworkInputText Id="slide-internal-name" @bind-Value="_selectedSlide.InternalName" Placeholder="z. B. Begrüßung Runde 1" />
                                </FrameworkFormGroup>

                                <FrameworkCheckbox @bind-Value="_selectedSlide.IsDisabled" Label="Slide deaktivieren / Entwurf" HelpText="wird in der Live-Show übersprungen" />

                                <FrameworkFormGroup Label="Moderator- / Regie-Notizen" HelpText="nur für Admins sichtbar" ForId="slide-admin-notes">
                                    <FrameworkTextArea Id="slide-admin-notes" @bind-Value="_selectedSlide.AdminNotes" Rows="2" Placeholder="Regieanweisung oder Notizen für den Moderator..." />
                                </FrameworkFormGroup>

                                <FrameworkDivider />

                                @if (_selectedSlide.Type == "announcement")
                                {
                                    <FrameworkFormGroup Label="Titel" ForId="announcement-title">
                                        <FrameworkInputText Id="announcement-title" @bind-Value="_selectedSlide.AnnouncementTitle" MaxLength="120" Placeholder="Ankündigungstitel" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Nachricht" ForId="announcement-message">
                                        <FrameworkTextArea Id="announcement-message" @bind-Value="_selectedSlide.AnnouncementMessage" Rows="5" Placeholder="Nachrichtentext" />
                                    </FrameworkFormGroup>
                                }
                                else if (_selectedSlide.Type == "poll")
                                {
                                    <FrameworkFormGroup Label="Frage" ForId="poll-question">
                                        <FrameworkInputText Id="poll-question" @bind-Value="_selectedSlide.PollQuestion" Placeholder="Welche Option wählt ihr?" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Optionen">
                                        @for (int i = 0; i < _selectedSlide.PollOptions.Count; i++)
                                        {
                                            var index = i;
                                            <div class="dynamic-list-row">
                                                <FrameworkInputText Value="@_selectedSlide.PollOptions[index]" ValueChanged="val => _selectedSlide.PollOptions[index] = val ?? string.Empty" Placeholder="@($"Option {index + 1}")" />
                                                <FrameworkButton Label="Löschen" Variant="danger" OnClick="() => RemovePollOption(_selectedSlide, index)" Disabled="@(_selectedSlide.PollOptions.Count <= 2)" />
                                            </div>
                                        }
                                        <div style="margin-top: 8px;">
                                            <FrameworkButton Label="+ Option hinzufügen" Variant="secondary" OnClick="() => _selectedSlide.PollOptions.Add(string.Empty)" />
                                        </div>
                                    </FrameworkFormGroup>
                                    <FrameworkCheckbox @bind-Value="_selectedSlide.PollAllowMultiple" Label="Mehrfachauswahl erlauben" />
                                    <FrameworkCheckbox @bind-Value="_selectedSlide.PollHideResultsUntilRevealed" Label="Ergebnisse verdeckt halten bis zur Enthüllung" />
                                    <FrameworkCheckbox @bind-Value="_selectedSlide.PollShowPercentage" Label="Ergebnisse in Prozent anzeigen" />
                                }
                                else if (_selectedSlide.Type == "quiz")
                                {
                                    <FrameworkFormGroup Label="Frage" ForId="quiz-question">
                                        <FrameworkInputText Id="quiz-question" @bind-Value="_selectedSlide.QuizQuestion" Placeholder="Welche Antwort ist richtig?" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Antwortmöglichkeiten">
                                        @for (int i = 0; i < _selectedSlide.QuizAnswers.Count; i++)
                                        {
                                            var index = i;
                                            var isCorrect = _selectedSlide.QuizCorrectAnswerIndices.Contains(index);
                                            <div class="dynamic-list-row">
                                                <FrameworkInputText Value="@_selectedSlide.QuizAnswers[index]" ValueChanged="val => _selectedSlide.QuizAnswers[index] = val ?? string.Empty" Placeholder="@($"Antwort {index + 1}")" />
                                                <label class="correct-checkbox-label">
                                                    <input type="checkbox" checked="@isCorrect" @onchange="e => ToggleQuizCorrectAnswer(_selectedSlide, index, (bool)(e.Value ?? false))" />
                                                    <span>Richtig</span>
                                                </label>
                                                <FrameworkButton Label="Löschen" Variant="danger" OnClick="() => RemoveQuizAnswer(_selectedSlide, index)" Disabled="@(_selectedSlide.QuizAnswers.Count <= 2)" />
                                            </div>
                                        }
                                        <div style="margin-top: 8px;">
                                            <FrameworkButton Label="+ Antwort hinzufügen" Variant="secondary" OnClick="() => _selectedSlide.QuizAnswers.Add(string.Empty)" />
                                        </div>
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Punkte bei richtiger Antwort" ForId="quiz-points">
                                        <FrameworkInputNumber Id="quiz-points" @bind-Value="_selectedSlide.QuizPoints" Min="0" Placeholder="100" />
                                    </FrameworkFormGroup>
                                    <FrameworkCheckbox @bind-Value="_selectedSlide.QuizEnableSpeedBonus" Label="Geschwindigkeits-Bonus aktivieren" />
                                    <FrameworkFormGroup Label="Zeitlimit in Sekunden" HelpText="optional" ForId="quiz-time-limit">
                                        <FrameworkInputNumber Id="quiz-time-limit" @bind-Value="_selectedSlide.QuizTimeLimitSeconds" Min="5" Max="300" Placeholder="z. B. 30" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Lösungserklärung / Erläuterung" HelpText="optional, wird nach Auflösung angezeigt" ForId="quiz-explanation">
                                        <FrameworkTextArea Id="quiz-explanation" @bind-Value="_selectedSlide.QuizExplanation" Rows="3" Placeholder="Zusätzliche Infos zur Lösung..." />
                                    </FrameworkFormGroup>
                                }
                                else if (_selectedSlide.Type == "ranking")
                                {
                                    <FrameworkNotice Message="Der Zwischenstand zeigt während des Live-Events automatisch den aktuellen Punktestand aller Teams aus dem jeweiligen Projekt an." Severity="info" />
                                    <div style="margin-top: 16px;">
                                        <FrameworkFormGroup Label="Titel der Rangliste" ForId="ranking-title">
                                            <FrameworkInputText Id="ranking-title" @bind-Value="_selectedSlide.RankingTitle" Placeholder="z. B. Zwischenstand nach Runde 1" />
                                        </FrameworkFormGroup>
                                        <FrameworkFormGroup Label="Top-X Begrenzung" HelpText="optional, z. B. 3 für Top 3; leer lassen für alle Teams" ForId="ranking-top-count">
                                            <FrameworkInputNumber Id="ranking-top-count" @bind-Value="_selectedSlide.RankingTopCount" Min="1" Max="50" Placeholder="z. B. 3 oder 5" />
                                        </FrameworkFormGroup>
                                        <FrameworkCheckbox @bind-Value="_selectedSlide.RankingAnimatePodium" Label="Podium-Animation aktivieren (aufsteigende Enthüllung)" />
                                    </div>
                                }
                                else if (_selectedSlide.Type == "estimation")
                                {
                                    <FrameworkFormGroup Label="Schätzfrage" ForId="estimation-question">
                                        <FrameworkInputText Id="estimation-question" @bind-Value="_selectedSlide.EstimationQuestion" Placeholder="Wie viele Kilo Schokolade werden verbraucht?" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Exakter / Richtiger Wert" ForId="estimation-correct-value">
                                        <FrameworkInputDouble Id="estimation-correct-value" @bind-Value="_selectedSlide.EstimationCorrectValue" Placeholder="z. B. 42" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Einheit" HelpText="optional, z. B. kg, Meter, Stück" ForId="estimation-unit">
                                        <FrameworkInputText Id="estimation-unit" @bind-Value="_selectedSlide.EstimationUnit" Placeholder="z. B. kg" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Maximale Punkte für beste Schätzung" ForId="estimation-points">
                                        <FrameworkInputNumber Id="estimation-points" @bind-Value="_selectedSlide.EstimationPoints" Min="0" Placeholder="100" />
                                    </FrameworkFormGroup>
                                }
                                else if (_selectedSlide.Type == "buzzer")
                                {
                                    <FrameworkFormGroup Label="Buzzer-Frage / Aufgabe" ForId="buzzer-question">
                                        <FrameworkInputText Id="buzzer-question" @bind-Value="_selectedSlide.BuzzerQuestion" Placeholder="Welches Team buzzert als Erstes?" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Punkte für schnellsten Buzzer/Antwort" ForId="buzzer-points">
                                        <FrameworkInputNumber Id="buzzer-points" @bind-Value="_selectedSlide.BuzzerPoints" Min="0" Placeholder="100" />
                                    </FrameworkFormGroup>
                                    <FrameworkFormGroup Label="Zeitlimit in Sekunden" HelpText="optional" ForId="buzzer-time-limit">
                                        <FrameworkInputNumber Id="buzzer-time-limit" @bind-Value="_selectedSlide.BuzzerTimeLimitSeconds" Min="5" Max="300" Placeholder="z. B. 20" />
                                    </FrameworkFormGroup>
                                }

                                @if (!string.IsNullOrEmpty(_selectedSlide.ErrorMessage))
                                {
                                    <FrameworkNotice Message="@_selectedSlide.ErrorMessage" Severity="error" />
                                }
                            </div>
                        </ChildContent>
                        <FooterContent>
                            <div class="slide-detail-footer">
                                <FrameworkButton Label="Slide löschen" Variant="danger" OnClick="() => DeleteSlideAsync(_selectedSlide)" Busy="@(_busySlideId == _selectedSlide.Id)" Disabled="@(_busySlideId is not null)" />
                                <FrameworkButton Label="Änderungen speichern" Variant="primary" OnClick="() => SaveSlideAsync(_selectedSlide)" Busy="@(_busySlideId == _selectedSlide.Id)" Disabled="@(_busySlideId is not null)" />
                            </div>
                        </FooterContent>
                    </Card>
                }
                else
                {
                    <EmptyState Title="Keine Slide ausgewählt" Description="Wähle eine Slide aus der linken Liste aus, um sie zu konfigurieren, oder erstelle eine neue Slide." />
                }
            </div>
        </div>
    }
</FrameworkPage>

<!-- ADD SLIDE MODAL -->
<FrameworkModal IsOpen="@_isAddModalOpen" Title="Neue Slide hinzufügen" OnClose="CloseAddModal">
    <div class="modal-form">
        <FrameworkFormGroup Label="Slide-Typ" ForId="modal-slide-type">
            <FrameworkSelect Id="modal-slide-type" Value="@_newSlideType" ValueChanged='v => _newSlideType = v ?? "announcement"' Options="@_slideTypeOptions" />
        </FrameworkFormGroup>

        <FrameworkFormGroup Label="Interner Name" HelpText="optional, nur im Admin-Panel sichtbar" ForId="modal-internal-name" Style="margin-top: 16px;">
            <FrameworkInputText Id="modal-internal-name" @bind-Value="_newSlideInternalName" Placeholder="z. B. Begrüßung & Regeln" />
        </FrameworkFormGroup>

        @if (!string.IsNullOrEmpty(_addModalError))
        {
            <div style="margin-top: 16px;">
                <FrameworkNotice Message="@_addModalError" Severity="error" />
            </div>
        }

        <div class="modal-footer-actions">
            <FrameworkButton Label="Abbrechen" Variant="secondary" OnClick="CloseAddModal" Disabled="@_adding" />
            <FrameworkButton Label="Slide hinzufügen" Variant="primary" OnClick="AddSlideAsync" Busy="@_adding" Disabled="@_adding" />
        </div>
    </div>
</FrameworkModal>

@code {
    [Parameter] public Guid ShowId { get; set; }

    private AdminShow? _show;
    private EditableSlide[] _slides = [];
    private EditableSlide? _selectedSlide;

    private bool _isAddModalOpen;
    private string _newSlideType = "announcement";
    private string _newSlideInternalName = string.Empty;
    private string? _addModalError;

    private Guid? _busySlideId;
    private bool _adding;

    private static readonly FrameworkSelectOption[] _slideTypeOptions =
    [
        new("announcement", "Ankündigung"),
        new("poll", "Abstimmung"),
        new("quiz", "Quiz"),
        new("ranking", "Zwischenstand (Automatisch)"),
        new("estimation", "Schätzfrage"),
        new("buzzer", "Buzzer-Frage")
    ];

    protected override async Task OnParametersSetAsync() => await LoadAuthenticatedAsync(LoadDataAsync);

    private async Task LoadDataAsync(string token)
    {
        var showTask = ProjectApiClient.GetAdminShowAsync(token, ShowId);
        var slidesTask = ProjectApiClient.GetAdminShowSlidesAsync(token, ShowId);
        await Task.WhenAll(showTask, slidesTask);

        _show = await showTask;
        var slideResponses = await slidesTask;

        var selectedId = _selectedSlide?.Id;

        _slides = slideResponses
            .Select(slide => new EditableSlide(slide.Id, slide.Type, slide.Position, slide.Parameters))
            .OrderBy(slide => slide.Position)
            .ToArray();

        if (selectedId is Guid targetId && _slides.FirstOrDefault(s => s.Id == targetId) is EditableSlide reselected)
        {
            _selectedSlide = reselected;
        }
        else
        {
            _selectedSlide = _slides.FirstOrDefault();
        }
    }

    private void SelectSlide(EditableSlide slide)
    {
        _selectedSlide = slide;
    }

    private void OpenAddModal()
    {
        _newSlideType = "announcement";
        _newSlideInternalName = string.Empty;
        _addModalError = null;
        _isAddModalOpen = true;
    }

    private void CloseAddModal()
    {
        if (!_adding)
        {
            _isAddModalOpen = false;
        }
    }

    private async Task AddSlideAsync()
    {
        _adding = true;
        _addModalError = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                object defaultPayload = _newSlideType switch
                {
                    "announcement" => new { internalName = _newSlideInternalName.Trim(), title = string.Empty, message = string.Empty },
                    "poll" => new { internalName = _newSlideInternalName.Trim(), question = string.Empty, options = new[] { string.Empty, string.Empty }, allowMultipleAnswers = false, hideResultsUntilRevealed = false, showPercentage = false },
                    "quiz" => new { internalName = _newSlideInternalName.Trim(), question = string.Empty, answers = new[] { string.Empty, string.Empty }, correctAnswerIndices = new[] { 0 }, timeLimitSeconds = (int?)null, points = 100, enableSpeedBonus = false, explanation = string.Empty },
                    "ranking" => new { internalName = _newSlideInternalName.Trim(), title = "Zwischenstand", topCount = (int?)null, animatePodium = false },
                    "estimation" => new { internalName = _newSlideInternalName.Trim(), question = string.Empty, correctValue = 0.0, unit = string.Empty, points = 100 },
                    "buzzer" => new { internalName = _newSlideInternalName.Trim(), question = string.Empty, points = 100, timeLimitSeconds = (int?)null },
                    _ => new { internalName = _newSlideInternalName.Trim() }
                };

                var createdSlide = await ProjectApiClient.CreateAdminShowSlideAsync(
                    token,
                    ShowId,
                    new SlideWriteRequest(_newSlideType, _slides.Length, JsonSerializer.SerializeToElement(defaultPayload)));

                _isAddModalOpen = false;
                await LoadDataAsync(token);

                if (createdSlide is not null)
                {
                    _selectedSlide = _slides.FirstOrDefault(s => s.Id == createdSlide.Id);
                }
            });
        }
        catch (Exception ex)
        {
            _addModalError = "Fehler beim Erstellen der Slide: " + ex.Message;
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task SaveSlideAsync(EditableSlide slide)
    {
        var (parameters, error) = slide.BuildParameters();
        if (error is not null)
        {
            return;
        }

        _busySlideId = slide.Id;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.UpdateAdminShowSlideAsync(
                    token,
                    ShowId,
                    slide.Id,
                    new SlideWriteRequest(slide.Type, slide.Position, parameters));
                await LoadDataAsync(token);
            });
            slide.ErrorMessage = null;
        }
        catch (Exception ex)
        {
            slide.ErrorMessage = "Fehler beim Speichern der Slide: " + ex.Message;
        }
        finally
        {
            _busySlideId = null;
        }
    }

    private async Task MoveSlideAsync(EditableSlide slide, int direction)
    {
        var ordered = _slides.OrderBy(item => item.Position).ToList();
        var currentIndex = ordered.IndexOf(slide);
        var targetIndex = currentIndex + direction;
        if (targetIndex < 0 || targetIndex >= ordered.Count)
        {
            return;
        }

        var temp = ordered[currentIndex];
        ordered[currentIndex] = ordered[targetIndex];
        ordered[targetIndex] = temp;

        for (int i = 0; i < ordered.Count; i++)
        {
            ordered[i].Position = i;
        }

        _slides = ordered.ToArray();
        _busySlideId = slide.Id;

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                var slideIds = _slides.Select(s => s.Id).ToArray();
                await ProjectApiClient.ReorderAdminShowSlidesAsync(token, ShowId, slideIds);
            });
        }
        catch
        {
            await RunAuthenticatedAsync(LoadDataAsync);
        }
        finally
        {
            _busySlideId = null;
        }
    }

    private async Task DeleteSlideAsync(EditableSlide slide)
    {
        _busySlideId = slide.Id;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.DeleteAdminShowSlideAsync(token, ShowId, slide.Id);
                _selectedSlide = null;

                var remainingIds = _slides.Where(s => s.Id != slide.Id).Select(s => s.Id).ToArray();
                if (remainingIds.Length > 0)
                {
                    await ProjectApiClient.ReorderAdminShowSlidesAsync(token, ShowId, remainingIds);
                }

                await LoadDataAsync(token);
            });
        }
        catch (Exception ex)
        {
            slide.ErrorMessage = "Fehler beim Löschen: " + ex.Message;
        }
        finally
        {
            _busySlideId = null;
        }
    }

    private void RemovePollOption(EditableSlide slide, int index)
    {
        if (slide.PollOptions.Count > 2)
        {
            slide.PollOptions.RemoveAt(index);
        }
    }

    private void RemoveQuizAnswer(EditableSlide slide, int index)
    {
        if (slide.QuizAnswers.Count > 2)
        {
            slide.QuizAnswers.RemoveAt(index);
            slide.QuizCorrectAnswerIndices.Remove(index);
            for (int i = 0; i < slide.QuizCorrectAnswerIndices.Count; i++)
            {
                if (slide.QuizCorrectAnswerIndices[i] > index)
                {
                    slide.QuizCorrectAnswerIndices[i]--;
                }
            }
        }
    }

    private void ToggleQuizCorrectAnswer(EditableSlide slide, int index, bool isCorrect)
    {
        if (isCorrect)
        {
            if (!slide.QuizCorrectAnswerIndices.Contains(index))
            {
                slide.QuizCorrectAnswerIndices.Add(index);
            }
        }
        else
        {
            slide.QuizCorrectAnswerIndices.Remove(index);
        }
    }

    private static string SlideTypeLabel(string type) => type switch
    {
        "announcement" => "Ankündigung",
        "poll" => "Abstimmung",
        "quiz" => "Quiz",
        "ranking" => "Zwischenstand",
        "estimation" => "Schätzfrage",
        "buzzer" => "Buzzer",
        _ => type
    };

    private sealed class EditableSlide
    {
        private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

        public Guid Id { get; }
        public string Type { get; }
        public int Position { get; set; }
        public string InternalName { get; set; } = string.Empty;
        public string AdminNotes { get; set; } = string.Empty;
        public bool IsDisabled { get; set; }
        public string? ErrorMessage { get; set; }

        // Announcement
        public string AnnouncementTitle { get; set; } = string.Empty;
        public string AnnouncementMessage { get; set; } = string.Empty;

        // Poll
        public string PollQuestion { get; set; } = string.Empty;
        public List<string> PollOptions { get; set; } = [];
        public bool PollAllowMultiple { get; set; }
        public bool PollHideResultsUntilRevealed { get; set; }
        public bool PollShowPercentage { get; set; }

        // Quiz
        public string QuizQuestion { get; set; } = string.Empty;
        public List<string> QuizAnswers { get; set; } = [];
        public List<int> QuizCorrectAnswerIndices { get; set; } = [];
        public int? QuizTimeLimitSeconds { get; set; }
        public int QuizPoints { get; set; } = 100;
        public bool QuizEnableSpeedBonus { get; set; }
        public string QuizExplanation { get; set; } = string.Empty;

        // Ranking
        public string RankingTitle { get; set; } = "Zwischenstand";
        public int? RankingTopCount { get; set; }
        public bool RankingAnimatePodium { get; set; }

        // Estimation
        public string EstimationQuestion { get; set; } = string.Empty;
        public double EstimationCorrectValue { get; set; }
        public string EstimationUnit { get; set; } = string.Empty;
        public int EstimationPoints { get; set; } = 100;

        // Buzzer
        public string BuzzerQuestion { get; set; } = string.Empty;
        public int BuzzerPoints { get; set; } = 100;
        public int? BuzzerTimeLimitSeconds { get; set; }

        public EditableSlide(Guid id, string type, int position, JsonElement parameters)
        {
            Id = id;
            Type = type;
            Position = position;
            InternalName = ReadString(parameters, "internalName");
            AdminNotes = ReadString(parameters, "adminNotes");
            IsDisabled = ReadBool(parameters, "isDisabled");

            switch (type)
            {
                case "announcement":
                    AnnouncementTitle = ReadString(parameters, "title");
                    AnnouncementMessage = ReadString(parameters, "message");
                    break;
                case "poll":
                    PollQuestion = ReadString(parameters, "question");
                    PollOptions = ReadStringList(parameters, "options");
                    PollAllowMultiple = ReadBool(parameters, "allowMultipleAnswers");
                    PollHideResultsUntilRevealed = ReadBool(parameters, "hideResultsUntilRevealed");
                    PollShowPercentage = ReadBool(parameters, "showPercentage");
                    if (PollOptions.Count < 2)
                    {
                        while (PollOptions.Count < 2) PollOptions.Add(string.Empty);
                    }
                    break;
                case "quiz":
                    QuizQuestion = ReadString(parameters, "question");
                    QuizAnswers = ReadStringList(parameters, "answers");
                    QuizCorrectAnswerIndices = ReadIntList(parameters, "correctAnswerIndices");
                    QuizTimeLimitSeconds = ReadNullableInt(parameters, "timeLimitSeconds");
                    QuizPoints = ReadNullableInt(parameters, "points") ?? 100;
                    QuizEnableSpeedBonus = ReadBool(parameters, "enableSpeedBonus");
                    QuizExplanation = ReadString(parameters, "explanation");
                    if (QuizAnswers.Count < 2)
                    {
                        while (QuizAnswers.Count < 2) QuizAnswers.Add(string.Empty);
                    }
                    break;
                case "ranking":
                    RankingTitle = !string.IsNullOrWhiteSpace(ReadString(parameters, "title")) ? ReadString(parameters, "title") : "Zwischenstand";
                    RankingTopCount = ReadNullableInt(parameters, "topCount");
                    RankingAnimatePodium = ReadBool(parameters, "animatePodium");
                    break;
                case "estimation":
                    EstimationQuestion = ReadString(parameters, "question");
                    EstimationCorrectValue = ReadDouble(parameters, "correctValue");
                    EstimationUnit = ReadString(parameters, "unit");
                    EstimationPoints = ReadNullableInt(parameters, "points") ?? 100;
                    break;
                case "buzzer":
                    BuzzerQuestion = ReadString(parameters, "question");
                    BuzzerPoints = ReadNullableInt(parameters, "points") ?? 100;
                    BuzzerTimeLimitSeconds = ReadNullableInt(parameters, "timeLimitSeconds");
                    break;
            }
        }

        public string DisplayName =>
            !string.IsNullOrWhiteSpace(InternalName)
                ? InternalName
                : Type switch
                {
                    "announcement" => !string.IsNullOrWhiteSpace(AnnouncementTitle) ? AnnouncementTitle : "Ankündigung",
                    "poll" => !string.IsNullOrWhiteSpace(PollQuestion) ? PollQuestion : "Abstimmung",
                    "quiz" => !string.IsNullOrWhiteSpace(QuizQuestion) ? QuizQuestion : "Quiz",
                    "ranking" => !string.IsNullOrWhiteSpace(RankingTitle) ? RankingTitle : "Zwischenstand",
                    "estimation" => !string.IsNullOrWhiteSpace(EstimationQuestion) ? EstimationQuestion : "Schätzfrage",
                    "buzzer" => !string.IsNullOrWhiteSpace(BuzzerQuestion) ? BuzzerQuestion : "Buzzer",
                    _ => "Slide"
                };

        public (JsonElement Parameters, string? Error) BuildParameters()
        {
            ErrorMessage = null;
            object payload;

            switch (Type)
            {
                case "announcement":
                    if (string.IsNullOrWhiteSpace(AnnouncementTitle))
                    {
                        ErrorMessage = "Bitte einen Titel für die Ankündigung eingeben.";
                        return (default, ErrorMessage);
                    }
                    payload = new
                    {
                        internalName = InternalName.Trim(),
                        adminNotes = AdminNotes.Trim(),
                        isDisabled = IsDisabled,
                        title = AnnouncementTitle.Trim(),
                        message = AnnouncementMessage.Trim()
                    };
                    break;

                case "poll":
                    var validPollOptions = PollOptions.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
                    if (string.IsNullOrWhiteSpace(PollQuestion))
                    {
                        ErrorMessage = "Bitte eine Frage für die Abstimmung eingeben.";
                        return (default, ErrorMessage);
                    }
                    if (validPollOptions.Count < 2)
                    {
                        ErrorMessage = "Bitte mindestens 2 Antwortoptionen eingeben.";
                        return (default, ErrorMessage);
                    }
                    payload = new
                    {
                        internalName = InternalName.Trim(),
                        adminNotes = AdminNotes.Trim(),
                        isDisabled = IsDisabled,
                        question = PollQuestion.Trim(),
                        options = validPollOptions,
                        allowMultipleAnswers = PollAllowMultiple,
                        hideResultsUntilRevealed = PollHideResultsUntilRevealed,
                        showPercentage = PollShowPercentage
                    };
                    break;

                case "quiz":
                    var validQuizAnswers = QuizAnswers.Where(a => !string.IsNullOrWhiteSpace(a)).Select(a => a.Trim()).ToList();
                    if (string.IsNullOrWhiteSpace(QuizQuestion))
                    {
                        ErrorMessage = "Bitte eine Quizfrage eingeben.";
                        return (default, ErrorMessage);
                    }
                    if (validQuizAnswers.Count < 2)
                    {
                        ErrorMessage = "Bitte mindestens 2 Antwortmöglichkeiten eingeben.";
                        return (default, ErrorMessage);
                    }
                    if (QuizCorrectAnswerIndices.Count == 0)
                    {
                        ErrorMessage = "Bitte mindestens eine Antwort als richtig markieren.";
                        return (default, ErrorMessage);
                    }
                    payload = new
                    {
                        internalName = InternalName.Trim(),
                        adminNotes = AdminNotes.Trim(),
                        isDisabled = IsDisabled,
                        question = QuizQuestion.Trim(),
                        answers = validQuizAnswers,
                        correctAnswerIndices = QuizCorrectAnswerIndices,
                        timeLimitSeconds = QuizTimeLimitSeconds,
                        points = QuizPoints,
                        enableSpeedBonus = QuizEnableSpeedBonus,
                        explanation = QuizExplanation.Trim()
                    };
                    break;

                case "ranking":
                    payload = new
                    {
                        internalName = InternalName.Trim(),
                        adminNotes = AdminNotes.Trim(),
                        isDisabled = IsDisabled,
                        title = string.IsNullOrWhiteSpace(RankingTitle) ? "Zwischenstand" : RankingTitle.Trim(),
                        topCount = RankingTopCount,
                        animatePodium = RankingAnimatePodium
                    };
                    break;

                case "estimation":
                    if (string.IsNullOrWhiteSpace(EstimationQuestion))
                    {
                        ErrorMessage = "Bitte eine Schätzfrage eingeben.";
                        return (default, ErrorMessage);
                    }
                    var safeCorrectValue = double.IsNaN(EstimationCorrectValue) || double.IsInfinity(EstimationCorrectValue) ? 0.0 : EstimationCorrectValue;
                    payload = new
                    {
                        internalName = InternalName.Trim(),
                        adminNotes = AdminNotes.Trim(),
                        isDisabled = IsDisabled,
                        question = EstimationQuestion.Trim(),
                        correctValue = safeCorrectValue,
                        unit = EstimationUnit.Trim(),
                        points = EstimationPoints
                    };
                    break;

                case "buzzer":
                    if (string.IsNullOrWhiteSpace(BuzzerQuestion))
                    {
                        ErrorMessage = "Bitte eine Buzzer-Frage eingeben.";
                        return (default, ErrorMessage);
                    }
                    payload = new
                    {
                        internalName = InternalName.Trim(),
                        adminNotes = AdminNotes.Trim(),
                        isDisabled = IsDisabled,
                        question = BuzzerQuestion.Trim(),
                        points = BuzzerPoints,
                        timeLimitSeconds = BuzzerTimeLimitSeconds
                    };
                    break;

                default:
                    payload = new
                    {
                        internalName = InternalName.Trim(),
                        adminNotes = AdminNotes.Trim(),
                        isDisabled = IsDisabled
                    };
                    break;
            }

            return (JsonSerializer.SerializeToElement(payload, payload.GetType(), JsonOptions), null);
        }

        private static string ReadString(JsonElement element, string prop) =>
            element.ValueKind == JsonValueKind.Object && element.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.String
                ? val.GetString() ?? string.Empty
                : string.Empty;

        private static bool ReadBool(JsonElement element, string prop) =>
            element.ValueKind == JsonValueKind.Object && element.TryGetProperty(prop, out var val) && (val.ValueKind == JsonValueKind.True || val.ValueKind == JsonValueKind.False)
                ? val.GetBoolean()
                : false;

        private static int? ReadNullableInt(JsonElement element, string prop) =>
            element.ValueKind == JsonValueKind.Object && element.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.Number
                ? val.GetInt32()
                : null;

        private static double ReadDouble(JsonElement element, string prop) =>
            element.ValueKind == JsonValueKind.Object && element.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.Number
                ? val.GetDouble()
                : 0.0;

        private static List<string> ReadStringList(JsonElement element, string prop)
        {
            var result = new List<string>();
            if (element.ValueKind == JsonValueKind.Object && element.TryGetProperty(prop, out var array) && array.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in array.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.String)
                    {
                        result.Add(item.GetString() ?? string.Empty);
                    }
                }
            }
            return result;
        }

        private static List<int> ReadIntList(JsonElement element, string prop)
        {
            var result = new List<int>();
            if (element.ValueKind == JsonValueKind.Object && element.TryGetProperty(prop, out var array) && array.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in array.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.Number)
                    {
                        result.Add(item.GetInt32());
                    }
                }
            }
            return result;
        }
    }
}
