@using WeihnachtsfeierBit.Framework
@inherits AuthenticatedComponentBase
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<FrameworkPage>
    <PageHeading Eyebrow="PROJEKT-CHAT & SUPPORT" Title="Live-Chat & Moderation" Description="Kommuniziere mit Teams, Teilnehmern und beantworte Support-Anfragen in Echtzeit." />

    @if (IsLoading)
    {
        <FrameworkLoading Message="Chat wird geladen ..." />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" Severity="error" />
    }
    else
    {
        <div style="height: 65vh; min-height: 450px;">
            <FrameworkChat ProjectId="@ProjectId"
                           AccessToken="@_accessToken"
                           IsAdmin="true" />
        </div>
    }
</FrameworkPage>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private string? _accessToken;

    protected override async Task OnParametersSetAsync() => await LoadAuthenticatedAsync(async token =>
    {
        _accessToken = token;
    });
}
