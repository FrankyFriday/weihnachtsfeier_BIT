@using WeihnachtsfeierBit.AdminClient.Models

<div class="callout callout-info" role="note">Während der Runde sieht nur die pro Team ausgewählte darstellende Person den aktuellen Begriff auf dem eigenen Gerät. Beamer und übrige Teilnehmergeräte zeigen keine Begriffe.</div>
<FrameworkFormGroup Label="Kategorie" ForId="pantomime-category">
    <FrameworkInputText Id="pantomime-category" @bind-Value="Slide.PantomimeCategory" MaxLength="120" Placeholder="z. B. IT-Tätigkeiten" />
</FrameworkFormGroup>
<FrameworkFormGroup Label="Begriffe" HelpText="Ein Begriff pro Zeile, 3 bis 100 eindeutige Begriffe, maximal 120 Zeichen pro Begriff." ForId="pantomime-terms">
    <FrameworkTextArea Id="pantomime-terms" @bind-Value="Slide.PantomimeTermsText" Rows="10" />
</FrameworkFormGroup>
<FrameworkFormGroup Label="Rundendauer in Sekunden" HelpText="Gemeinsame Rundendauer für alle Teams, 10 bis 600 Sekunden." ForId="pantomime-duration">
    <FrameworkInputNumber Id="pantomime-duration" @bind-Value="Slide.PantomimeRoundDurationSeconds" Min="10" Max="600" />
</FrameworkFormGroup>

@code {
    [Parameter, EditorRequired] public EditableSlide Slide { get; set; } = null!;
}
