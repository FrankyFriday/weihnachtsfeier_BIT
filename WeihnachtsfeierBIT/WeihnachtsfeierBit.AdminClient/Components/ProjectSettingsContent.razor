@inherits AuthenticatedComponentBase
@inject NavigationManager Navigation

<FrameworkPage>
    <FrameworkLink Href="@($"{Navigation.BaseUri}projects/{ProjectId}")" Label="Zur Projektübersicht" Variant="secondary" />
    @if (IsLoading)
    {
        <FrameworkLoading Message="Projekt wird geladen ..." />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" />
    }
    else if (_project is not null && !string.IsNullOrEmpty(AccessToken))
    {
        <PageHeading Eyebrow="PROJEKT" Title="Einstellungen" Description="@($"Allgemeine Angaben für {_project.Name}.")" />
        <ProjectSettingsForm Project="_project" AccessToken="@AccessToken" OnSaved="UpdateProject" OnDeleted="ProjectDeleted" />
    }
</FrameworkPage>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? _project;

    protected override async Task OnParametersSetAsync() =>
        await LoadAuthenticatedAsync(async token => _project = await ProjectApiClient.GetProjectAsync(token, ProjectId));

    private void UpdateProject(ProjectResponse project) => _project = project;

    private void ProjectDeleted() => Navigation.NavigateTo(Navigation.BaseUri);
}