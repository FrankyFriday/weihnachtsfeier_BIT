    private string? _modalError;

    // EDIT EVENT MODAL STATE
    private bool _isEditEventModalOpen;
    private EventState? _editingEvent;
    private string _editTitle = string.Empty;
    private string _editSubtitle = string.Empty;
    private string _editMode = "active";
    private string _editNavMode = "host_controlled";
    private bool _editIsHidden;
    private string _editScheduledTime = string.Empty;
    private bool _editAutoStart = true;
    private bool _isSavingEdit;
    private string? _editModalError;

    // POINT AWARD & LOG MODAL STATE
    private bool _isAwardPointsModalOpen;
    private Guid _awardTeamId;
    private int _awardDeltaPoints = 10;
    private string _awardReason = string.Empty;
    private bool _isSubmittingAward;
    private string? _awardModalError;

    private bool _isPointLogModalOpen;
    private TeamPointLogDto[] _pointLogs = [];

    private string? _noticeMessage;
    private string? _actionError;
    private bool _processing;

    private HubConnection? _hubConnection;

    private TabItem? _selectedTabItem => _tabs.FirstOrDefault(t => t.Id == _selectedTabId);

    private FrameworkSelectOption[] _teamSelectOptions =>
        _teams.Select(t => new FrameworkSelectOption(t.Id.ToString(), t.DisplayName)).ToArray();

    private static readonly FrameworkDropdownOption[] _sessionOptions =
    [
        new("end_session", "Session beenden", "power_settings_new")
    ];

    private static readonly FrameworkDropdownOption[] _addContentOptions =
    [
        new("show", "Show aus Katalog hinzufügen", "collections_bookmark"),
        new("spontaneous", "Spontanes Event erstellen", "add_circle")
    ];

    private static readonly FrameworkSelectOption[] _slideTypeOptions =
    [
        new("announcement", "Ankündigung"),
        new("poll", "Abstimmung"),
        new("quiz", "Quiz"),
        new("estimation", "Schätzfrage"),
        new("buzzer", "Buzzer"),
        new("ranking", "Rangliste")
    ];

    private static readonly FrameworkSelectOption[] _modeOptions =
    [
        new("active", "Aktiv (Vordergrund-Takeover)"),
        new("passive", "Passiv (Menüliste)")
    ];

    private static readonly FrameworkSelectOption[] _navModeOptions =
    [
        new("host_controlled", "Moderiert (Vom Spielleiter gesteuert)"),
        new("self_paced", "Selbstständig (Teilnehmer blättern selbst)")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ConnectSignalRAsync();
    }

    protected override async Task OnParametersSetAsync() => await LoadAuthenticatedAsync(async token =>
    {
        await LoadDataAsync();
    });

    private async Task ConnectSignalRAsync()
    {
        if (_hubConnection is not null) return;
        try
        {
            var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https+http://apiservice";
            var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/gamestate";

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<ProjectGameState>("GameStateUpdated", async (state) =>
            {
                if (state.ProjectId == ProjectId)
                {
                    _sessionState = state;
                    _activeCanvasEventId = state.ActiveCanvasEventId;
                    await InvokeAsync(async () =>
                    {
                        await BuildTabsAsync();
                        StateHasChanged();
                    });
                }
            });

            await _hubConnection.StartAsync();
            await _hubConnection.SendAsync("JoinProject", ProjectId);
        }
        catch
        {
        }
    }

    private async Task LoadDataAsync()
    {
        await RunAuthenticatedAsync(async token =>
        {
            var instanceTask = ProjectApiClient.GetActiveGameInstanceAsync(token, ProjectId);
            var teamsTask = ProjectApiClient.GetTeamsAsync(token, ProjectId);
            var showsTask = ProjectApiClient.GetShowsAsync(token, ProjectId);

            await Task.WhenAll(instanceTask, teamsTask, showsTask);

            _instance = await instanceTask;
            _teams = await teamsTask;
            _projectShows = await showsTask;

            if (_teams.Length > 0 && _awardTeamId == Guid.Empty)
            {
                _awardTeamId = _teams[0].Id;
            }

            if (_instance is not null)
            {
                _sessionState = await ProjectApiClient.GetSessionStateAsync(token, ProjectId);
                _activeCanvasEventId = _sessionState.ActiveCanvasEventId;
                await BuildTabsAsync();
            }

            StateHasChanged();
        });
    }

    private Task BuildTabsAsync()
    {
        _tabs.Clear();

        if (_sessionState is null) return Task.CompletedTask;

        // 1. Active Event (Position 1)
        if (_sessionState.ActiveEvent is EventState activeEv)
        {
            bool isBeamer = _activeCanvasEventId.HasValue && activeEv.EventId == _activeCanvasEventId.Value;
            _tabs.Add(new TabItem(activeEv.EventId.ToString(), activeEv.Title, "play_arrow", isBeamer, activeEv));
        }

        // 2. Passive Events
        foreach (var passEv in _sessionState.PassiveEvents)
        {
            bool isBeamer = _activeCanvasEventId.HasValue && passEv.EventId == _activeCanvasEventId.Value;
            _tabs.Add(new TabItem(passEv.EventId.ToString(), passEv.Title, null, isBeamer, passEv));
        }

        // 3. Scheduled Events (Sorted chronologically by ScheduledStartUtc)
        foreach (var schedEv in _sessionState.ScheduledEvents.OrderBy(e => e.ScheduledStartUtc))
        {
            bool isBeamer = _activeCanvasEventId.HasValue && schedEv.EventId == _activeCanvasEventId.Value;
            _tabs.Add(new TabItem(schedEv.EventId.ToString(), schedEv.Title, "schedule", isBeamer, schedEv));
        }

        if (_selectedTabId is null || !_tabs.Any(t => t.Id == _selectedTabId))
        {
            _selectedTabId = _tabs.FirstOrDefault()?.Id;
        }

        return Task.CompletedTask;
    }

    private void SelectTab(string tabId) => _selectedTabId = tabId;

    private void HandleAddContentSelect(string optionValue)
    {
        if (optionValue == "show")
        {
            OpenLinkShowModal();
        }
        else if (optionValue == "spontaneous")
        {
            OpenSpontaneousModal();
        }
    }

    private void HandleSessionOptionSelect(string optionValue)
    {
        if (optionValue == "end_session")
        {
            _isEndSessionConfirmOpen = true;
        }
    }

    private async Task ConfirmEndSessionAsync()
    {
        _isEndSessionConfirmOpen = false;
        await EndSessionAsync();
    }

    private void OpenAwardPointsForTeam(Guid teamId)
    {
        _awardTeamId = teamId;
        OpenAwardPointsModal();
    }

    private void OpenAwardPointsModal()
    {
        _awardDeltaPoints = 10;
        _awardReason = string.Empty;
        _awardModalError = null;
        _isAwardPointsModalOpen = true;
    }

    private void CloseAwardPointsModal() => _isAwardPointsModalOpen = false;

    private async Task SubmitAwardPointsAsync()
    {
        if (_awardTeamId == Guid.Empty)
        {
            _awardModalError = "Bitte wähle ein Team aus.";
            return;
        }

        _isSubmittingAward = true;
        _awardModalError = null;

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.AwardTeamPointsAsync(token, ProjectId, _awardTeamId, _awardDeltaPoints, _awardReason);
                _isAwardPointsModalOpen = false;
                await LoadDataAsync();
            });
        }
        catch (Exception ex)
        {
            _awardModalError = ex.Message;
        }
        finally
        {
            _isSubmittingAward = false;
        }
    }

    private async Task OpenPointLogModal()
    {
        _isPointLogModalOpen = true;
        await RunAuthenticatedAsync(async token =>
        {
            _pointLogs = await ProjectApiClient.GetPointLogsAsync(token, ProjectId);
            StateHasChanged();
        });
    }

    private void ClosePointLogModal() => _isPointLogModalOpen = false;

    private void OpenEditEventModal(EventState ev)
    {
        _editingEvent = ev;
        _editTitle = ev.Title;
        _editSubtitle = ev.Subtitle ?? string.Empty;
        _editMode = ev.Mode;
        _editNavMode = ev.NavigationMode;
        _editIsHidden = ev.IsHidden;
        _editScheduledTime = ev.ScheduledStartUtc.HasValue ? ev.ScheduledStartUtc.Value.ToLocalTime().ToString("HH:mm") : string.Empty;
        _editAutoStart = ev.AutoStartOnSchedule;
        _editModalError = null;
        _isEditEventModalOpen = true;
    }

    private void CloseEditEventModal()
    {
        _isEditEventModalOpen = false;
        _editingEvent = null;
    }

    private async Task SaveEditedEventAsync()
    {
        if (_editingEvent is null) return;
        _isSavingEdit = true;
        _editModalError = null;

        DateTime? schedUtc = ParseTimeInput(!string.IsNullOrWhiteSpace(_editScheduledTime), _editScheduledTime);

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.UpdateEventAsync(
                    token,
                    ProjectId,
                    _editingEvent.EventId,
                    title: _editTitle,
                    subtitle: _editSubtitle,
                    navigationMode: _editNavMode,
                    scheduledStartUtc: schedUtc,
                    autoStartOnSchedule: _editAutoStart,
                    mode: _editMode,
                    isHidden: _editIsHidden);

                _isEditEventModalOpen = false;
                await LoadDataAsync();
            });
        }
        catch (Exception ex)
        {
            _editModalError = ex.Message;
        }
        finally
        {
            _isSavingEdit = false;
        }
    }

    private async Task CloseEditingEventAsync()
    {
        if (_editingEvent is null) return;
        var eventId = _editingEvent.EventId;
        _isEditEventModalOpen = false;
        await CloseEventAsync(eventId);
    }

    private async Task StartNewSessionAsync()
    {
        _processing = true;
        _actionError = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                _instance = await ProjectApiClient.StartGameInstanceAsync(token, ProjectId);
                _noticeMessage = $"Session mit Code {_instance.AccessCode} erfolgreich gestartet!";
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task EndSessionAsync()
    {
        _processing = true;
        _actionError = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.EndGameInstanceAsync(token, ProjectId);
                _instance = null;
                _sessionState = null;
                _tabs.Clear();
                _noticeMessage = "Session wurde beendet.";
