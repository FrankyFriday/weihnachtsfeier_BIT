    private async Task ChangePointsAsync(TeamState team, int delta)
    {
        var newPoints = Math.Max(0, team.Points + delta);
        await SetPointsAsync(team, newPoints);
    }

    private async Task OnPointsInputChangedAsync(TeamState team, string? input)
    {
        if (int.TryParse(input, out var points) && points >= 0)
        {
            await SetPointsAsync(team, points);
        }
    }

