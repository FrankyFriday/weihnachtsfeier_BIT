@namespace WeihnachtsfeierBit.AdminClient.Components
@inherits AuthenticatedComponentBase
@implements IAsyncDisposable

<FrameworkPage>
    @if (_state.IsLoading)
    {
        <FrameworkLoading Message="Session-Dashboard wird geladen ..." />
    }
    else
    {
        <SessionToolbar Instance="_state.Instance"
                        HubConnection="_state.HubConnection"
                        CanvasUrl="@GetCanvasUrl()"
                        SessionOptions="_sessionOptions"
                        OnSessionOptionSelect="HandleSessionOptionSelect"
                        OnStartSession="OpenStartSessionModal"
                        IsProcessing="_state.IsProcessing" />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <FrameworkNotice Message="@ErrorMessage" Severity="error" />
        }

        <div class="regie-dashboard-layout">
            <div class="regie-dashboard-main">
                @if (!string.IsNullOrEmpty(_state.NoticeMessage))
                {
                    <FrameworkNotice Message="@_state.NoticeMessage" Severity="success" />
                }
                @if (!string.IsNullOrEmpty(_state.ActionError))
                {
                    <FrameworkNotice Message="@_state.ActionError" Severity="error" />
                }

                @if (_state.Instance is not null)
                {
                    <EventTabsBar Tabs="_state.Tabs"
                                  SelectedTabId="@_state.SelectedTabId"
                                  OnSelectTab="tabId => _state.SelectTab(tabId)"
                                  AddContentOptions="_addContentOptions"
                                  OnAddContentSelect="HandleAddContentSelect" />

                    @if (_state.SelectedTabItem is not null)
                    {
                        <ActiveEventCard Event="_state.SelectedTabItem.Event"
                                         ProjectId="ProjectId"
                                         ActiveCanvasEventId="_state.ActiveCanvasEventId"
                                         OnStepEventSlide="dir => _state.StepEventSlideToAsync(_state.SelectedTabItem.Event, _state.SelectedTabItem.Event.CurrentSlideIndex + dir)"
                                         OnStepEventSlideTo="idx => _state.StepEventSlideToAsync(_state.SelectedTabItem.Event, idx)"
                                         OnStepSequenceNext="ctx => _state.StepSequenceNextAsync(_state.SelectedTabItem.Event, ctx)"
                                         OnReturnToJeopardyBoard="() => _state.ReturnToJeopardyBoardAsync(_state.SelectedTabItem.Event)"
                                         OnSetCanvasEvent="id => _state.SetCanvasEventAsync(id)"
                                         OnToggleRegieSidebar="ToggleRegieSidebar"
                                         OnOpenEditEventModal="() => OpenEditEventModal(_state.SelectedTabItem.Event)"
                                         OnStartScheduledEventNow="ev => _state.StartScheduledEventNowAsync(ev)" />
                    }
                    else
                    {
                        <EmptyState Title="Keine laufenden Shows oder Events" Description="Klicke oben rechts auf 'Inhalt hinzufügen', um Shows oder spontane Events in der Session zu starten." />
                    }
                }

                <TeamScoresSection Teams="_state.Teams"
                                   OnOpenAwardPointsForTeam="OpenAwardPointsForTeam"
                                   OnOpenPointLogModal="OpenPointLogModal" />
            </div>

            <ModerationSidebar @ref="_moderationSidebar"
                               IsOpen="_isRegieSidebarOpen"
                               IsPinned="_isRegieSidebarPinned"
                               Participants="_state.Participants"
                               Teams="_state.Teams"
                               Instance="_state.Instance"
                               OnToggleSidebar="ToggleRegieSidebar"
                               OnTogglePin="ToggleRegiePin"
                               OnOpenPermissions="OpenPermissionsModal" />
        </div>

        <!-- MODALS -->
        <AwardPointsModal IsOpen="_isAwardPointsModalOpen"
                          ProjectId="ProjectId"
                          Teams="_state.Teams"
                          DefaultTeamId="_awardDefaultTeamId"
                          OnClose="CloseAwardPointsModal"
                          OnPointsAwarded="() => _state.LoadDataAsync()"
                          RunAuthenticated="RunAuthenticatedAsync" />

        <PointLogsModal IsOpen="_isPointLogModalOpen"
                        ProjectId="ProjectId"
                        OnClose="ClosePointLogModal"
                        RunAuthenticated="RunAuthenticatedAsync" />

        <EditEventModal IsOpen="_isEditEventModalOpen"
                        ProjectId="ProjectId"
                        EditingEvent="_editingEvent"
                        ModeOptions="_modeOptions"
                        NavModeOptions="_navModeOptions"
                        OnClose="CloseEditEventModal"
                        OnEventUpdated="() => _state.LoadDataAsync()"
                        RunAuthenticated="RunAuthenticatedAsync" />

        <LinkShowModal IsOpen="_isLinkShowModalOpen"
                       ProjectId="ProjectId"
                       Shows="_state.ProjectShows"
                       ModeOptions="_modeOptions"
                       NavModeOptions="_navModeOptions"
                       OnClose="CloseLinkShowModal"
                       OnShowStarted="() => _state.LoadDataAsync()"
                       RunAuthenticated="RunAuthenticatedAsync" />

        <StartSessionModal IsOpen="_isStartSessionModalOpen"
                           ProjectId="ProjectId"
                           OnClose="CloseStartSessionModal"
                           OnSessionStarted="data => OnSessionStarted(data.Instance, data.Notice)"
                           RunAuthenticated="RunAuthenticatedAsync" />

        <SpontaneousEventModal IsOpen="_isSpontaneousModalOpen"
                               ProjectId="ProjectId"
                               SlideTypeOptions="_slideTypeOptions"
                               ModeOptions="_modeOptions"
                               NavModeOptions="_navModeOptions"
                               OnClose="CloseSpontaneousModal"
                               OnEventCreated="() => _state.LoadDataAsync()"
                               RunAuthenticated="RunAuthenticatedAsync" />

        <ParticipantPermissionsModal IsOpen="_isPermissionsModalOpen"
                                     ProjectId="ProjectId"
                                     Participant="_permissionsParticipant"
                                     OnClose="ClosePermissionsModal"
                                     OnPermissionsSaved="() => _state.LoadDataAsync()"
                                     RunAuthenticated="RunAuthenticatedAsync" />
    }
</FrameworkPage>
