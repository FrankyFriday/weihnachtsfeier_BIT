        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task StepEventSlide(EventState ev, int direction)
    {
        var targetIndex = ev.CurrentSlideIndex + direction;
        if (targetIndex < 0 || targetIndex >= ev.Slides.Length) return;
        await StepEventSlideTo(ev, targetIndex);
    }

    private async Task StepEventSlideTo(EventState ev, int targetSlideIndex)
    {
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.UpdateEventAsync(token, ProjectId, ev.EventId, currentSlideIndex: targetSlideIndex);
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private void OpenSpontaneousModal()
    {
        _spontaneousType = "announcement";
        _spontaneousMode = "active";
        _spontaneousTitleInput = string.Empty;
        _spontaneousSubtitleInput = string.Empty;
        _spontaneousNavMode = "host_controlled";
        _spontaneousIsHidden = false;
        _spontaneousIsScheduled = false;
        _spontaneousScheduledTimeInput = string.Empty;
        _spontaneousAutoStart = true;
        _spontaneousSlide = new EditableSlide(Guid.Empty, "announcement", 0, default);
        _modalError = null;
        _isSpontaneousModalOpen = true;
    }

    private void CloseSpontaneousModal() => _isSpontaneousModalOpen = false;

    private void OnSpontaneousTypeChanged(string? newType)
    {
        if (!string.IsNullOrEmpty(newType))
        {
            _spontaneousType = newType;
            _spontaneousSlide = new EditableSlide(Guid.Empty, _spontaneousType, 0, default);
        }
    }

    private async Task CreateSpontaneousEventWithEditorAsync()
    {
        _modalError = null;
        var (parameters, error) = _spontaneousSlide.BuildParameters();
        if (!string.IsNullOrEmpty(error))
        {
            _modalError = error;
            return;
        }

        DateTime? schedUtc = ParseTimeInput(_spontaneousIsScheduled, _spontaneousScheduledTimeInput);

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.CreateSpontaneousEventAsync(
                    token,
                    ProjectId,
                    _spontaneousType,
                    _spontaneousMode,
                    parameters,
                    _spontaneousTitleInput,
                    _spontaneousSubtitleInput,
                    _spontaneousNavMode,
                    _spontaneousIsHidden,
                    schedUtc,
                    _spontaneousAutoStart);
                _isSpontaneousModalOpen = false;
                await LoadDataAsync();
            });
        }
        catch (Exception ex)
        {
            _modalError = "Fehler beim Erstellen des Events: " + ex.Message;
        }
    }

    private static DateTime? ParseTimeInput(bool isScheduled, string timeInput)
    {
        if (!isScheduled || string.IsNullOrWhiteSpace(timeInput)) return null;

        var parts = timeInput.Trim().Split(':');
        if (parts.Length == 2 && int.TryParse(parts[0], out var hour) && int.TryParse(parts[1], out var minute))
        {
            var nowLocal = DateTime.Now;
            var targetLocal = new DateTime(nowLocal.Year, nowLocal.Month, nowLocal.Day, hour, minute, 0, DateTimeKind.Local);
            if (targetLocal < nowLocal) targetLocal = targetLocal.AddDays(1);
            return targetLocal.ToUniversalTime();
        }

        return null;
    }

    private static string GetSlideTitle(EventSlideState slide)
    {
        if (slide.Parameters.ValueKind == JsonValueKind.Object)
        {
            if (slide.Parameters.TryGetProperty("title", out var titleProp) && titleProp.ValueKind == JsonValueKind.String)
            {
                var val = titleProp.GetString();
                if (!string.IsNullOrWhiteSpace(val)) return val;
            }
            if (slide.Parameters.TryGetProperty("question", out var questionProp) && questionProp.ValueKind == JsonValueKind.String)
            {
                var val = questionProp.GetString();
                if (!string.IsNullOrWhiteSpace(val)) return val;
            }
        }

        return slide.Type.ToUpperInvariant();
    }

    private async Task ChangePointsAsync(TeamSummary team, int delta)
    {
        var newPoints = Math.Max(0, team.Points + delta);
        await RunAuthenticatedAsync(async token =>
        {
            await ProjectApiClient.UpdateTeamPointsAsync(token, ProjectId, team.Id, newPoints);
            await LoadDataAsync();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.SendAsync("LeaveProject", ProjectId);
                await _hubConnection.DisposeAsync();
            }
            catch
            {
            }
        }
    }

    private sealed record TabItem(
        string Id,
        string Title,
        string? StatusIcon,
        bool IsBeamerActive,
        EventState Event);
