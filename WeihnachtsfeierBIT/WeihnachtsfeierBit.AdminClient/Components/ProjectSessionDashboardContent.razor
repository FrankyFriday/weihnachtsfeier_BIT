    private async Task StartNewSessionAsync()
    {
        if (_processing) return;
        _processing = true;
        _actionError = null;
        _noticeMessage = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.StartGameInstanceAsync(token, ProjectId);
                _noticeMessage = "Play-Session wurde gestartet!";
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task EndSessionAsync()
    {
        if (_processing) return;
        _processing = true;
        _actionError = null;
        _noticeMessage = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.EndGameInstanceAsync(token, ProjectId);
                _noticeMessage = "Die Play-Session wurde beendet.";
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

