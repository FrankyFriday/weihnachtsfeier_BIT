    private string GetCanvasUrl() => Navigation.ToAbsoluteUri($"/play/canvas/{_instance!.AccessCode}").ToString();

    private void OpenLinkShowModal() => _isLinkShowModalOpen = true;
    private void CloseLinkShowModal() => _isLinkShowModalOpen = false;

    private async Task StartShowAndCloseModal(Guid showId)
    {
        CloseLinkShowModal();
        DateTime? schedUtc = ParseTimeInput(_showIsScheduled, _showScheduledTimeInput);

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.StartSessionShowAsync(token, ProjectId, showId, _showStartMode, _showTitleInput, _showSubtitleInput, _showNavMode, _showIsHidden, schedUtc, _showAutoStart);
                await LoadDataAsync();
            });
