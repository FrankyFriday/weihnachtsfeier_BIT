@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using WeihnachtsfeierBit.Framework
@using WeihnachtsfeierBit.AdminClient.Components.SlideEditors
@using WeihnachtsfeierBit.AdminClient.Models
@inherits AuthenticatedComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation

<FrameworkPage>
    @if (IsLoading)
    {
        <FrameworkLoading Message="Session-Dashboard wird geladen ..." />
    }
    else
    {
        <div class="overview-toolbar">
            <div>
                @if (_instance is not null)
                {
                    <PageHeading Eyebrow="LIVE PLAY-SESSION" Title="@($"Code: {_instance.AccessCode}")" Description="Play-Session ist aktiv! Teilnehmer können sich mit diesem Code anmelden." />
                }
                else
                {
                    <PageHeading Eyebrow="PLAY-SESSION" Title="Keine Session gestartet" Description="Starte eine Session, damit sich deine Teilnehmer per 6-stelligem Code anmelden können." />
                }
            </div>

            <div class="framework-button-row">
                @if (_instance is not null)
                {
                    <FrameworkButton Label="Session beenden" Variant="danger" OnClick="EndSessionAsync" Busy="@_processing" Disabled="@_processing" />
                }
                else
                {
                    <FrameworkButton Label="Session jetzt starten" Variant="primary" OnClick="StartNewSessionAsync" Busy="@_processing" Disabled="@_processing" />
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <FrameworkNotice Message="@ErrorMessage" Severity="error" />
        }
        @if (!string.IsNullOrEmpty(_noticeMessage))
        {
            <FrameworkNotice Message="@_noticeMessage" Severity="success" />
        }
        @if (!string.IsNullOrEmpty(_actionError))
        {
            <FrameworkNotice Message="@_actionError" Severity="error" />
        }

        @if (_instance is not null)
        {
            <!-- TABS BAR FOR RUNNING SHOWS & EVENTS -->
            <div style="display: flex; gap: 6px; border-bottom: 2px solid #dce5e2; padding-bottom: 12px; margin-bottom: 24px; align-items: center; overflow-x: auto; flex-wrap: wrap;">
                @foreach (var tab in _tabs)
                {
                    <button type="button" @onclick="() => SelectTab(tab.Id)" style="padding: 8px 16px; border-radius: 6px; border: 1.5px solid @(tab.Id == _selectedTabId ? "#197b67" : "#dce5e2"); background: @(tab.Id == _selectedTabId ? "#197b67" : "#fff"); color: @(tab.Id == _selectedTabId ? "#fff" : "#333"); font-weight: 700; cursor: pointer; white-space: nowrap; display: flex; gap: 8px; align-items: center;">
                        <span>@tab.Title</span>
                        <FrameworkBadge Text="@tab.BadgeText" Variant="@tab.BadgeVariant" />
                    </button>
                }

                <div style="margin-left: auto; display: flex; gap: 8px;">
                    <FrameworkButton Label="+ Show hinzufügen" Variant="secondary" OnClick="OpenLinkShowModal" />
                    <FrameworkButton Label="+ Spontan" Variant="primary" OnClick="OpenSpontaneousModal" />
                </div>
            </div>

            @if (_selectedTabItem is not null)
            {
                <Card Class="settings-card" Style="margin-bottom: 24px;">
                    <ChildContent>
                        @if (_selectedTabItem.IsShow)
                        {
                            var show = _selectedTabItem.Show!;
                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                                <div>
                                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 4px;">
                                        <h2>@show.ShowName</h2>
                                        <FrameworkBadge Text="@(show.Mode == "active" ? "Aktiv (Vordergrund)" : "Passiv (Menü)")" Variant="@(show.Mode == "active" ? "primary" : "secondary")" />
                                    </div>
                                    <p style="margin: 0; font-size: 14px; color: #657276;">Slide @(show.CurrentSlideIndex + 1) von @show.TotalSlides</p>
                                </div>
                                <div class="framework-button-row">
                                    <FrameworkButton Label="◄ Vorherige Slide" Variant="secondary" OnClick="() => StepShowSlide(show, -1)" Disabled="@(show.CurrentSlideIndex == 0)" />
                                    <FrameworkButton Label="Nächste Slide ►" Variant="primary" OnClick="() => StepShowSlide(show, 1)" Disabled="@(show.CurrentSlideIndex >= show.TotalSlides - 1)" />
                                    @if (show.Mode == "active")
                                    {
                                        <FrameworkButton Label="Zu Passiv" Variant="secondary" OnClick='() => ChangeShowMode(show, "passive")' />
                                    }
                                    else
                                    {
                                        <FrameworkButton Label="Zu Aktiv" Variant="secondary" OnClick='() => ChangeShowMode(show, "active")' />
                                    }
                                    <FrameworkButton Label="Show beenden" Variant="danger" OnClick="() => StopShowAsync(show.InstanceShowId)" />
                                </div>
                            </div>
                        }
                        else
                        {
                            var ev = _selectedTabItem.Event!;
                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                                <div>
                                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 4px;">
                                        <FrameworkBadge Text="@ev.SlideType.ToUpperInvariant()" Variant="@ev.SlideType" />
                                        <h2 style="margin: 0;">@ev.Title</h2>
                                        <FrameworkBadge Text="@(ev.Mode == "active" ? "Aktiv" : "Passiv")" Variant="@(ev.Mode == "active" ? "primary" : "secondary")" />
                                    </div>
                                    <p style="margin: 0; font-size: 13px; color: #657276;">Aktiv seit @ev.StartedAtUtc.ToLocalTime().ToString("HH:mm:ss") Uhr</p>
                                </div>
                                <div class="framework-button-row">
                                    @if (ev.Mode == "active")
                                    {
                                        <FrameworkButton Label="Zu Passiv" Variant="secondary" OnClick='() => ChangeEventMode(ev.EventId, "passive")' />
                                    }
                                    else
                                    {
                                        <FrameworkButton Label="Zu Aktiv" Variant="secondary" OnClick='() => ChangeEventMode(ev.EventId, "active")' />
                                    }
                                    <FrameworkButton Label="Event beenden" Variant="danger" OnClick="() => CloseEventAsync(ev.EventId)" />
                                </div>
                            </div>
                        }
                    </ChildContent>
                </Card>
            }
            else
            {
                <EmptyState Title="Keine laufenden Shows oder Events" Description="Klicke auf '+ Show hinzufügen' oder '+ Spontan', um Inhalte zu starten." />
            }
        }

        <h3>Team-Punktestände</h3>
        @if (_teams.Length == 0)
        {
            <EmptyState Title="Noch keine Teams angelegt" Description="Lege zuerst Teams im Projekt an." />
        }
        else
        {
            <div class="project-grid">
                @foreach (var team in _teams)
                {
                    <Card Class="project-card" Style="@($"border-top: 5px solid {team.Color};")" @key="team.Id">
                        <ChildContent>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                <h2 style="margin: 0;">@team.DisplayName</h2>
                                <span style="font-size: 24px; font-weight: 800; color: #105c4d;">@team.Points Pkt.</span>
                            </div>

                            <div style="display: flex; gap: 8px; align-items: center; margin-top: 12px;">
                                <FrameworkButton Label="-5" Variant="secondary" OnClick="() => ChangePointsAsync(team, -5)" />
                                <FrameworkButton Label="-1" Variant="secondary" OnClick="() => ChangePointsAsync(team, -1)" />
                                <input type="number" min="0" value="@team.Points" @onchange="(e) => OnPointsInputChangedAsync(team, e.Value?.ToString())" style="width: 80px; text-align: center; font-weight: 800; min-height: 42px; border-radius: 5px; border: 1px solid #cbd7d3;" />
                                <FrameworkButton Label="+1" Variant="primary" OnClick="() => ChangePointsAsync(team, 1)" />
                                <FrameworkButton Label="+5" Variant="primary" OnClick="() => ChangePointsAsync(team, 5)" />
                            </div>
                        </ChildContent>
                    </Card>
                }
            </div>
        }
    }
</FrameworkPage>

<!-- LINK SHOW MODAL -->
<FrameworkModal IsOpen="@_isLinkShowModalOpen" Title="Show in Session starten" OnClose="CloseLinkShowModal">
    <div>
        <p class="framework-help-text">Wähle eine verknüpfte Show aus, die gestartet werden soll:</p>
        @if (_projectShows.Length == 0)
        {
            <EmptyState Title="Keine Shows verknüpft" Description="Verknüpfe zuerst Shows mit diesem Projekt." />
        }
        else
        {
            <div style="display: grid; gap: 10px; margin-top: 12px;">
                @foreach (var show in _projectShows)
                {
                    <div style="padding: 12px 16px; border: 1px solid #dce5e2; border-radius: 6px; background: #fff; display: flex; justify-content: space-between; align-items: center;">
                        <strong>@show.Name</strong>
                        <div class="framework-button-row">
                            <FrameworkButton Label="Als Aktiv" Variant="primary" OnClick='() => StartShowAndCloseModal(show.Id, "active")' />
                            <FrameworkButton Label="Als Passiv" Variant="secondary" OnClick='() => StartShowAndCloseModal(show.Id, "passive")' />
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</FrameworkModal>

<!-- SPONTANES EVENT MODAL MIT SLIDE EDITOR -->
<FrameworkModal IsOpen="@_isSpontaneousModalOpen" Title="Spontanes Event erstellen" OnClose="CloseSpontaneousModal">
    <div class="modal-form">
        <FrameworkFormGroup Label="Event- bzw. Slide-Typ" ForId="modal-slide-type">
            <FrameworkSelect Id="modal-slide-type" Value="@_spontaneousType" ValueChanged="OnSpontaneousTypeChanged" Options="@_slideTypeOptions" />
        </FrameworkFormGroup>

        <FrameworkFormGroup Label="Modus" ForId="modal-mode" Style="margin-top: 12px;">
            <FrameworkSelect Id="modal-mode" Value="@_spontaneousMode" ValueChanged='v => _spontaneousMode = v ?? "active"' Options="@_modeOptions" />
        </FrameworkFormGroup>

        <FrameworkDivider />

        <div style="margin-top: 16px;">
            <FrameworkFormGroup Label="Interner Name / Titel" ForId="spontaneous-title">
                <FrameworkInputText Id="spontaneous-title" @bind-Value="_spontaneousSlide.InternalName" Placeholder="Titel eingeben..." />
            </FrameworkFormGroup>

            @switch (_spontaneousType)
            {
                case "announcement":
                    <AnnouncementSlideEditor Slide="_spontaneousSlide" />
                    break;
                case "poll":
                    <PollSlideEditor Slide="_spontaneousSlide" />
                    break;
                case "quiz":
                    <QuizSlideEditor Slide="_spontaneousSlide" />
                    break;
                case "ranking":
                    <RankingSlideEditor Slide="_spontaneousSlide" />
                    break;
                case "estimation":
                    <EstimationSlideEditor Slide="_spontaneousSlide" />
                    break;
                case "buzzer":
                    <BuzzerSlideEditor Slide="_spontaneousSlide" />
                    break;
            }
        </div>

        @if (!string.IsNullOrEmpty(_modalError))
        {
            <div style="margin-top: 16px;">
                <FrameworkNotice Message="@_modalError" Severity="error" />
            </div>
        }

        <div class="modal-footer-actions" style="margin-top: 24px;">
            <FrameworkButton Label="Abbrechen" Variant="secondary" OnClick="CloseSpontaneousModal" />
            <FrameworkButton Label="Event starten" Variant="primary" OnClick="CreateSpontaneousEventWithEditorAsync" Busy="@_processing" />
        </div>
    </div>
</FrameworkModal>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private GameInstanceSummary? _instance;
    private TeamState[] _teams = [];
    private ProjectShow[] _projectShows = [];
    private ActiveShowState[] _activeShows = [];
    private EventState? _activeEvent;
    private EventState[] _passiveEvents = [];

    private List<SessionTabViewModel> _tabs = [];
    private Guid? _selectedTabId;
    private SessionTabViewModel? _selectedTabItem => _tabs.FirstOrDefault(t => t.Id == _selectedTabId);

    private HubConnection? _hubConnection;
    private string? _noticeMessage;
    private string? _actionError;
    private bool _processing;

    private bool _isLinkShowModalOpen;
    private bool _isSpontaneousModalOpen;
    private string _spontaneousType = "announcement";
    private string _spontaneousMode = "active";
    private EditableSlide _spontaneousSlide = new(Guid.Empty, "announcement", 0, default);
    private string? _modalError;

    private static readonly FrameworkSelectOption[] _slideTypeOptions =
    [
        new("announcement", "Ankündigung"),
        new("poll", "Abstimmung"),
        new("quiz", "Quiz"),
        new("estimation", "Schätzfrage"),
        new("buzzer", "Buzzer"),
        new("ranking", "Rangliste")
    ];

    private static readonly FrameworkSelectOption[] _modeOptions =
    [
        new("active", "Aktiv (Vordergrund-Takeover)"),
        new("passive", "Passiv (Menüliste)")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ConnectSignalRAsync();
        await LoadDataAsync();
    }

    private void BuildTabs()
    {
        var prevSelected = _selectedTabId;
        _tabs.Clear();

        if (_activeEvent is not null)
        {
            _tabs.Add(new SessionTabViewModel(_activeEvent.EventId, _activeEvent.Title, "Aktiv", "primary", false, null, _activeEvent));
        }

        foreach (var show in _activeShows)
        {
            _tabs.Add(new SessionTabViewModel(show.InstanceShowId, show.ShowName, show.Mode == "active" ? "Show (Aktiv)" : "Show (Passiv)", show.Mode == "active" ? "primary" : "secondary", true, show, null));
        }

        foreach (var ev in _passiveEvents)
        {
            _tabs.Add(new SessionTabViewModel(ev.EventId, ev.Title, "Passiv", "secondary", false, null, ev));
        }

        if (_tabs.Count > 0)
        {
            if (prevSelected.HasValue && _tabs.Any(t => t.Id == prevSelected.Value))
            {
                _selectedTabId = prevSelected.Value;
            }
            else
            {
                _selectedTabId = _tabs[0].Id;
            }
        }
        else
        {
            _selectedTabId = null;
        }
    }

    private void SelectTab(Guid id) => _selectedTabId = id;

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/gamestate"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<ProjectGameState>("GameStateUpdated", (state) =>
            {
                InvokeAsync(() =>
                {
                    _teams = state.Teams.OrderByDescending(t => t.Points).ThenBy(t => t.DisplayName).ToArray();
                    _activeEvent = state.ActiveEvent;
                    _passiveEvents = state.PassiveEvents;
                    _activeShows = state.ActiveShows;
                    BuildTabs();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
            await _hubConnection.SendAsync("JoinProject", ProjectId);
        }
        catch
        {
        }
    }

    private async Task LoadDataAsync()
    {
        await LoadAuthenticatedAsync(async token =>
        {
            _actionError = null;
            var instanceTask = ProjectApiClient.GetActiveGameInstanceAsync(token, ProjectId);
            var showsTask = ProjectApiClient.GetShowsAsync(token, ProjectId);
            var stateTask = ProjectApiClient.GetSessionStateAsync(token, ProjectId);

            try
            {
                _instance = await instanceTask;
            }
            catch
            {
                _instance = null;
            }

            try
            {
                var state = await stateTask;
                _teams = state.Teams.OrderByDescending(t => t.Points).ThenBy(t => t.DisplayName).ToArray();
                _activeEvent = state.ActiveEvent;
                _passiveEvents = state.PassiveEvents;
                _activeShows = state.ActiveShows;
                BuildTabs();
            }
            catch
            {
                _teams = [];
                _activeEvent = null;
                _passiveEvents = [];
                _activeShows = [];
                _tabs.Clear();
            }

            _projectShows = await showsTask;
        });
    }

    private void OpenLinkShowModal() => _isLinkShowModalOpen = true;
    private void CloseLinkShowModal() => _isLinkShowModalOpen = false;

    private async Task StartShowAndCloseModal(Guid showId, string mode)
    {
        CloseLinkShowModal();
        await StartShowAsync(showId, mode);
    }

    private async Task StartShowAsync(Guid showId, string mode)
    {
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.StartSessionShowAsync(token, ProjectId, showId, mode);
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task StepShowSlide(ActiveShowState show, int direction)
    {
        var targetIndex = show.CurrentSlideIndex + direction;
        if (targetIndex < 0 || targetIndex >= show.TotalSlides) return;

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.UpdateSessionShowAsync(token, ProjectId, show.InstanceShowId, targetIndex, show.Mode);
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ChangeShowMode(ActiveShowState show, string newMode)
    {
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.UpdateSessionShowAsync(token, ProjectId, show.InstanceShowId, show.CurrentSlideIndex, newMode);
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task StopShowAsync(Guid instanceShowId)
    {
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.StopSessionShowAsync(token, ProjectId, instanceShowId);
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private void OpenSpontaneousModal()
    {
        _spontaneousType = "announcement";
        _spontaneousMode = "active";
        _spontaneousSlide = new EditableSlide(Guid.Empty, "announcement", 0, default);
        _modalError = null;
        _isSpontaneousModalOpen = true;
    }

    private void CloseSpontaneousModal() => _isSpontaneousModalOpen = false;

    private void OnSpontaneousTypeChanged(string? newType)
    {
        if (!string.IsNullOrEmpty(newType))
        {
            _spontaneousType = newType;
            _spontaneousSlide = new EditableSlide(Guid.Empty, _spontaneousType, 0, default);
        }
    }

    private async Task CreateSpontaneousEventWithEditorAsync()
    {
        _modalError = null;
        var (parameters, error) = _spontaneousSlide.BuildParameters();
        if (!string.IsNullOrEmpty(error))
        {
            _modalError = error;
            return;
        }

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.CreateSpontaneousEventAsync(token, ProjectId, _spontaneousType, _spontaneousMode, parameters);
                _isSpontaneousModalOpen = false;
                await LoadDataAsync();
            });
        }
        catch (Exception ex)
        {
            _modalError = "Fehler beim Erstellen des Events: " + ex.Message;
        }
    }

    private async Task ChangeEventMode(Guid eventId, string mode)
    {
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.UpdateEventModeAsync(token, ProjectId, eventId, mode);
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task CloseEventAsync(Guid eventId)
    {
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.CloseEventAsync(token, ProjectId, eventId);
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ChangePointsAsync(TeamState team, int delta)
    {
        var newPoints = Math.Max(0, team.Points + delta);
        await SetPointsAsync(team, newPoints);
    }

    private async Task OnPointsInputChangedAsync(TeamState team, string? input)
    {
        if (int.TryParse(input, out var points) && points >= 0)
        {
            await SetPointsAsync(team, points);
        }
    }

    private async Task SetPointsAsync(TeamState team, int points)
    {
        _actionError = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.UpdateTeamPointsAsync(token, ProjectId, team.Id, points);
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task StartNewSessionAsync()
    {
        if (_processing) return;
        _processing = true;
        _actionError = null;
        _noticeMessage = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.StartGameInstanceAsync(token, ProjectId);
                _noticeMessage = "Play-Session wurde gestartet!";
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task EndSessionAsync()
    {
        if (_processing) return;
        _processing = true;
        _actionError = null;
        _noticeMessage = null;
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.EndGameInstanceAsync(token, ProjectId);
                _noticeMessage = "Die Play-Session wurde beendet.";
                await LoadDataAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private sealed record SessionTabViewModel(
        Guid Id,
        string Title,
        string BadgeText,
        string BadgeVariant,
        bool IsShow,
        ActiveShowState? Show,
        EventState? Event);
}
