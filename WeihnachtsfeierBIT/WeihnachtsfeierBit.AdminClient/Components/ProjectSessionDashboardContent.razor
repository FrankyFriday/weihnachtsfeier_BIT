    private void OpenSpontaneousModal()
    {
        _spontaneousType = "announcement";
        _spontaneousMode = "active";
        _spontaneousNavMode = "host_controlled";
        _spontaneousIsHidden = false;
        _spontaneousIsScheduled = false;
        _spontaneousScheduledTimeInput = string.Empty;
        _spontaneousAutoStart = true;
        _spontaneousSlide = new EditableSlide(Guid.Empty, "announcement", 0, default);
        _modalError = null;
        _isSpontaneousModalOpen = true;
    }

    private void CloseSpontaneousModal() => _isSpontaneousModalOpen = false;

    private void OnSpontaneousTypeChanged(string? newType)
    {
        if (!string.IsNullOrEmpty(newType))
        {
            _spontaneousType = newType;
            _spontaneousSlide = new EditableSlide(Guid.Empty, _spontaneousType, 0, default);
        }
    }

    private async Task CreateSpontaneousEventWithEditorAsync()
    {
        _modalError = null;
        var (parameters, error) = _spontaneousSlide.BuildParameters();
        if (!string.IsNullOrEmpty(error))
        {
            _modalError = error;
            return;
        }

        DateTime? schedUtc = ParseTimeInput(_spontaneousIsScheduled, _spontaneousScheduledTimeInput);

        try
        {
            await RunAuthenticatedAsync(async token =>
            {
                await ProjectApiClient.CreateSpontaneousEventAsync(
                    token,
                    ProjectId,
                    _spontaneousType,
                    _spontaneousMode,
                    parameters,
                    _spontaneousNavMode,
                    _spontaneousIsHidden,
                    schedUtc,
                    _spontaneousAutoStart);
                _isSpontaneousModalOpen = false;
                await LoadDataAsync();
            });
        }
        catch (Exception ex)
        {
            _modalError = "Fehler beim Erstellen des Events: " + ex.Message;
        }
    }

    private static DateTime? ParseTimeInput(bool isScheduled, string timeInput)
    {
        if (!isScheduled || string.IsNullOrWhiteSpace(timeInput)) return null;

        var parts = timeInput.Trim().Split(':');
        if (parts.Length == 2 && int.TryParse(parts[0], out var hour) && int.TryParse(parts[1], out var minute))
        {
            var nowLocal = DateTime.Now;
            var targetLocal = new DateTime(nowLocal.Year, nowLocal.Month, nowLocal.Day, hour, minute, 0);
            if (targetLocal < nowLocal) targetLocal = targetLocal.AddDays(1); // If time has passed today, schedule for tomorrow
            return targetLocal.ToUniversalTime();
        }

        return null;
    }

