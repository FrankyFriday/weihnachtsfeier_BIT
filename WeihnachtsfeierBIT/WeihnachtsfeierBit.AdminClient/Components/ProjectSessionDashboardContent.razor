        }
        catch (HttpRequestException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task StartScheduledEventNow(EventState ev)
    {
        try
        {
            await RunAuthenticatedAsync(async token =>
            {
