<section class="auth-layout">
    <div class="auth-copy">
        <span class="eyebrow">ADMINISTRATION</span>
        <h1>@(Registration ? "Admin-Konto erstellen" : "Projektverwaltung")</h1>
        <p>@(Registration ? "Nach der Anmeldung kannst du Projekte anlegen und verwalten." : "Melde dich mit deinem Admin-Konto an.")</p>
    </div>
    <form class="auth-form" action="@(Registration ? "auth/register" : "auth/login")" method="post">
        <h2>@(Registration ? "Registrieren" : "Anmelden")</h2>
        @if (Error)
        {
            <p class="form-error" role="alert">@(Registration ? "Registrierung fehlgeschlagen. Prüfe deine Eingaben und versuche es erneut." : "Anmeldung fehlgeschlagen. Prüfe Benutzername und Passwort.")</p>
        }
        <label for="username">Admin-Benutzername</label>
        <input id="username" name="username" maxlength="64" autocomplete="username" required />
        <label for="password">Passwort</label>
        <input id="password" name="password" type="password" minlength="@(Registration ? 12 : 1)" autocomplete="@(Registration ? "new-password" : "current-password")" required />
        <button class="primary-button" type="submit">@(Registration ? "Admin-Konto erstellen" : "Anmelden")</button>
        <a class="auth-link" href="@(Registration ? "login" : "register")">@(Registration ? "Ich habe bereits ein Konto" : "Admin-Konto erstellen")</a>
    </form>
</section>

@code {
    [Parameter] public bool Registration { get; set; }
    [Parameter] public bool Error { get; set; }
}