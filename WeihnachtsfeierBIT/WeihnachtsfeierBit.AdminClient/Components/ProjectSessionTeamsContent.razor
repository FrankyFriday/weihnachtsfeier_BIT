@inherits AuthenticatedComponentBase

<FrameworkPage>
    <div class="overview-toolbar">
        <PageHeading Eyebrow="SESSION TEAMS" Title="Team-Punktestände" Description="Teams und aktuelle Punkte in dieser Spielsitzung." />
        <FrameworkButton Label="Session-Dashboard" OnClick="OpenDashboard" />
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" />
    }

    @if (IsLoading)
    {
        <FrameworkLoading Message="Session-Teams werden geladen ..." />
    }
    else if (_teams.Length == 0)
    {
        <EmptyState Title="Noch keine Teams in dieser Session" Description="In diesem Projekt wurden noch keine Teams angelegt." />
    }
    else
    {
        <StandardDataTable Items="_teams" Columns="_columns" KeySelector="TeamKey" />
    }
</FrameworkPage>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid InstanceId { get; set; }
    @inject NavigationManager Navigation

    private TeamInstanceSummary[] _teams = [];
    private DataTableColumn<TeamInstanceSummary>[] _columns = [];

    protected override async Task OnParametersSetAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        await LoadAuthenticatedAsync(async token =>
        {
            var detail = await ProjectApiClient.GetGameInstanceDetailAsync(token, ProjectId, InstanceId);
            var sessionParticipants = await ProjectApiClient.GetGameInstanceParticipantsAsync(token, ProjectId, InstanceId);

            _teams = detail.Teams.OrderByDescending(t => t.Points).ThenBy(t => t.DisplayName).ToArray();
            var participantCounts = sessionParticipants.Where(p => p.TeamId is not null)
                .GroupBy(p => p.TeamId!.Value)
                .ToDictionary(g => g.Key, g => g.Count());

            _columns =
            [
                new("Rang", t => (_teams.ToList().IndexOf(t) + 1).ToString()),
                new("Team", t => t.DisplayName),
                new("Farbe", t => @<span style="@($"display:inline-block;width:16px;height:16px;border-radius:50%;background-color:{t.Color};")"></span>),
                new("Teilnehmer in Session", t => participantCounts.GetValueOrDefault(t.TeamId).ToString()),
                new("Punkte", t => t.Points.ToString())
            ];
        });
    }

    private void OpenDashboard() => Navigation.NavigateTo($"{Navigation.BaseUri}projects/{ProjectId}/sessions/{InstanceId}/dashboard");

    private static object TeamKey(TeamInstanceSummary t) => t.TeamId;
}
