@using WeihnachtsfeierBit.Framework
@inherits AuthenticatedComponentBase

<FrameworkPage>
    <PageHeading Eyebrow="DJ-JUKEBOX & PARTY" Title="Musikwünsche & Playlist" Description="Live-Musikwünsche der Gäste sortiert nach Stimmen." />

    @if (IsLoading)
    {
        <FrameworkLoading Message="Musikwünsche werden geladen ..." />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" Severity="error" />
    }
    else
    {
        <FrameworkFlexRow Justify="space-between" Style="margin-bottom: 16px;">
            <span style="font-size: 14px; color: #64748b; font-weight: 600;">@_songWishes.Length eingereichte Songwünsche</span>
            <FrameworkButton Label="Aktualisieren" Variant="secondary" OnClick="LoadDataAsync" />
        </FrameworkFlexRow>

        @if (_songWishes.Length == 0)
        {
            <EmptyState Title="Keine Musikwünsche vorhanden" Description="Sobald Gäste auf der Feier Songwünsche abgeben, erscheinen sie hier live." />
        }
        else
        {
            <div style="display: grid; gap: 8px;">
                @foreach (var wish in _songWishes)
                {
                    <div style="padding: 12px 16px; border: 1.5px solid #dce5e2; border-radius: 12px; background: #ffffff; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                        <div style="display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1;">
                            <div style="width: 38px; height: 38px; border-radius: 8px; background: #e8f3ef; color: #105c4d; font-weight: 800; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; gap: 4px;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">thumb_up</span>
                                <span>@wish.Votes</span>
                            </div>
                            <div style="min-width: 0; flex: 1;">
                                <strong style="display: block; font-size: 15px; color: #1d2528; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@wish.SongTitle</strong>
                                <span style="font-size: 12px; color: #64748b; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(string.IsNullOrWhiteSpace(wish.Artist) ? "Unbekannter Künstler" : wish.Artist) &bull; Gewünscht von: @wish.SubmittedBy
                                </span>
                            </div>
                        </div>

                        <FrameworkButton Label="Löschen" Variant="secondary" OnClick="() => DeleteWishAsync(wish.Id)" />
                    </div>
                }
            </div>
        }
    }
</FrameworkPage>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private SongWishDto[] _songWishes = [];

    protected override async Task OnParametersSetAsync() => await LoadAuthenticatedAsync(async token =>
    {
        await LoadDataAsync();
    });

    private async Task LoadDataAsync()
    {
        await RunAuthenticatedAsync(async token =>
        {
            _songWishes = await ProjectApiClient.GetSongWishesAsync(token, ProjectId);
            StateHasChanged();
        });
    }

    private async Task DeleteWishAsync(Guid wishId)
    {
        await RunAuthenticatedAsync(async token =>
        {
            await ProjectApiClient.DeleteSongWishAsync(token, ProjectId, wishId);
            await LoadDataAsync();
        });
    }
}
