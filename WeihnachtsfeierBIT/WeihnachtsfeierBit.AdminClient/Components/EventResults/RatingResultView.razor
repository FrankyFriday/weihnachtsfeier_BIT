@using System.Text.Json
@using WeihnachtsfeierBit.Framework

<div style="margin-top: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3 style="margin: 0; font-size: 16px; color: #1d2528;">@_question</h3>
        <FrameworkBadge Text="@($"{_slideResponses.Count} Bewertungen")" Variant="primary" />
    </div>

    @if (_slideResponses.Count == 0)
    {
        <p style="color: #64748b; font-size: 13px;">Noch keine Sterne-Bewertungen für diese Folie vorhanden.</p>
    }
    else
    {
        double avg = _slideResponses.Average(r => ReadResponseValue(r.ResponseData));
        <div style="padding: 20px; background: #ffffff; border: 1.5px solid #dce5e2; border-radius: 12px; text-align: center;">
            <span class="mobile-eyebrow" style="font-size: 11px;">DURCHSCHNITTLICHE BEWERTUNG</span>
            <div style="font-size: 36px; font-weight: 800; color: #105c4d; margin: 4px 0; display: flex; align-items: center; justify-content: center; gap: 8px;">
                <span>⭐ @avg.ToString("0.0")</span>
                <span style="font-size: 18px; color: #64748b;">/ @_maxStars</span>
            </div>
        </div>

    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;

    private string _question => ReadString(CurrentSlide.Parameters, "question");
    private int _maxStars => ReadInt(CurrentSlide.Parameters, "maxStars", 5);

    private List<EventResponseState> _slideResponses => Event.Responses.Where(r => r.SlideId == CurrentSlide.SlideId).ToList();

    private static string ReadString(JsonElement el, string prop) =>
        el.ValueKind == JsonValueKind.Object && el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

    private static int ReadInt(JsonElement el, string prop, int def) =>
        el.ValueKind == JsonValueKind.Object && el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt32() : def;

    private static int ReadResponseValue(JsonElement el) =>
        el.ValueKind == JsonValueKind.Object && el.TryGetProperty("rating", out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt32() : 0;
}
