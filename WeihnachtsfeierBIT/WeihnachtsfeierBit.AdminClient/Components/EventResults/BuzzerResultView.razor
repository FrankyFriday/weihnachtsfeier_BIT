@using WeihnachtsfeierBit.Framework

<div style="margin-top: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3 style="margin: 0;">Buzzer-Reihenfolge (@TotalBuzzers Gebuzzert)</h3>
        <FrameworkBadge Text="@($"{TotalBuzzers} Buzzers")" Variant="danger" />
    </div>

    @if (TotalBuzzers == 0)
    {
        <p style="color: #657276; font-size: 14px;">Noch kein Teilnehmer hat gebuzzert.</p>
    }
    else
    {
        <div style="display: grid; gap: 8px; margin-top: 12px;">
            @for (int i = 0; i < RankedBuzzers.Count; i++)
            {
                var rank = i + 1;
                var item = RankedBuzzers[i];
                var isFirst = rank == 1;

                <div style="padding: 12px 16px; border: 1.5px solid @(isFirst ? "#dc2626" : "#dce5e2"); border-radius: 6px; background: @(isFirst ? "#fff5f5" : "#fff"); display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <span style="font-size: 18px; font-weight: 800; color: @(isFirst ? "#dc2626" : "#105c4d"); min-width: 30px;">#@rank</span>
                        <div>
                            <strong style="font-size: 16px; color: #1d2528;">#@item.ParticipantNumber @(string.IsNullOrWhiteSpace(item.ParticipantName) ? "" : $"({item.ParticipantName})")</strong>
                            @if (!string.IsNullOrEmpty(item.TeamName))
                            {
                                <span style="font-size: 13px; color: #657276; margin-left: 8px;">• Team @item.TeamName</span>
                            }
                        </div>
                    </div>
                    <div>
                        <span style="font-size: 13px; font-weight: 700; color: @(isFirst ? "#dc2626" : "#657276");">
                            @(isFirst ? "ERSTER BUZZER! 🚀" : $"+{item.TimeDeltaMs} ms")
                        </span>
                        <div style="font-size: 11px; color: #889698; text-align: right;">
                            @item.SubmittedAtUtc.ToLocalTime().ToString("HH:mm:ss.fff")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;

    private IEnumerable<EventResponseState> SlideResponses => Event.Responses.Where(r => r.SlideId == CurrentSlide.SlideId);
    private int TotalBuzzers => SlideResponses.Count();

    private List<BuzzerItem> RankedBuzzers
    {
        get {
            var ordered = SlideResponses.OrderBy(r => r.SubmittedAtUtc).ToList();
            if (ordered.Count == 0) return [];

            var firstTime = ordered[0].SubmittedAtUtc;
            return ordered.Select(r => new BuzzerItem(
                r.ParticipantNumber,
                r.ParticipantName,
                r.TeamName,
                r.SubmittedAtUtc,
                (long)(r.SubmittedAtUtc - firstTime).TotalMilliseconds)).ToList();
        }
    }

    private sealed record BuzzerItem(int ParticipantNumber, string? ParticipantName, string? TeamName, DateTime SubmittedAtUtc, long TimeDeltaMs);
}
