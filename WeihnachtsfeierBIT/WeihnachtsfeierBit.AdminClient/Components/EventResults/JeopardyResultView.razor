@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using WeihnachtsfeierBit.Framework
@inject ProjectApiClient ProjectApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="jp-board" style="margin-top: 16px; display: grid; gap: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; font-size: 16px; color: var(--ink);">@ReadString(CurrentSlide.Parameters, "title")</h3>
        <FrameworkBadge Text="Jeopardy" Variant="primary" />
    </div>

    <div class="jp-turn-picker">
        <strong>Welches Team ist an der Reihe?</strong>
        <span>Das Team wählt eine Kategorie und einen Punktewert von 100 (leicht) bis 500 (schwer) und beantwortet die Frage.</span>
        <div class="jp-team-options">
            @foreach (var team in _teams)
            {
                var selected = team;
                <button type="button"
                        class="jp-team-select @(_selectedTeamId == selected.Id ? "is-selected" : null)"
                        aria-pressed="@(_selectedTeamId == selected.Id)"
                        disabled="@(_busy || (_active is not null && SelectedTeam is not null))"
                        @onclick="() => SelectTeamAsync(selected)">
                    <span class="jp-team-dot" style="background-color: @selected.Color;"></span>
                    @selected.DisplayName
                </button>
            }
        </div>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: separate; border-spacing: 6px; table-layout: fixed;">
            <thead>
                <tr>
                    @foreach (var category in _categories)
                    {
                        <th class="jp-head" style="padding: 10px 6px; border-radius: 8px; font-size: 13px;">@category.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int r = 0; r < _rowCount; r++)
                {
                    var row = r;
                    <tr>
                        @for (int c = 0; c < _categories.Count; c++)
                        {
                            var col = c;
                            var key = $"{col}-{row}";
                            @if (row < _categories[col].Clues.Count)
                            {
                                var clue = _categories[col].Clues[row];
                                var isUsed = _used.Contains(key);
                                var isActive = _active == key;
                                <td style="padding: 0;">
                                    <button type="button" class="jp-cell-btn @(isActive ? "is-active" : null) @(isUsed ? "is-used" : null)" disabled="@(isUsed || _busy || SelectedTeam is null || _active is not null)" @onclick="() => SelectAsync(key)"
                                            style="width: 100%; min-height: 54px; border-radius: 8px; font-weight: 800; font-size: 18px; cursor: @(isUsed ? "default" : SelectedTeam is null || _active is not null ? "not-allowed" : "pointer");">
                                        @(isUsed ? "–" : clue.Value.ToString())
                                    </button>
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ActiveClue is { } active)
    {
        <div class="jp-clue" @key="@active.Question" style="padding: 16px; border-radius: 12px; display: grid; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong class="jp-clue-meta">@active.Category · @active.Value Punkte</strong>
                <FrameworkBadge Text="@(_revealed ? "Antwort aufgedeckt" : "Antwort verdeckt")" Variant="primary" />
            </div>
            <div class="jp-answering-team">Antwortendes Team: <strong>@(SelectedTeam?.DisplayName ?? "nicht ausgewählt")</strong></div>
            <div class="jp-clue-question" style="font-size: 20px; font-weight: 700;">@active.Question</div>
            <div class="jp-answer-panel" style="padding: 10px 12px; border-radius: 8px;">
                <span class="jp-answer-label" style="font-size: 12px;">Antwort (nur Spielleitung)</span><br />
                <strong class="jp-answer">@active.Answer</strong>
            </div>

            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <FrameworkButton Label="Antwort für alle aufdecken" Variant="secondary" OnClick="RevealAsync" Disabled="@(_revealed || _busy)" />
                <FrameworkButton Label="Frage abschließen" Variant="secondary" OnClick="CloseClueAsync" Disabled="_busy" />
            </div>

            <div class="jp-score-team">
                @if (SelectedTeam is { } answeringTeam)
                {
                    <span class="jp-team-dot" style="background-color: @answeringTeam.Color;"></span>
                    <strong>@answeringTeam.DisplayName <span style="color: var(--muted); font-weight: 500;">(@answeringTeam.Points)</span></strong>
                    <FrameworkButton Label="@($"Richtig +{active.Value}")" Variant="primary" OnClick="() => AwardAsync(answeringTeam, active.Value, true)" Disabled="_busy" />
                    <FrameworkButton Label="@($"Falsch −{active.Value}")" Variant="secondary" OnClick="() => AwardAsync(answeringTeam, -active.Value, false)" Disabled="_busy" />
                }
            </div>
        </div>
    }
    else
    {
        <FrameworkNotice Message="@(SelectedTeam is null ? "Wähle zuerst ein Team aus. Dieses Team sucht anschließend eine Kategorie und einen Punktewert aus." : "Das ausgewählte Team wählt jetzt ein Feld im Board. Die Frage erscheint dann auf dem Beamer und den Teilnehmer-Handys.")" Severity="info" />
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <FrameworkNotice Message="@_error" Severity="error" />
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public Guid ProjectId { get; set; }

    private sealed record ClueModel(int Value, string Question, string Answer);
    private sealed record CategoryModel(string Name, List<ClueModel> Clues);
    private sealed record ActiveClueModel(string Category, int Value, string Question, string Answer);

    private List<CategoryModel> _categories = [];
    private HashSet<string> _used = [];
    private string? _active;
    private bool _revealed;
    private Guid? _selectedTeamId;
    private TeamSummary[] _teams = [];
    private bool _busy;
    private string? _error;
    private int _rowCount => _categories.Count == 0 ? 0 : _categories.Max(category => category.Clues.Count);

    private ActiveClueModel? ActiveClue
    {
        get
        {
            if (_active is null) return null;
            var parts = _active.Split('-');
            if (parts.Length != 2 || !int.TryParse(parts[0], out var categoryIndex) || !int.TryParse(parts[1], out var clueIndex)) return null;
            if (categoryIndex < 0 || categoryIndex >= _categories.Count || clueIndex < 0 || clueIndex >= _categories[categoryIndex].Clues.Count) return null;
            var clue = _categories[categoryIndex].Clues[clueIndex];
            return new ActiveClueModel(_categories[categoryIndex].Name, clue.Value, clue.Question, clue.Answer);
        }
    }

    private TeamSummary? SelectedTeam => _selectedTeamId is Guid teamId
        ? _teams.FirstOrDefault(team => team.Id == teamId)
        : null;

    protected override async Task OnParametersSetAsync()
    {
        ReadParameters();
        _error = null;
        if (ProjectId == Guid.Empty)
        {
            _error = "Das Projekt für die Jeopardy-Punktevergabe fehlt.";
            return;
        }

        try
        {
            var token = await GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                _error = "Die Admin-Sitzung ist nicht verfügbar.";
                return;
            }

            _teams = await ProjectApiClient.GetTeamsAsync(token, ProjectId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ReadParameters()
    {
        _categories = [];
        var parameters = CurrentSlide.Parameters;
        if (parameters.ValueKind != JsonValueKind.Object) return;

        if (parameters.TryGetProperty("categories", out var categories) && categories.ValueKind == JsonValueKind.Array)
        {
            foreach (var category in categories.EnumerateArray())
            {
                var clues = new List<ClueModel>();
                if (category.ValueKind == JsonValueKind.Object
                    && category.TryGetProperty("clues", out var clueArray)
                    && clueArray.ValueKind == JsonValueKind.Array)
                {
                    clues.AddRange(clueArray.EnumerateArray().Select(clue =>
                        new ClueModel(ReadInt(clue, "value", 100), ReadString(clue, "question"), ReadString(clue, "answer"))));
                }

                _categories.Add(new CategoryModel(ReadString(category, "name"), clues));
            }
        }

        _used = [];
        _active = null;
        _revealed = false;
        _selectedTeamId = null;
        if (parameters.TryGetProperty("state", out var state) && state.ValueKind == JsonValueKind.Object)
        {
            if (state.TryGetProperty("used", out var used) && used.ValueKind == JsonValueKind.Array)
            {
                _used = used.EnumerateArray()
                    .Where(item => item.ValueKind == JsonValueKind.String)
                    .Select(item => item.GetString()!)
                    .ToHashSet(StringComparer.Ordinal);
            }

            _active = ReadString(state, "active") is { Length: > 0 } active ? active : null;
            _revealed = state.TryGetProperty("revealed", out var revealed) && revealed.ValueKind == JsonValueKind.True;
            _selectedTeamId = Guid.TryParse(ReadString(state, "selectedTeamId"), out var teamId) ? teamId : null;
        }
    }

    private Task SelectTeamAsync(TeamSummary team) =>
        _busy || (_active is not null && SelectedTeam is not null)
            ? Task.CompletedTask
            : SaveStateAsync(_used, _active, _revealed, team.Id, team.DisplayName);

    private Task SelectAsync(string key)
    {
        if (SelectedTeam is null || _active is not null) return Task.CompletedTask;
        return SaveStateAsync(_used, key, false, _selectedTeamId, SelectedTeam.DisplayName);
    }

    private Task RevealAsync() => SelectedTeam is { } team
        ? SaveStateAsync(_used, _active, true, team.Id, team.DisplayName)
        : Task.CompletedTask;

    private Task CloseClueAsync()
    {
        var used = new HashSet<string>(_used, StringComparer.Ordinal);
        if (_active is not null) used.Add(_active);
        return SaveStateAsync(used, null, false, null, null);
    }

    private async Task AwardAsync(TeamSummary team, int delta, bool correct)
    {
        var clue = ActiveClue;
        if (clue is null || _selectedTeamId != team.Id) return;

        await RunAsync(async token =>
        {
            await ProjectApiClient.AwardTeamPointsAsync(token, ProjectId, team.Id, delta, $"Jeopardy: {clue.Category} {clue.Value} ({(correct ? "richtig" : "falsch")})");
            _teams = await ProjectApiClient.GetTeamsAsync(token, ProjectId);
            var used = new HashSet<string>(_used, StringComparer.Ordinal);
            used.Add(_active!);
            await ProjectApiClient.SetSlideStateAsync(token, ProjectId, Event.EventId, CurrentSlide.SlideId, BuildState(used, null, false, null, null));
        });
    }

    private Task SaveStateAsync(HashSet<string> used, string? active, bool revealed, Guid? selectedTeamId, string? selectedTeamName) =>
        RunAsync(token => ProjectApiClient.SetSlideStateAsync(token, ProjectId, Event.EventId, CurrentSlide.SlideId, BuildState(used, active, revealed, selectedTeamId, selectedTeamName)));

    private static object BuildState(HashSet<string> used, string? active, bool revealed, Guid? selectedTeamId, string? selectedTeamName) =>
        new { used = used.OrderBy(item => item, StringComparer.Ordinal).ToArray(), active, revealed, selectedTeamId, selectedTeamName };

    private async Task RunAsync(Func<string, Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            var token = await GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                _error = "Die Admin-Sitzung ist nicht verfügbar.";
                return;
            }

            await action(token);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string> GetTokenAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return auth.User.FindFirst("api_access_token")?.Value ?? string.Empty;
    }

    private static string ReadString(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object
        && element.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;

    private static int ReadInt(JsonElement element, string property, int defaultValue) =>
        element.ValueKind == JsonValueKind.Object
        && element.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.Number
        && value.TryGetInt32(out var result)
            ? result
            : defaultValue;
}
