@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using WeihnachtsfeierBit.Framework
@inject ProjectApiClient ProjectApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="jp-board" style="margin-top: 16px; display: grid; gap: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; font-size: 16px; color: var(--ink);">@ReadString(CurrentSlide.Parameters, "title")</h3>
        <FrameworkBadge Text="Jeopardy Board" Variant="primary" />
    </div>

    <div class="jp-turn-picker">
        <strong>Welches Team ist an der Reihe?</strong>
        <span>Das Team wählt eine Kategorie und einen Punktewert aus. Klicke auf ein Feld, um zur zugeordneten Frage oder Sequenz zu springen. Bereits gespielte Felder können per Klick auf "↺ Freigeben" zurückgesetzt werden.</span>
        <div class="jp-team-options">
            @foreach (var team in _teams)
            {
                var selected = team;
                <button type="button"
                        class="jp-team-select @(_selectedTeamId == selected.Id ? "is-selected" : null)"
                        aria-pressed="@(_selectedTeamId == selected.Id)"
                        disabled="@_busy"
                        @onclick="() => SelectTeamAsync(selected)">
                    <span class="jp-team-dot" style="background-color: @selected.Color;"></span>
                    @selected.DisplayName
                </button>
            }
        </div>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: separate; border-spacing: 6px; table-layout: fixed;">
            <thead>
                <tr>
                    @foreach (var category in _categories)
                    {
                        <th class="jp-head" style="padding: 10px 6px; border-radius: 8px; font-size: 13px;">@category.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int r = 0; r < _rowCount; r++)
                {
                    var row = r;
                    <tr>
                        @for (int c = 0; c < _categories.Count; c++)
                        {
                            var col = c;
                            var key = $"{col}-{row}";
                            @if (row < _categories[col].Clues.Count)
                            {
                                var clue = _categories[col].Clues[row];
                                var isUsed = _used.Contains(key);
                                var hasTarget = clue.TargetSlideId.HasValue || clue.TargetSlideIds.Count > 0;
                                <td style="padding: 0;">
                                    @if (isUsed)
                                    {
                                        <button type="button" class="jp-cell-btn is-used" disabled="@_busy" @onclick="() => ResetCellAsync(key)"
                                                style="width: 100%; min-height: 54px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; color: var(--muted);"
                                                title="Feld freigeben / zurücksetzen">
                                            ↺ Freigeben
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="jp-cell-btn" disabled="@(_busy || SelectedTeam is null)" @onclick="() => SelectAsync(col, row)"
                                                style="width: 100%; min-height: 54px; border-radius: 8px; font-weight: 800; font-size: 18px; cursor: @(SelectedTeam is null ? "not-allowed" : "pointer");"
                                                title="@(hasTarget ? $"Wert: {clue.Value}" : "Keine Slide zugeordnet")">
                                            @clue.Value.ToString()
                                        </button>
                                    }
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <FrameworkNotice Message="@(SelectedTeam is null ? "Wähle zuerst ein Team aus. Dieses Team wählt anschließend eine Kategorie und einen Punktewert." : $"Team '{SelectedTeam.DisplayName}' hat gewählt. Klicke auf ein freies Feld im Board, um die verknüpfte(n) Slide(s) zu starten.")" Severity="info" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <FrameworkNotice Message="@_error" Severity="error" />
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public Guid ProjectId { get; set; }

    private sealed record ClueModel(int Value, Guid? TargetSlideId, List<Guid> TargetSlideIds);
    private sealed record CategoryModel(string Name, List<ClueModel> Clues);

    private List<CategoryModel> _categories = [];
    private HashSet<string> _used = [];
    private Guid? _selectedTeamId;
    private TeamSummary[] _teams = [];
    private bool _busy;
    private string? _error;
    private int _rowCount => _categories.Count == 0 ? 0 : _categories.Max(category => category.Clues.Count);

    private TeamSummary? SelectedTeam => _selectedTeamId is Guid teamId
        ? _teams.FirstOrDefault(team => team.Id == teamId)
        : null;

    protected override async Task OnParametersSetAsync()
    {
        ReadParameters();
        _error = null;
        if (ProjectId == Guid.Empty)
        {
            _error = "Das Projekt für die Jeopardy-Punktevergabe fehlt.";
            return;
        }

        try
        {
            var token = await GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                _error = "Die Admin-Sitzung ist nicht verfügbar.";
                return;
            }

            _teams = await ProjectApiClient.GetTeamsAsync(token, ProjectId);
            if (_selectedTeamId is null && Event.ActiveTeamId is Guid activeTid)
            {
                _selectedTeamId = activeTid;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ReadParameters()
    {
        _categories = [];
        var parameters = CurrentSlide.Parameters;
        if (parameters.ValueKind != JsonValueKind.Object) return;

        if (parameters.TryGetProperty("categories", out var categories) && categories.ValueKind == JsonValueKind.Array)
        {
            foreach (var category in categories.EnumerateArray())
            {
                var clues = new List<ClueModel>();
                if (category.ValueKind == JsonValueKind.Object
                    && category.TryGetProperty("clues", out var clueArray)
                    && clueArray.ValueKind == JsonValueKind.Array)
                {
                    clues.AddRange(clueArray.EnumerateArray().Select(clue =>
                    {
                        Guid? targetId = Guid.TryParse(ReadString(clue, "targetSlideId"), out var parsed) ? parsed : null;
                        var targetIds = new List<Guid>();
                        if (clue.TryGetProperty("targetSlideIds", out var idsArr) && idsArr.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var item in idsArr.EnumerateArray())
                            {
                                if (item.ValueKind == JsonValueKind.String && Guid.TryParse(item.GetString(), out var g))
                                {
                                    targetIds.Add(g);
                                }
                            }
                        }
                        return new ClueModel(ReadInt(clue, "value", 100), targetId, targetIds);
                    }));
                }

                _categories.Add(new CategoryModel(ReadString(category, "name"), clues));
            }
        }

        _used = [];
        _selectedTeamId = null;
        if (parameters.TryGetProperty("state", out var state) && state.ValueKind == JsonValueKind.Object)
        {
            if (state.TryGetProperty("used", out var used) && used.ValueKind == JsonValueKind.Array)
            {
                _used = used.EnumerateArray()
                    .Where(item => item.ValueKind == JsonValueKind.String)
                    .Select(item => item.GetString()!)
                    .ToHashSet(StringComparer.Ordinal);
            }

            _selectedTeamId = Guid.TryParse(ReadString(state, "selectedTeamId"), out var teamId) ? teamId : null;
        }
    }

    private Task SelectTeamAsync(TeamSummary team)
    {
        _selectedTeamId = team.Id;
        return SaveStateAsync(_used, _selectedTeamId, team.DisplayName);
    }

    private async Task ResetCellAsync(string key)
    {
        var used = new HashSet<string>(_used, StringComparer.Ordinal);
        used.Remove(key);
        _used = used;
        await SaveStateAsync(_used, _selectedTeamId, SelectedTeam?.DisplayName);
    }

    private async Task SelectAsync(int col, int row)
    {
        if (SelectedTeam is null) return;
        if (col < 0 || col >= _categories.Count || row < 0 || row >= _categories[col].Clues.Count) return;

        var clue = _categories[col].Clues[row];
        var targetIds = clue.TargetSlideIds.Count > 0 ? clue.TargetSlideIds : (clue.TargetSlideId.HasValue ? new List<Guid> { clue.TargetSlideId.Value } : new List<Guid>());
        if (targetIds.Count == 0)
        {
            _error = "Dieses Jeopardy-Feld hat keine zugeordneten Slides in dieser Show.";
            return;
        }

        var firstSlide = Event.Slides.FirstOrDefault(s => s.SlideId == targetIds[0]);
        var lastSlide = Event.Slides.FirstOrDefault(s => s.SlideId == targetIds[^1]);
        if (firstSlide is null || lastSlide is null)
        {
            _error = "Die zugeordneten Slides wurden in dieser Show nicht gefunden.";
            return;
        }

        var startIndex = Array.IndexOf(Event.Slides, firstSlide);
        var endIndex = Array.IndexOf(Event.Slides, lastSlide);
        var originIndex = Array.IndexOf(Event.Slides, CurrentSlide);
        var key = $"{col}-{row}";

        await RunAsync(async token =>
        {
            var used = new HashSet<string>(_used, StringComparer.Ordinal);
            var stateObj = new
            {
                used = used.ToArray(),
                active = key,
                selectedTeamId = SelectedTeam.Id.ToString(),
                selectedTeamName = SelectedTeam.DisplayName,
                navigationContext = new
                {
                    originSlideIndex = originIndex >= 0 ? originIndex : 0,
                    sequenceEndSlideIndex = endIndex >= 0 ? endIndex : startIndex,
                    activeCellKey = key
                }
            };

            await ProjectApiClient.SetSlideStateAsync(token, ProjectId, Event.EventId, CurrentSlide.SlideId, stateObj);
            await ProjectApiClient.UpdateEventAsync(token, ProjectId, Event.EventId, currentSlideIndex: startIndex);
        });
    }

    private Task SaveStateAsync(HashSet<string> used, Guid? selectedTeamId, string? selectedTeamName) =>
        RunAsync(token => ProjectApiClient.SetSlideStateAsync(token, ProjectId, Event.EventId, CurrentSlide.SlideId, new
        {
            used = used.ToArray(),
            active = (string?)null,
            selectedTeamId = selectedTeamId.HasValue ? selectedTeamId.Value.ToString() : null,
            selectedTeamName,
            navigationContext = (object?)null
        }));

    private async Task RunAsync(Func<string, Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            var token = await GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                _error = "Die Admin-Sitzung ist nicht verfügbar.";
                return;
            }

            await action(token);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string> GetTokenAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return auth.User.FindFirst("api_access_token")?.Value ?? string.Empty;
    }

    private static string ReadString(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object
        && element.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;

    private static int ReadInt(JsonElement element, string property, int defaultValue) =>
        element.ValueKind == JsonValueKind.Object
        && element.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.Number
        && value.TryGetInt32(out var result)
            ? result
            : defaultValue;
}
