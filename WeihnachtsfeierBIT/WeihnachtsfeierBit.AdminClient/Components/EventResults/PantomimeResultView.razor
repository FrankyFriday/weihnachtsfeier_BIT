@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using WeihnachtsfeierBit.Framework
@inject ProjectApiClient ProjectApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

<div style="margin-top: 16px; padding: 20px; background: #f8faf9; border: 1px solid #dce5e2; border-radius: 12px;">
    @if (_isLoading)
    {
        <FrameworkLoading Message="Pantomime wird geladen ..." />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <FrameworkNotice Message="@_error" Severity="error" />
    }
    else if (_data is not null)
    {
        <div style="display: flex; justify-content: space-between; gap: 12px; align-items: center; flex-wrap: wrap;">
            <div>
                <span class="mobile-eyebrow">PANTOMIME · @_data.Category</span>
                <div style="font-size: 13px; color: #64748b;">@_data.TermCount eindeutige Begriffe im Pool · @_roundDurationSeconds Sekunden</div>
            </div>
            <div style="font: 800 36px/1 monospace; color: @(_remainingSeconds == 0 ? "#991b1b" : "#105c4d");">
                @FormatSeconds(_remainingSeconds)
            </div>
        </div>

        @if (_isRunning || _isPaused || _isEnded)
        {
            <div style="display: grid; gap: 8px; margin: 20px 0;">
                @foreach (var team in _teams)
                {
                    var state = GetTeamState(team.Id);
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 14px; background: white; border: 1px solid #dce5e2; border-radius: 10px;">
                        <div>
                            <strong>@team.DisplayName</strong>
                            <div style="font-size: 13px; color: #64748b;">@ReadString(state, "performerName")</div>
                        </div>
                        <strong>@ReadInt(state, "correctCount") erraten</strong>
                    </div>
                }
            </div>

            @if (_isPaused)
            {
                <FrameworkNotice Message="Die gemeinsame Runde ist pausiert." Severity="info" />
            }
            else if (_isEnded)
            {
                <FrameworkNotice Message="Die Runde ist beendet. Die angezeigte Anzahl erratener Begriffe ist der Endstand." Severity="success" />
            }
            else if (ReadInt(_state, "termsRemaining") == 0)
            {
                <FrameworkNotice Message="Alle Begriffe wurden bereits ausgegeben. Die Teams spielen bis zum Ende des gemeinsamen Timers weiter." Severity="info" />
            }
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                @if (_isRunning)
                {
                    <FrameworkButton Label="Gemeinsam pausieren" Variant="secondary" OnClick='() => RunActionAsync("pause")' Disabled="@_isBusy" />
                }
                else if (_isPaused)
                {
                    <FrameworkButton Label="Gemeinsam fortsetzen" Variant="primary" OnClick='() => RunActionAsync("resume")' Disabled="@_isBusy" />
                }
                @if (!_isEnded)
                {
                    <FrameworkButton Label="Runde beenden" Variant="danger" OnClick='() => RunActionAsync("end")' Disabled="@_isBusy" />
                }
            </div>
        }
        else
        {
            <div style="display: grid; gap: 10px; margin: 20px 0;">
                @foreach (var team in _teams)
                {
                    <label style="display: grid; grid-template-columns: minmax(100px, 1fr) minmax(180px, 2fr); gap: 12px; align-items: center;">
                        <strong>@team.DisplayName</strong>
                        <select class="form-select" value="@GetSelectedPerformer(team.Id)" @onchange="args => SetSelectedPerformer(team.Id, args)" disabled="@_isBusy">
                            <option value="">Darstellende Person auswählen</option>
                            @foreach (var participant in TeamParticipants(team.Id))
                            {
                                <option value="@participant.Id">@(string.IsNullOrWhiteSpace(participant.Name) ? $"Person {participant.Number}" : participant.Name)</option>
                            }
                        </select>
                    </label>
                }
                <label style="display: flex; gap: 12px; align-items: center;">
                    <strong>Gemeinsame Rundendauer</strong>
                    <FrameworkInputNumber Id="pantomime-round-duration" @bind-Value="_roundDurationSeconds" Min="10" Max="600" />
                    <span>Sekunden</span>
                </label>
            </div>
            <FrameworkButton Label="Alle Teams gleichzeitig starten" Variant="primary" OnClick="StartRoundAsync" Disabled="@(_isBusy || !_allPerformersSelected || _roundDurationSeconds is < 10 or > 600 || _data.TermCount == 0)" />
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div style="margin-top: 12px;"><FrameworkNotice Message="@_error" Severity="error" /></div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public Guid ProjectId { get; set; }

    private PantomimeAdminData? _data;
    private TeamSummary[] _teams = [];
    private ParticipantSummary[] _participants = [];
    private readonly Dictionary<Guid, Guid> _selectedPerformers = [];
    private JsonElement _state;
    private Guid _loadedEventId;
    private Guid _loadedSlideId;
    private string? _accessToken;
    private string? _error;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _endingExpiredRound;
    private int _roundDurationSeconds = 60;
    private int _remainingSeconds;
    private CancellationTokenSource? _timerCancellation;
    private Task? _timerTask;

    private bool _isRunning => ReadBool(_state, "isRunning");
    private bool _isPaused => ReadBool(_state, "isPaused");
    private bool _isEnded => ReadBool(_state, "isEnded");
    private bool _allPerformersSelected => _teams.Length > 0
        && _teams.All(team => _selectedPerformers.ContainsKey(team.Id)
            && _participants.Any(participant => participant.Id == _selectedPerformers[team.Id] && participant.TeamId == team.Id));

    protected override async Task OnParametersSetAsync()
    {
        ReadLiveState();
        if (_loadedEventId == Event.EventId && _loadedSlideId == CurrentSlide.SlideId)
        {
            UpdateRemaining();
            return;
        }

        _loadedEventId = Event.EventId;
        _loadedSlideId = CurrentSlide.SlideId;
        _isLoading = true;
        _error = null;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _accessToken = auth.User.FindFirst("api_access_token")?.Value;
            if (string.IsNullOrWhiteSpace(_accessToken))
            {
                throw new InvalidOperationException("Die Admin-Sitzung ist nicht verfügbar.");
            }

            var dataTask = ProjectApiClient.GetPantomimeAsync(_accessToken, ProjectId, Event.EventId, CurrentSlide.SlideId);
            var teamsTask = ProjectApiClient.GetTeamsAsync(_accessToken, ProjectId);
            var participantsTask = ProjectApiClient.GetParticipantsAsync(_accessToken, ProjectId);
            await Task.WhenAll(dataTask, teamsTask, participantsTask);
            _data = await dataTask;
            _teams = await teamsTask;
            _participants = await participantsTask;
            _roundDurationSeconds = _data.RoundDurationSeconds;
            if (_state.ValueKind == JsonValueKind.Undefined)
            {
                _state = _data.State;
            }

            RestoreAssignments(_state);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
        UpdateRemaining();
    }

    protected override void OnInitialized()
    {
        _timerCancellation = new CancellationTokenSource();
        _timerTask = UpdateTimerAsync(_timerCancellation.Token);
    }

    private async Task StartRoundAsync()
    {
        if (!_allPerformersSelected || _data is null)
        {
            _error = "Wähle für jedes Team eine darstellende Person aus.";
            return;
        }

        var assignments = _teams
            .Select(team => new PantomimeAssignment(team.Id, _selectedPerformers[team.Id]))
            .ToArray();
        await RunActionAsync("start", assignments);
    }

    private async Task RunActionAsync(string action, PantomimeAssignment[]? assignments = null)
    {
        if (_isBusy || string.IsNullOrWhiteSpace(_accessToken))
        {
            return;
        }

        _isBusy = true;
        _error = null;
        try
        {
            await ProjectApiClient.UpdatePantomimeAsync(
                _accessToken,
                ProjectId,
                Event.EventId,
                CurrentSlide.SlideId,
                action,
                assignments,
                _roundDurationSeconds);
            _data = await ProjectApiClient.GetPantomimeAsync(_accessToken, ProjectId, Event.EventId, CurrentSlide.SlideId);
            _state = _data.State;
            RestoreAssignments(_state);
            UpdateRemaining();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task UpdateTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                UpdateRemaining();
                if (_isRunning && _remainingSeconds == 0 && !_endingExpiredRound)
                {
                    _endingExpiredRound = true;
                    await RunActionAsync("end");
                    _endingExpiredRound = false;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ReadLiveState()
    {
        if (CurrentSlide.Parameters.ValueKind == JsonValueKind.Object
            && CurrentSlide.Parameters.TryGetProperty("state", out var state)
            && state.ValueKind == JsonValueKind.Object)
        {
            _state = state;
        }
    }

    private void RestoreAssignments(JsonElement state)
    {
        if (state.ValueKind != JsonValueKind.Object
            || !state.TryGetProperty("teamStates", out var teamStates)
            || teamStates.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        foreach (var teamState in teamStates.EnumerateArray())
        {
            var teamId = ReadGuid(teamState, "teamId");
            var performerId = ReadGuid(teamState, "performerId");
            if (teamId.HasValue && performerId.HasValue)
            {
                _selectedPerformers[teamId.Value] = performerId.Value;
            }
        }
    }

    private IEnumerable<ParticipantSummary> TeamParticipants(Guid teamId) =>
        _participants.Where(participant => participant.TeamId == teamId);

    private string GetSelectedPerformer(Guid teamId) =>
        _selectedPerformers.TryGetValue(teamId, out var participantId) ? participantId.ToString() : string.Empty;

    private void SetSelectedPerformer(Guid teamId, ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var participantId)
            && _participants.Any(participant => participant.Id == participantId && participant.TeamId == teamId))
        {
            _selectedPerformers[teamId] = participantId;
        }
        else
        {
            _selectedPerformers.Remove(teamId);
        }
    }

    private JsonElement GetTeamState(Guid teamId)
    {
        if (_state.ValueKind == JsonValueKind.Object
            && _state.TryGetProperty("teamStates", out var teamStates)
            && teamStates.ValueKind == JsonValueKind.Array)
        {
            foreach (var teamState in teamStates.EnumerateArray())
            {
                if (ReadGuid(teamState, "teamId") == teamId)
                {
                    return teamState;
                }
            }
        }

        return default;
    }

    private void UpdateRemaining()
    {
        if (_isRunning && ReadDateTime(_state, "deadlineUtc") is DateTime deadline)
        {
            _remainingSeconds = Math.Max(0, (int)Math.Ceiling((deadline - DateTime.UtcNow).TotalSeconds));
        }
        else
        {
            _remainingSeconds = Math.Max(0, ReadInt(_state, "remainingSeconds"));
        }
    }

    private static string ReadString(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;

    private static bool ReadBool(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.True;

    private static int ReadInt(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var result)
            ? result
            : 0;

    private static Guid? ReadGuid(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            && Guid.TryParse(value.GetString(), out var result) ? result : null;

    private static DateTime? ReadDateTime(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            && value.TryGetDateTime(out var result) ? result : null;

    private static string FormatSeconds(int seconds) => TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss");

    public async ValueTask DisposeAsync()
    {
        _timerCancellation?.Cancel();
        if (_timerTask is not null)
        {
            await _timerTask;
        }
        _timerCancellation?.Dispose();
    }
}
