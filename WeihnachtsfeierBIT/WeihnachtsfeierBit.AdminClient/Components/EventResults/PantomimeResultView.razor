@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using WeihnachtsfeierBit.Framework
@inject ProjectApiClient ProjectApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

<div style="@(_focusedTeamId.HasValue
    ? "position: fixed; inset: 0; z-index: 1200; margin: 0; padding: 16px; overflow-y: auto; overscroll-behavior: contain; background: #f8faf9; border-radius: 0;"
    : "margin-top: 16px; padding: 20px; background: #f8faf9; border: 1px solid #dce5e2; border-radius: 12px;")">
    @if (_isLoading)
    {
        <FrameworkLoading Message="Pantomime wird geladen ..." />
    }
    else if (_data is not null)
    {
        <div style="display: flex; justify-content: space-between; gap: 12px; align-items: center; flex-wrap: wrap;">
            <div>
                <span class="mobile-eyebrow">PANTOMIME · @_data.Category</span>
                <div style="font-size: 13px; color: #64748b;">@_data.TermCount eindeutige Begriffe im Pool · @_roundDurationSeconds Sekunden</div>
                @if (_focusedTeam is not null)
                {
                    <strong style="display: block; margin-top: 8px; font-size: 20px;">Teamansicht · @_focusedTeam.DisplayName</strong>
                }
            </div>
            @if (_focusedTeamId.HasValue)
            {
                <div style="font: 900 clamp(52px, 18vw, 92px)/1 monospace; color: @(_remainingSeconds == 0 ? "#991b1b" : "#105c4d");">
                    @FormatSeconds(_remainingSeconds)
                </div>
            }
            else
            {
                <div style="font: 800 36px/1 monospace; color: @(_remainingSeconds == 0 ? "#991b1b" : "#105c4d");">
                    @FormatSeconds(_remainingSeconds)
                </div>
            }
        </div>

        @if (!_showRoundSetup)
        {
            @if (_focusedTeam is not null && _focusedTeamData is not null)
            {
                <div style="display: grid; gap: 16px; max-width: 720px; margin: 20px auto;">
                    <FrameworkButton Label="Zur Teamübersicht" Icon="arrow_back" Variant="secondary" OnClick="ExitFocusedTeam" Style="min-height: 48px;" />
                    <div style="padding: clamp(20px, 6vw, 36px); text-align: center; background: white; border: 2px solid #105c4d; border-radius: 18px; box-shadow: 0 8px 24px rgba(16, 92, 77, .12);">
                        <div style="font-size: 13px; font-weight: 800; letter-spacing: .08em; color: #64748b; text-transform: uppercase;">@_focusedTeam.DisplayName · Aktueller Begriff</div>
                        @if (!string.IsNullOrWhiteSpace(_focusedTeamData.Term))
                        {
                            <div style="margin-top: 14px; font-size: clamp(36px, 12vw, 72px); font-weight: 900; line-height: 1.08; color: #1d2528; overflow-wrap: anywhere;">@_focusedTeamData.Term</div>
                        }
                        else
                        {
                            <div style="margin-top: 14px; font-size: 18px; font-weight: 700; color: #64748b;">Kein weiterer Begriff verfügbar</div>
                        }
                        <div style="margin-top: 16px; color: #475569;">
                            Darstellende Person: <strong>@_focusedTeamData.PerformerName</strong>
                            <span aria-hidden="true"> · </span>
                            Erraten: <strong>@_focusedTeamData.CorrectCount</strong>
                            <span aria-hidden="true"> · </span>
                            Übersprünge übrig: <strong>@_focusedTeamData.SkipsRemaining</strong>
                        </div>
                    </div>

                    @if (_isPaused)
                    {
                        <FrameworkNotice Message="Die gemeinsame Runde ist pausiert. In der Teamansicht sind deshalb keine Spielaktionen möglich." Severity="info" />
                    }
                    else if (_isEnded)
                    {
                        <FrameworkNotice Message="Die Runde ist beendet." Severity="success" />
                    }
                    else if (!string.IsNullOrWhiteSpace(_focusedTeamData.Term))
                    {
                        <div style="display: grid; gap: 10px;">
                            <FrameworkButton
                                Label="Als erraten markieren"
                                Variant="primary"
                                OnClick='() => RunActionAsync("correct", teamId: _focusedTeam.Id, expectedTermIndex: _focusedTeamData.CurrentTermIndex)'
                                Disabled="@_isBusy"
                                Style="width: 100%; min-height: 58px; font-size: 18px;" />
                            <FrameworkButton
                                Label="@GetSkipLabel(_focusedTeamData)"
                                Variant="secondary"
                                OnClick='() => RunActionAsync("skip", teamId: _focusedTeam.Id, expectedTermIndex: _focusedTeamData.CurrentTermIndex)'
                                Disabled="@IsSkipDisabled(_focusedTeamData)"
                                Style="width: 100%; min-height: 58px; font-size: 18px;" />
                            <FrameworkButton
                                Label="Gratis überspringen"
                                Variant="danger"
                                OnClick="() => RequestFreeSkip(_focusedTeam.Id)"
                                Disabled="@_isBusy"
                                Style="width: 100%; min-height: 58px; font-size: 18px;" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="display: grid; gap: 8px; margin: 20px 0;">
                    @foreach (var team in _teams)
                    {
                        var state = GetTeamState(team.Id);
                        var moderatorData = GetModeratorTeamData(team.Id);
                        <div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 12px 14px; background: white; border: 1px solid #dce5e2; border-radius: 10px;">
                            <div style="min-width: 0;">
                                <strong>@team.DisplayName</strong>
                                <div style="font-size: 13px; color: #64748b;">@ReadString(state, "performerName") · @ReadInt(state, "correctCount") erraten · @(moderatorData?.SkipsRemaining ?? 0) Skips übrig</div>
                                @if (!string.IsNullOrWhiteSpace(moderatorData?.Term))
                                {
                                    <div style="margin-top: 6px; overflow-wrap: anywhere;">
                                        <span style="font-size: 12px; color: #64748b;">Aktueller Begriff: </span><strong>@moderatorData.Term</strong>
                                    </div>
                                }
                                else
                                {
                                    <div style="margin-top: 6px; font-size: 13px; color: #64748b;">Kein aktueller Begriff</div>
                                }
                            </div>
                            @if (_isRunning && !string.IsNullOrWhiteSpace(moderatorData?.Term))
                            {
                                <FrameworkButton Label="Handyansicht" Icon="smartphone" Variant="secondary" OnClick="() => EnterFocusedTeam(team.Id)" Style="min-height: 48px;" />
                            }
                            <div style="grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px;">
                                @if (_isRunning && !string.IsNullOrWhiteSpace(moderatorData?.Term))
                                {
                                    <FrameworkButton
                                        Label="Erraten markieren"
                                        Variant="primary"
                                        OnClick='() => RunActionAsync("correct", teamId: team.Id, expectedTermIndex: moderatorData?.CurrentTermIndex)'
                                        Disabled="@_isBusy" />
                                    <FrameworkButton
                                        Label="@GetSkipLabel(moderatorData)"
                                        Variant="secondary"
                                        OnClick='() => RunActionAsync("skip", teamId: team.Id, expectedTermIndex: moderatorData?.CurrentTermIndex)'
                                        Disabled="@IsSkipDisabled(moderatorData)" />
                                    <FrameworkButton Label="Gratis überspringen" Variant="danger" OnClick="() => RequestFreeSkip(team.Id)" Disabled="@_isBusy" />
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (_isPaused)
                {
                    <FrameworkNotice Message="Die gemeinsame Runde ist pausiert." Severity="info" />
                }
                else if (_isEnded)
                {
                    <FrameworkNotice Message="Die Runde ist beendet. Die angezeigte Anzahl erratener Begriffe ist der Endstand." Severity="success" />
                }
                else if (ReadInt(_state, "termsRemaining") == 0)
                {
                    <FrameworkNotice Message="Alle Begriffe wurden bereits ausgegeben. Die Teams spielen bis zum Ende des gemeinsamen Timers weiter." Severity="info" />
                }
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    @if (_isRunning)
                    {
                        <FrameworkButton Label="Gemeinsam pausieren" Variant="secondary" OnClick='() => RunActionAsync("pause")' Disabled="@_isBusy" />
                    }
                    else if (_isPaused)
                    {
                        <FrameworkButton Label="Gemeinsam fortsetzen" Variant="primary" OnClick='() => RunActionAsync("resume")' Disabled="@_isBusy" />
                    }
                    @if (!_isEnded)
                    {
                        <FrameworkButton Label="Runde beenden" Variant="danger" OnClick='() => RunActionAsync("end")' Disabled="@_isBusy" />
                    }
                    else
                    {
                        <FrameworkButton Label="Nächste Runde vorbereiten" Icon="replay" Variant="primary" OnClick="PrepareNextRoundAsync" Disabled="@_isBusy" />
                    }
                </div>
            }
        }
        else
        {
            @if (_isEnded)
            {
                <div style="margin-top: 16px;">
                    <FrameworkNotice Message="Nächste Runde: Wähle pro Team die darstellende Person aus. Der Endstand der vorherigen Runde wird beim Start ersetzt und die Begriffe werden neu gemischt." Severity="info" />
                </div>
            }
            <div style="display: grid; gap: 10px; margin: 20px 0;">
                @foreach (var team in _teams)
                {
                    <label style="display: grid; grid-template-columns: minmax(100px, 1fr) minmax(180px, 2fr); gap: 12px; align-items: center;">
                        <strong>@team.DisplayName</strong>
                        <select class="form-select" value="@GetSelectedPerformer(team.Id)" @onchange="args => SetSelectedPerformer(team.Id, args)" disabled="@_isBusy">
                            <option value="">Darstellende Person auswählen</option>
                            @foreach (var participant in TeamParticipants(team.Id))
                            {
                                <option value="@participant.Id">@(string.IsNullOrWhiteSpace(participant.Name) ? $"Person {participant.Number}" : participant.Name)</option>
                            }
                        </select>
                    </label>
                }
                <label style="display: flex; gap: 12px; align-items: center;">
                    <strong>Gemeinsame Rundendauer</strong>
                    <FrameworkInputNumber Id="pantomime-round-duration" @bind-Value="_roundDurationSeconds" Min="10" Max="600" />
                    <span>Sekunden</span>
                </label>
                <div style="font-size: 13px; color: #64748b;">
                    Pro darstellender Person können @(_data.MaxSkipsPerPerformer) Begriffe übersprungen werden.
                </div>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <FrameworkButton Label="Alle Teams gleichzeitig starten" Variant="primary" OnClick="StartRoundAsync" Disabled="@(_isBusy || !_allPerformersSelected || _roundDurationSeconds is < 10 or > 600 || _data.TermCount == 0)" />
                @if (_isEnded)
                {
                    <FrameworkButton Label="Zurück zum Endstand" Icon="arrow_back" Variant="secondary" OnClick="CancelNextRound" Disabled="@_isBusy" />
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div style="margin-top: 12px;"><FrameworkNotice Message="@_error" Severity="error" /></div>
        }

        <FrameworkModal IsOpen="@_showFreeSkipConfirmation" Title="Gratis überspringen?" OnClose="CloseFreeSkipConfirmation">
            <div style="display: grid; gap: 14px;">
                <FrameworkNotice Message="Der Begriff wird ohne Verbrauch des Skip-Limits übersprungen. Diese Aktion lässt sich nicht rückgängig machen." Severity="warning" />
                <p style="margin: 0;">Team: <strong>@_freeSkipTeamName</strong><br />Begriff: <strong>@_freeSkipTerm</strong></p>
                <div class="framework-button-row" style="justify-content: flex-end;">
                    <FrameworkButton Label="Abbrechen" Variant="secondary" OnClick="CloseFreeSkipConfirmation" Disabled="@_isBusy" />
                    <FrameworkButton Label="Gratis überspringen" Variant="danger" OnClick="ConfirmFreeSkipAsync" Busy="@_isBusy" />
                </div>
            </div>
        </FrameworkModal>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <FrameworkNotice Message="@_error" Severity="error" />
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public Guid ProjectId { get; set; }

    private PantomimeAdminData? _data;
    private TeamSummary[] _teams = [];
    private ParticipantSummary[] _participants = [];
    private readonly Dictionary<Guid, Guid> _selectedPerformers = [];
    private JsonElement _state;
    private Guid _loadedEventId;
    private Guid _loadedSlideId;
    private string? _accessToken;
    private string? _error;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _endingExpiredRound;
    private bool _showFreeSkipConfirmation;
    private bool _isPreparingNextRound;
    private Guid? _focusedTeamId;
    private Guid? _freeSkipTeamId;
    private int? _freeSkipExpectedTermIndex;
    private string? _freeSkipTeamName;
    private string? _freeSkipTerm;
    private int _roundDurationSeconds = 60;
    private int _remainingSeconds;
    private CancellationTokenSource? _timerCancellation;
    private Task? _timerTask;

    private bool _isRunning => ReadBool(_state, "isRunning");
    private bool _isPaused => ReadBool(_state, "isPaused");
    private bool _isEnded => ReadBool(_state, "isEnded");
    private bool _showRoundSetup => !(_isRunning || _isPaused || _isEnded) || (_isEnded && _isPreparingNextRound);
    private TeamSummary? _focusedTeam => _focusedTeamId is Guid teamId
        ? _teams.FirstOrDefault(team => team.Id == teamId)
        : null;
    private PantomimeModeratorTeamData? _focusedTeamData => _focusedTeamId is Guid teamId
        ? GetModeratorTeamData(teamId)
        : null;
    private bool _allPerformersSelected => _teams.Length > 0
        && _teams.All(team => _selectedPerformers.ContainsKey(team.Id)
            && _participants.Any(participant => participant.Id == _selectedPerformers[team.Id] && participant.TeamId == team.Id));

    protected override async Task OnParametersSetAsync()
    {
        ReadLiveState();
        if (_loadedEventId == Event.EventId && _loadedSlideId == CurrentSlide.SlideId)
        {
            UpdateRemaining();
            return;
        }

        _loadedEventId = Event.EventId;
        _loadedSlideId = CurrentSlide.SlideId;
        ExitFocusedTeam();
        CloseFreeSkipConfirmation();
        _isPreparingNextRound = false;
        _isLoading = true;
        _error = null;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _accessToken = auth.User.FindFirst("api_access_token")?.Value;
            if (string.IsNullOrWhiteSpace(_accessToken))
            {
                throw new InvalidOperationException("Die Admin-Sitzung ist nicht verfügbar.");
            }

            var dataTask = ProjectApiClient.GetPantomimeAsync(_accessToken, ProjectId, Event.EventId, CurrentSlide.SlideId);
            var teamsTask = ProjectApiClient.GetTeamsAsync(_accessToken, ProjectId);
            var participantsTask = ProjectApiClient.GetParticipantsAsync(_accessToken, ProjectId);
            await Task.WhenAll(dataTask, teamsTask, participantsTask);
            _data = await dataTask;
            _teams = await teamsTask;
            _participants = await participantsTask;
            _roundDurationSeconds = _data.RoundDurationSeconds;
            if (_state.ValueKind == JsonValueKind.Undefined)
            {
                _state = _data.State;
            }

            RestoreAssignments(_state);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
        UpdateRemaining();
    }

    protected override void OnInitialized()
    {
        _timerCancellation = new CancellationTokenSource();
        _timerTask = UpdateTimerAsync(_timerCancellation.Token);
    }

    private async Task StartRoundAsync()
    {
        if (!_allPerformersSelected || _data is null)
        {
            _error = "Wähle für jedes Team eine darstellende Person aus.";
            return;
        }

        var assignments = _teams
            .Select(team => new PantomimeAssignment(team.Id, _selectedPerformers[team.Id]))
            .ToArray();
        await RunActionAsync("start", assignments);
        if (!_isEnded)
        {
            _isPreparingNextRound = false;
        }
    }

    private async Task PrepareNextRoundAsync()
    {
        if (!_isEnded || _isBusy || string.IsNullOrWhiteSpace(_accessToken))
        {
            return;
        }

        _isBusy = true;
        _error = null;
        try
        {
            // Teams and participants may have changed since the slide was loaded.
            var teamsTask = ProjectApiClient.GetTeamsAsync(_accessToken, ProjectId);
            var participantsTask = ProjectApiClient.GetParticipantsAsync(_accessToken, ProjectId);
            await Task.WhenAll(teamsTask, participantsTask);
            _teams = await teamsTask;
            _participants = await participantsTask;
            _isPreparingNextRound = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void CancelNextRound() => _isPreparingNextRound = false;

    private async Task RunActionAsync(
        string action,
        PantomimeAssignment[]? assignments = null,
        Guid? teamId = null,
        int? expectedTermIndex = null)
    {
        if (_isBusy || string.IsNullOrWhiteSpace(_accessToken))
        {
            return;
        }

        _isBusy = true;
        _error = null;
        try
        {
            await ProjectApiClient.UpdatePantomimeAsync(
                _accessToken,
                ProjectId,
                Event.EventId,
                CurrentSlide.SlideId,
                action,
                assignments: assignments,
                roundDurationSeconds: _roundDurationSeconds,
                teamId: teamId,
                expectedTermIndex: expectedTermIndex);
            _data = await ProjectApiClient.GetPantomimeAsync(_accessToken, ProjectId, Event.EventId, CurrentSlide.SlideId);
            _state = _data.State;
            RestoreAssignments(_state);
            UpdateRemaining();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task UpdateTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                UpdateRemaining();
                if (_isRunning && !_isBusy && !string.IsNullOrWhiteSpace(_accessToken))
                {
                    await RefreshAdminDataAsync(cancellationToken);
                }
                if (_isRunning && _remainingSeconds == 0 && !_endingExpiredRound)
                {
                    _endingExpiredRound = true;
                    await RunActionAsync("end");
                    _endingExpiredRound = false;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAdminDataAsync(CancellationToken cancellationToken)
    {
        try
        {
            _data = await ProjectApiClient.GetPantomimeAsync(
                _accessToken!,
                ProjectId,
                Event.EventId,
                CurrentSlide.SlideId,
                cancellationToken);
            _state = _data.State;
            _error = null;
            UpdateRemaining();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
    }

    private void ReadLiveState()
    {
        if (CurrentSlide.Parameters.ValueKind == JsonValueKind.Object
            && CurrentSlide.Parameters.TryGetProperty("state", out var state)
            && state.ValueKind == JsonValueKind.Object)
        {
            _state = state;
        }
    }

    private void RestoreAssignments(JsonElement state)
    {
        if (state.ValueKind != JsonValueKind.Object
            || !state.TryGetProperty("teamStates", out var teamStates)
            || teamStates.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        foreach (var teamState in teamStates.EnumerateArray())
        {
            var teamId = ReadGuid(teamState, "teamId");
            var performerId = ReadGuid(teamState, "performerId");
            if (teamId.HasValue && performerId.HasValue)
            {
                _selectedPerformers[teamId.Value] = performerId.Value;
            }
        }
    }

    private IEnumerable<ParticipantSummary> TeamParticipants(Guid teamId) =>
        _participants.Where(participant => participant.TeamId == teamId);

    private string GetSelectedPerformer(Guid teamId) =>
        _selectedPerformers.TryGetValue(teamId, out var participantId) ? participantId.ToString() : string.Empty;

    private void SetSelectedPerformer(Guid teamId, ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var participantId)
            && _participants.Any(participant => participant.Id == participantId && participant.TeamId == teamId))
        {
            _selectedPerformers[teamId] = participantId;
        }
        else
        {
            _selectedPerformers.Remove(teamId);
        }
    }

    private string GetSkipLabel(PantomimeModeratorTeamData? team) =>
        team is not null && team.SkipsRemaining > 0
            ? $"Überspringen ({team.SkipsRemaining} übrig)"
            : "Skip-Limit erreicht";

    private bool IsSkipDisabled(PantomimeModeratorTeamData? team) =>
        _isBusy || team is null || team.SkipsRemaining <= 0;

    private void EnterFocusedTeam(Guid teamId)
    {
        if (_isRunning && GetModeratorTeamData(teamId)?.CurrentTermIndex is not null)
        {
            _focusedTeamId = teamId;
        }
    }

    private void ExitFocusedTeam() => _focusedTeamId = null;

    private void RequestFreeSkip(Guid teamId)
    {
        if (!_isRunning || _isBusy || GetModeratorTeamData(teamId) is not { CurrentTermIndex: int termIndex, Term: string term } team)
        {
            return;
        }

        _freeSkipTeamId = teamId;
        _freeSkipExpectedTermIndex = termIndex;
        _freeSkipTeamName = team.TeamName;
        _freeSkipTerm = term;
        _showFreeSkipConfirmation = true;
    }

    private async Task ConfirmFreeSkipAsync()
    {
        if (_freeSkipTeamId is not Guid teamId || _freeSkipExpectedTermIndex is not int termIndex)
        {
            CloseFreeSkipConfirmation();
            return;
        }

        await RunActionAsync("free-skip", teamId: teamId, expectedTermIndex: termIndex);
        CloseFreeSkipConfirmation();
    }

    private void CloseFreeSkipConfirmation()
    {
        _showFreeSkipConfirmation = false;
        _freeSkipTeamId = null;
        _freeSkipExpectedTermIndex = null;
        _freeSkipTeamName = null;
        _freeSkipTerm = null;
    }

    private JsonElement GetTeamState(Guid teamId)
    {
        if (_state.ValueKind == JsonValueKind.Object
            && _state.TryGetProperty("teamStates", out var teamStates)
            && teamStates.ValueKind == JsonValueKind.Array)
        {
            foreach (var teamState in teamStates.EnumerateArray())
            {
                if (ReadGuid(teamState, "teamId") == teamId)
                {
                    return teamState;
                }
            }
        }

        return default;
    }

    private PantomimeModeratorTeamData? GetModeratorTeamData(Guid teamId) =>
        _data?.TeamTerms.FirstOrDefault(team => team.TeamId == teamId);

    private void UpdateRemaining()
    {
        if (_isRunning && ReadDateTime(_state, "deadlineUtc") is DateTime deadline)
        {
            _remainingSeconds = Math.Max(0, (int)Math.Ceiling((deadline - DateTime.UtcNow).TotalSeconds));
        }
        else
        {
            _remainingSeconds = Math.Max(0, ReadInt(_state, "remainingSeconds"));
        }
    }

    private static string ReadString(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;

    private static bool ReadBool(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.True;

    private static int ReadInt(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var result)
            ? result
            : 0;

    private static Guid? ReadGuid(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            && Guid.TryParse(value.GetString(), out var result) ? result : null;

    private static DateTime? ReadDateTime(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            && value.TryGetDateTime(out var result) ? result : null;

    private static string FormatSeconds(int seconds) => TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss");

    public async ValueTask DisposeAsync()
    {
        _timerCancellation?.Cancel();
        if (_timerTask is not null)
        {
            await _timerTask;
        }
        _timerCancellation?.Dispose();
    }
}
