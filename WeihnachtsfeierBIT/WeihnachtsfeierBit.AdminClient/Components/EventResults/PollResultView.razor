@using System.Text.Json
@using WeihnachtsfeierBit.Framework

<div style="margin-top: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3 style="margin: 0;">Ergebnisse & Rückmeldungen (@TotalVotes Stimmen)</h3>
        <FrameworkBadge Text="@($"{TotalVotes} Antworten")" Variant="primary" />
    </div>

    @if (TotalVotes == 0)
    {
        <p style="color: #657276; font-size: 14px;">Noch keine Rückmeldungen für diese Abstimmung eingetroffen.</p>
    }
    else
    {
        <div style="display: grid; gap: 12px; margin-top: 12px;">
            @foreach (var opt in OptionStats)
            {
                <div style="padding: 12px; border: 1px solid #dce5e2; border-radius: 6px; background: #fff;">
                    <div style="display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 6px;">
                        <span>@opt.Option</span>
                        <span>@opt.Count Stimmen (@opt.Percentage.ToString("F1")%)</span>
                    </div>
                    <div style="width: 100%; height: 10px; background: #e7ecea; border-radius: 5px; overflow: hidden;">
                        <div style="width: @(opt.Percentage)%; height: 100%; background: #197b67; border-radius: 5px; transition: width 0.3s ease;"></div>
                    </div>
                </div>
            }
        </div>

        <div style="margin-top: 16px;">
            <button type="button" @onclick="() => _showDetails = !_showDetails" style="border: none; background: transparent; color: #105c4d; font-weight: 700; font-size: 13px; cursor: pointer; padding: 0;">
                @(_showDetails ? "▲ Einzelne Stimmen ausblenden" : "▼ Einzelne Stimmen anzeigen")
            </button>

            @if (_showDetails)
            {
                <div style="display: grid; gap: 6px; margin-top: 10px; max-height: 250px; overflow-y: auto;">
                    @foreach (var resp in SlideResponses)
                    {
                        var optText = ReadSelectedOption(resp.ResponseData);
                        <div style="padding: 8px 12px; border: 1px solid #dce5e2; border-radius: 6px; background: #fafcfb; display: flex; justify-content: space-between; align-items: center; font-size: 13px;">
                            <div>
                                <strong style="color: #105c4d;">#@resp.ParticipantNumber @(string.IsNullOrWhiteSpace(resp.ParticipantName) ? "" : $"({resp.ParticipantName})")</strong>
                                @if (!string.IsNullOrEmpty(resp.TeamName))
                                {
                                    <span style="color: #64748b; margin-left: 6px;">• Team @resp.TeamName</span>
                                }
                            </div>
                            <strong style="color: #1d2528;">@optText</strong>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;

    private bool _showDetails;

    private IEnumerable<EventResponseState> SlideResponses => Event.Responses.Where(r => r.SlideId == CurrentSlide.SlideId);
    private int TotalVotes => SlideResponses.Count();

    private List<OptionStat> OptionStats
    {
        get {
            var options = ReadStringList(CurrentSlide.Parameters, "options");
            if (options.Count == 0) options = ["Ja", "Nein"];

            var counts = options.ToDictionary(o => o, _ => 0);
            foreach (var resp in SlideResponses)
            {
                var optStr = ReadSelectedOption(resp.ResponseData);
                if (counts.ContainsKey(optStr))
                {
                    counts[optStr]++;
                }
            }

            var total = Math.Max(1, TotalVotes);
            return options.Select(o => new OptionStat(o, counts[o], (double)counts[o] / total * 100.0)).ToList();
        }
    }

    private static string ReadSelectedOption(JsonElement el)
    {
        if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty("selectedOption", out var v) && v.ValueKind == JsonValueKind.String)
        {
            return v.GetString() ?? string.Empty;
        }
        return string.Empty;
    }

    private sealed record OptionStat(string Option, int Count, double Percentage);

    private static List<string> ReadStringList(JsonElement elem, string prop)
    {
        var list = new List<string>();
        if (elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var arr) && arr.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in arr.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String)
                {
                    list.Add(item.GetString() ?? string.Empty);
                }
            }
        }
        return list;
    }
}
