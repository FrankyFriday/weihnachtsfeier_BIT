@inherits AuthenticatedComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject ProjectShowLinksState ShowLinksState

<section class="project-show-links @(Compact ? "project-show-links-compact" : null)">
    @if (!Compact)
    {
        <PageHeading Eyebrow="PROJEKT" Title="Verknüpfte Shows" Description="Shows aus der gemeinsamen Bibliothek zuordnen, lösen oder öffnen." />
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FrameworkNotice Message="@ErrorMessage" />
    }
    @if (_linking)
    {
        @if (_availableOptions.Length == 0)
        {
            <p class="sidebar-muted">Keine weiteren Shows verfügbar</p>
        }
        else
        {
            <FrameworkSelect Label="Show aus Bibliothek" Placeholder="Show auswählen" Value="_selectedShowId"
                             ValueChanged="OnShowSelected" Options="_availableOptions" />
            <FrameworkButton Label="Show verknüpfen" Disabled="@string.IsNullOrEmpty(_selectedShowId)" OnClick="LinkShowAsync" />
        }
    }
    @if (IsLoading)
    {
        <FrameworkLoading Message="Shows werden geladen ..." />
    }
    else if (_projectShows.Length == 0)
    {
        @if (!Compact)
        {
            <EmptyState Title="Keine verknüpften Shows" Description="Verknüpfe eine Show aus dem Workspace-Katalog." />
        }
    }
    else if (Compact)
    {
        @foreach (var show in _projectShows)
        {
            <div class="sidebar-show-row" @key="show.Id">
                <FrameworkLink Href="@ShowUrl(show.Id)" Label="@show.Name" Variant="text" />
                <FrameworkButton Label="Entfernen" Variant="text" OnClick="@(() => UnlinkShowAsync(show.Id))" />
            </div>
        }
    }
    else
    {
        <div class="project-grid">
            @foreach (var show in _projectShows)
            {
                <Card Class="project-card" @key="show.Id">
                    <ChildContent><h2>@show.Name</h2></ChildContent>
                    <FooterContent>
                        <FrameworkLink Href="@ShowUrl(show.Id)" Label="Show bearbeiten" Variant="text" />
                        <FrameworkButton Label="Verknüpfung entfernen" Variant="danger" OnClick="@(() => UnlinkShowAsync(show.Id))" />
                    </FooterContent>
                </Card>
            }
        </div>
    }
    <FrameworkButton Label="@(_linking ? "Abbrechen" : "Show verknüpfen")" Variant="secondary" OnClick="ToggleLinking" />
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public bool Compact { get; set; }

    private ProjectShow[] _projectShows = [];
    private AdminShow[] _allShows = [];
    private FrameworkSelectOption[] _availableOptions = [];
    private string? _selectedShowId;
    private bool _linking;
    private bool _hasLoadedForProject;
    private Guid _loadedProjectId;

    private AdminShow[] AvailableShows => _allShows
        .Where(show => _projectShows.All(link => link.Id != show.Id))
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoadedForProject && _loadedProjectId == ProjectId)
        {
            return;
        }

        await RefreshAsync();
    }

    protected override void OnInitialized()
    {
        ShowLinksState.LinksChanged += OnLinksChanged;
    }

    private async Task RefreshAsync() => await LoadAuthenticatedAsync(async token =>
    {
        var projectShowsTask = ProjectApiClient.GetShowsAsync(token, ProjectId);
        var allShowsTask = ProjectApiClient.GetAdminShowsAsync(token);
        await Task.WhenAll(projectShowsTask, allShowsTask);
        _projectShows = await projectShowsTask;
        _allShows = await allShowsTask;
        _availableOptions = AvailableShows.Select(show => new FrameworkSelectOption(show.Id.ToString(), show.Name)).ToArray();
        _loadedProjectId = ProjectId;
        _hasLoadedForProject = true;
    });

    private void ToggleLinking()
    {
        _linking = !_linking;
        _selectedShowId = null;
    }

    private Task OnShowSelected(string? value)
    {
        _selectedShowId = value;
        return Task.CompletedTask;
    }

    private async Task LinkShowAsync()
    {
        if (!Guid.TryParse(_selectedShowId, out var showId)) return;
        await RunAuthenticatedAsync(async token =>
        {
            await ProjectApiClient.LinkShowAsync(token, ProjectId, showId);
            await RefreshAsync();
            ShowLinksState.NotifyChanged(ProjectId, this);
            _selectedShowId = null;
        });
    }

    private async Task UnlinkShowAsync(Guid showId) => await RunAuthenticatedAsync(async token =>
    {
        await ProjectApiClient.UnlinkShowAsync(token, ProjectId, showId);
        await RefreshAsync();
        ShowLinksState.NotifyChanged(ProjectId, this);
    });

    private void OnLinksChanged(Guid projectId, object source)
    {
        if (projectId == ProjectId && !ReferenceEquals(source, this))
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
        }
    }

    private string ShowUrl(Guid showId) => $"{Navigation.BaseUri}shows/{showId}";

    public void Dispose() => ShowLinksState.LinksChanged -= OnLinksChanged;
}