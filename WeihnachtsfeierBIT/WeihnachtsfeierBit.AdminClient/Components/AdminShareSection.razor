@using WeihnachtsfeierBit.Framework

<Card Class="settings-card" Style="margin-top: 24px;">
    <ChildContent>
        <h2 style="margin: 0 0 12px 0; font-size: 16px; color: #1d2528;">Admins & Berechtigungen</h2>
        <p style="margin: 0 0 16px 0; color: #64748b; font-size: 13px;">Teile dieses @(IsProject ? "Projekt" : "Show") mit anderen Administratoren.</p>

        @if (_isLoading)
        {
            <FrameworkLoading Message="Berechtigungen werden geladen ..." />
        }
        else
        {
            @if (_shareList is not null)
            {
                @if (_shareList.CanManage)
                {
                    <div style="display: flex; gap: 8px; margin-bottom: 16px; align-items: flex-end; position: relative;">
                        <div style="flex: 1; position: relative;">
                            <FrameworkFormGroup Label="Admin einladen (Benutzername)">
                                <FrameworkInputText Value="@_searchQuery" ValueChanged="OnSearchInput" Placeholder="Benutzername eintippen..." />
                            </FrameworkFormGroup>

                            @if (_suggestions.Length > 0)
                            {
                                <div style="position: absolute; top: 100%; left: 0; right: 0; background: #ffffff; border: 1.5px solid #105c4d; border-radius: 8px; box-shadow: 0 6px 16px rgba(0,0,0,0.15); z-index: 2000; max-height: 200px; overflow-y: auto; margin-top: 4px;">
                                    @foreach (var admin in _suggestions)
                                    {
                                        <div @onclick="() => SelectAdmin(admin.Username)" style="padding: 10px 14px; cursor: pointer; border-bottom: 1px solid #e7ecea; font-size: 13px; font-weight: 700; color: #1d2528; display: flex; align-items: center; gap: 8px;" onmouseover="this.style.background='#e8f3ef'" onmouseout="this.style.background='#ffffff'">
                                            <span class="material-symbols-outlined" style="font-size: 18px; color: #105c4d;">person</span>
                                            <span>@admin.Username</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <FrameworkButton Label="Einladen" Variant="primary" OnClick="InviteAdminAsync" Busy="_isInviting" Disabled="@(string.IsNullOrWhiteSpace(_searchQuery))" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <FrameworkNotice Message="@_error" Severity="error" Style="margin-bottom: 12px;" />
                }

                <div style="display: grid; gap: 12px;">
                    @foreach (var admin in _shareList.Admins)
                    {
                        <div style="padding: 12px 14px; border: 1px solid #dce5e2; border-radius: 8px; background: #fafcfb; display: flex; flex-direction: column; gap: 8px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="material-symbols-outlined" style="font-size: 20px; color: #105c4d;">person</span>
                                    <strong style="font-size: 14px; color: #1d2528;">@admin.Username</strong>
                                    @if (admin.IsCreator)
                                    {
                                        <span style="font-size: 11px; font-weight: 800; background: #dcfce7; color: #166534; padding: 2px 8px; border-radius: 4px;">Hauptnutzer (Ersteller)</span>
                                    }
                                </div>
                                @if (_shareList.CanManage && !admin.IsCreator)
                                {
                                    <FrameworkButton Label="Entfernen" Variant="secondary" OnClick="() => RemoveAdminAsync(admin.AdminId)" />
                                }
                            </div>

                            @if (IsProject && !admin.IsCreator)
                            {
                                <div style="border-top: 1px dashed #cbd5e1; padding-top: 8px; margin-top: 4px;">
                                    <div style="font-size: 12px; font-weight: 700; color: #64748b; margin-bottom: 6px;">Berechtigungen für diesen Nutzer:</div>
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px;">
                                        <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer;">
                                            <input type="checkbox" checked="@admin.CanControlSession" disabled="@(!_shareList.CanManage)" @onchange="@(e => TogglePermissionAsync(admin, "CanControlSession", (bool)(e.Value ?? false)))" />
                                            <span>Live-Session steuern</span>
                                        </label>
                                        <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer;">
                                            <input type="checkbox" checked="@admin.CanManageParticipants" disabled="@(!_shareList.CanManage)" @onchange="@(e => TogglePermissionAsync(admin, "CanManageParticipants", (bool)(e.Value ?? false)))" />
                                            <span>Teilnehmer & Teams</span>
                                        </label>
                                        <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer;">
                                            <input type="checkbox" checked="@admin.CanEditProjectSettings" disabled="@(!_shareList.CanManage)" @onchange="@(e => TogglePermissionAsync(admin, "CanEditProjectSettings", (bool)(e.Value ?? false)))" />
                                            <span>Einstellungen bearbeiten</span>
                                        </label>
                                        <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer;">
                                            <input type="checkbox" checked="@admin.CanManageShows" disabled="@(!_shareList.CanManage)" @onchange="@(e => TogglePermissionAsync(admin, "CanManageShows", (bool)(e.Value ?? false)))" />
                                            <span>Shows verknüpfen</span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired] public Guid TargetId { get; set; }
    [Parameter, EditorRequired] public bool IsProject { get; set; }
    [Parameter, EditorRequired] public string AccessToken { get; set; } = null!;
    [Parameter] public ProjectApiClient ProjectApiClient { get; set; } = null!;

    private AdminShareListResponse? _shareList;
    private AdminDto[] _suggestions = [];
    private string _searchQuery = string.Empty;
    private bool _isLoading = true;
    private bool _isInviting;
    private string? _error;

    protected override async Task OnParametersSetAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            if (IsProject)
            {
                _shareList = await ProjectApiClient.GetProjectAdminsAsync(AccessToken, TargetId);
            }
            else
            {
                _shareList = await ProjectApiClient.GetShowAdminsAsync(AccessToken, TargetId);
            }
        }
        catch
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchInput(string query)
    {
        _searchQuery = query;
        if (_searchQuery.Length >= 1)
        {
            try
            {
                _suggestions = await ProjectApiClient.SearchAdminsAsync(AccessToken, _searchQuery);
            }
            catch
            {
                _suggestions = [];
            }
        }
        else
        {
            _suggestions = [];
        }
    }

    private void SelectAdmin(string username)
    {
        _searchQuery = username;
        _suggestions = [];
    }

    private async Task InviteAdminAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;
        _isInviting = true;
        _error = null;

        try
        {
            if (IsProject)
            {
                await ProjectApiClient.InviteProjectAdminAsync(AccessToken, TargetId, _searchQuery.Trim());
            }
            else
            {
                await ProjectApiClient.InviteShowAdminAsync(AccessToken, TargetId, _searchQuery.Trim());
            }
            _searchQuery = string.Empty;
            _suggestions = [];
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isInviting = false;
        }
    }

    private async Task TogglePermissionAsync(AdminShareItemDto admin, string permissionKey, bool newValue)
    {
        if (!_shareList?.CanManage ?? true) return;

        bool ctrl = permissionKey == "CanControlSession" ? newValue : admin.CanControlSession;
        bool part = permissionKey == "CanManageParticipants" ? newValue : admin.CanManageParticipants;
        bool sett = permissionKey == "CanEditProjectSettings" ? newValue : admin.CanEditProjectSettings;
        bool show = permissionKey == "CanManageShows" ? newValue : admin.CanManageShows;

        try
        {
            await ProjectApiClient.UpdateProjectAdminPermissionsAsync(AccessToken, TargetId, admin.AdminId, ctrl, part, sett, show);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveAdminAsync(Guid adminId)
    {
        _error = null;
        try
        {
            if (IsProject)
            {
                await ProjectApiClient.RemoveProjectAdminAsync(AccessToken, TargetId, adminId);
            }
            else
            {
                await ProjectApiClient.RemoveShowAdminAsync(AccessToken, TargetId, adminId);
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
