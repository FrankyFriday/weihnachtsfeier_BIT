<FrameworkModal IsOpen="IsOpen" Title="Neues Projekt anlegen" OnClose="OnCancel">
    <form class="project-create-form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <FrameworkNotice Message="@_errorMessage" />
        }
        <div class="form-group">
            <label for="new-project-name">Projektname</label>
            <input id="new-project-name" @bind="_name" @bind:event="oninput" required maxlength="120" placeholder="z. B. Weihnachtsfeier 2026" />
        </div>
        <div class="framework-button-row" style="margin-top: 20px; justify-content: flex-end;">
            <FrameworkButton Label="Abbrechen" Variant="secondary" OnClick="OnCancel" />
            <FrameworkButton Label="Projekt anlegen" BusyLabel="Wird angelegt ..." Type="submit" Busy="@IsCreating" Disabled="@IsCreating" Variant="primary" />
        </div>
    </form>
</FrameworkModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsCreating { get; set; }
    [Parameter, EditorRequired] public EventCallback<string> OnCreate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _name = string.Empty;
    private string? _errorMessage;

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _name = string.Empty;
            _errorMessage = null;
        }
    }

    private async Task CreateAsync()
    {
        if (IsCreating) return;

        var name = _name.Trim();
        if (string.IsNullOrWhiteSpace(name) || name.Length > 120)
        {
            _errorMessage = "Der Projektname muss zwischen 1 und 120 Zeichen lang sein.";
            return;
        }

        _errorMessage = null;
        await OnCreate.InvokeAsync(name);
    }
}