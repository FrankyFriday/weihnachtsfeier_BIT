@using Microsoft.AspNetCore.SignalR.Client
@using WeihnachtsfeierBit.Framework

<div style="position: fixed; inset: 0; width: 100vw; height: 100dvh; background: #f6f8f7; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box; z-index: 999;">
    <!-- TOP APP BAR -->
    <div style="background: #ffffff; padding: 10px 14px; border-bottom: 1.5px solid #dce5e2; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.03); max-width: 100vw; box-sizing: border-box;">
        <div style="min-width: 0; flex: 1; margin-right: 8px;">
            <span class="mobile-eyebrow" style="font-size: 10px; margin-bottom: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">@ProjectName</span>
            <strong style="display: block; font-size: 15px; color: #1d2528; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Teilnehmer #@ParticipantNumber</strong>
        </div>
        <div style="flex-shrink: 0; display: flex; align-items: center; gap: 8px;">
            <FrameworkConnectionStatus HubConnection="HubConnection" />
            <FrameworkBadge Text="Live" Variant="primary" />
        </div>
    </div>

    <!-- MAIN SCROLLABLE CONTENT AREA -->
    <div style="flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 12px; box-sizing: border-box;">
        <div style="max-width: 580px; margin: 0 auto; height: 100%; display: flex; flex-direction: column;">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div style="margin-bottom: 12px;"><FrameworkNotice Message="@ErrorMessage" Severity="error" /></div>
            }
            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div style="margin-bottom: 12px;"><FrameworkNotice Message="@SuccessMessage" Severity="success" /></div>
            }

            @if (_activeTab == "home")
            {
                <ParticipantTeamCard TeamState="@TeamState" ParticipantId="@ParticipantId" TotalTeamCount="@TotalTeamCount" />
                <ParticipantTimelineView PassiveEvents="@PassiveEvents" ScheduledEvents="@ScheduledEvents" OnSelectPassiveEvent="@OnSelectPassiveEvent" />
                <ParticipantTeamMembersCard TeamState="@TeamState" ParticipantId="@ParticipantId" />
                <ParticipantLeaderboard AllTeams="@AllTeams" MyTeamId="@TeamState?.Id" />
            }
            else if (_activeTab == "chat")
            {
                <div style="flex: 1; height: 100%; min-height: 0;">
                    <FrameworkChat ProjectId="@ProjectId"
                                   AccessToken="@AccessToken"
                                   ParticipantId="@ParticipantId"
                                   IsAdmin="false" />
                </div>
            }
            else if (_activeTab == "profile")
            {
                <ParticipantProfileActions ProjectId="@ProjectId"
                                           AccessToken="@AccessToken"
                                           NameInput="@NameInput"
                                           IsSavingName="@IsSavingName"
                                           NameInputChanged="@NameInputChanged"
                                           OnSaveName="@OnSaveName" />
            }
        </div>
    </div>

    <!-- BOTTOM MOBILE NAVIGATION BAR -->
    <div style="background: #ffffff; border-top: 1.5px solid #dce5e2; display: flex; justify-content: space-around; align-items: center; height: max(56px, calc(56px + env(safe-area-inset-bottom, 0px))); padding-bottom: env(safe-area-inset-bottom, 0px); flex-shrink: 0; box-shadow: 0 -2px 8px rgba(0,0,0,0.04); z-index: 1000; box-sizing: border-box;">
        <button type="button" @onclick='() => _activeTab = "home"' style="border: none; background: transparent; color: @(_activeTab == "home" ? "#105c4d" : "#657276"); display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; height: 100%; justify-content: center;">
            <span class="material-symbols-outlined" style="font-size: 22px;">home</span>
            <span>Home</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "chat"' style="border: none; background: transparent; color: @(_activeTab == "chat" ? "#105c4d" : "#657276"); display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; height: 100%; justify-content: center;">
            <span class="material-symbols-outlined" style="font-size: 22px;">chat</span>
            <span>Chat</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "profile"' style="border: none; background: transparent; color: @(_activeTab == "profile" ? "#105c4d" : "#657276"); display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; height: 100%; justify-content: center;">
            <span class="material-symbols-outlined" style="font-size: 22px;">person</span>
            <span>Aktionen</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public string ProjectName { get; set; } = "Projekt";
    [Parameter] public int ParticipantNumber { get; set; }
    [Parameter] public Guid ParticipantId { get; set; }
    [Parameter] public string AccessToken { get; set; } = string.Empty;
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public TeamState? TeamState { get; set; }
    [Parameter] public TeamState[] AllTeams { get; set; } = [];
    [Parameter] public EventState[] PassiveEvents { get; set; } = [];
    [Parameter] public EventState[] ScheduledEvents { get; set; } = [];
    [Parameter] public string NameInput { get; set; } = string.Empty;
    [Parameter] public bool IsSavingName { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public EventCallback<string> NameInputChanged { get; set; }
    [Parameter] public EventCallback OnSaveName { get; set; }
    [Parameter] public EventCallback<EventState> OnSelectPassiveEvent { get; set; }
    [Parameter] public HubConnection? HubConnection { get; set; }

    private string _activeTab = "home";

    private int TotalTeamCount => AllTeams.Length;
}
