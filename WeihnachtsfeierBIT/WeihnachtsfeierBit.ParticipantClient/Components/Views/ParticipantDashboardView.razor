@using Microsoft.AspNetCore.SignalR.Client
@using WeihnachtsfeierBit.Framework
@inject ParticipantNotificationService Notifications

<div style="position: fixed; inset: 0; width: 100vw; height: 100dvh; background: #f6f8f7; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box; z-index: 999;">
    <!-- TOP APP BAR -->
    <div class="participant-app-bar @(_isProfileMenuOpen ? "has-profile-menu" : string.Empty)" @onclick="CloseProfileMenu" style="background: #ffffff; padding: 10px 14px; border-bottom: 1.5px solid #dce5e2; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.03); max-width: 100vw; box-sizing: border-box;">
        <div style="min-width: 0; flex: 1; margin-right: 8px;">
            <span class="mobile-eyebrow" style="font-size: 10px; margin-bottom: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">@ProjectName</span>
            <strong style="display: block; font-size: 15px; color: #1d2528; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Teilnehmer #@ParticipantNumber</strong>
        </div>
        <div style="flex-shrink: 0; display: flex; align-items: center; gap: 8px;">
            <FrameworkConnectionStatus HubConnection="HubConnection" />
            <button type="button" class="participant-profile-icon" aria-label="Profil und Abmelden" aria-expanded="@_isProfileMenuOpen" @onclick="ToggleProfileMenu" @onclick:stopPropagation="true">
                <span class="material-symbols-outlined">account_circle</span>
            </button>
        </div>
        <div class="participant-profile-menu @(_isProfileMenuOpen ? "is-open" : string.Empty)" role="group" aria-label="Profilmenü" aria-hidden="@(!_isProfileMenuOpen)" inert="@(!_isProfileMenuOpen)" @onclick:stopPropagation="true">
            <span class="participant-profile-menu-title">Teilnehmer #@ParticipantNumber</span>
            <button type="button" @onclick="OnLogout">
                <span class="material-symbols-outlined">logout</span>
                Abmelden
            </button>
        </div>
    </div>
    <div class="participant-profile-backdrop @(_isProfileMenuOpen ? "is-open" : string.Empty)" aria-hidden="true" @onclick="CloseProfileMenu" @onclick:stopPropagation="true"></div>

    <!-- MAIN SCROLLABLE CONTENT AREA -->
    <div style="flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 12px; box-sizing: border-box;">
        <div style="max-width: 580px; margin: 0 auto; height: 100%; display: flex; flex-direction: column;">
            <div @key="_activeTab" class="participant-dashboard-page">
            @if (_activeTab == "home")
            {
                <ParticipantTeamCard TeamState="@TeamState" ParticipantId="@ParticipantId" TotalTeamCount="@TotalTeamCount" />
                <ParticipantTimelineView PassiveEvents="@PassiveEvents" ScheduledEvents="@ScheduledEvents" OnSelectPassiveEvent="@OnSelectPassiveEvent" />
                <ParticipantTeamMembersCard TeamState="@TeamState" ParticipantId="@ParticipantId" />
                <ParticipantLeaderboard AllTeams="@AllTeams" MyTeamId="@TeamState?.Id" />
            }
            else if (_activeTab == "chat")
            {
                <div style="flex: 1; height: 100%; min-height: 0;">
                    <FrameworkChat ProjectId="@ProjectId"
                                   AccessToken="@AccessToken"
                                   ParticipantId="@ParticipantId"
                                   Permissions="@ParticipantPermissions"
                                   HubConnection="HubConnection"
                                   IsAdmin="false"
                                   OnError="ShowChatError" />
                </div>
            }
            else if (_activeTab == "profile")
            {
                <ParticipantProfileActions @ref="_profileActions"
                                           ProjectId="@ProjectId"
                                           AccessToken="@AccessToken"
                                           ParticipantPermissions="@ParticipantPermissions"
                                           NameInput="@NameInput"
                                           IsSavingName="@IsSavingName"
                                           NameInputChanged="@NameInputChanged"
                                           OnSaveName="@OnSaveName"
                                           OnLogout="@OnLogout" />
            }
            </div>
        </div>
    </div>

    <!-- BOTTOM MOBILE NAVIGATION BAR -->
    <div class="participant-bottom-nav" style="background: #ffffff; border-top: 1.5px solid #dce5e2; display: flex; justify-content: space-around; align-items: center; height: max(56px, calc(56px + env(safe-area-inset-bottom, 0px))); padding-bottom: env(safe-area-inset-bottom, 0px); flex-shrink: 0; box-shadow: 0 -2px 8px rgba(0,0,0,0.04); z-index: 1000; box-sizing: border-box;">
        <button type="button" class="participant-nav-button @(_activeTab == "home" ? "is-active" : string.Empty)" @onclick='() => _activeTab = "home"' style="border: none; background: transparent; color: @(_activeTab == "home" ? "#105c4d" : "#657276"); display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; height: 100%; justify-content: center;">
            <span class="material-symbols-outlined" style="font-size: 22px;">home</span>
            <span>Home</span>
        </button>
        <button type="button" class="participant-nav-button @(_activeTab == "chat" ? "is-active" : string.Empty)" @onclick='() => _activeTab = "chat"' style="border: none; background: transparent; color: @(_activeTab == "chat" ? "#105c4d" : "#657276"); display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; height: 100%; justify-content: center;">
            <span class="material-symbols-outlined" style="font-size: 22px;">chat</span>
            <span>Chat</span>
        </button>
        <button type="button" class="participant-nav-button @(_activeTab == "profile" ? "is-active" : string.Empty)" @onclick="ShowActions" style="border: none; background: transparent; color: @(_activeTab == "profile" ? "#105c4d" : "#657276"); display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; height: 100%; justify-content: center;">
            <span class="material-symbols-outlined" style="font-size: 22px;">person</span>
            <span>Aktionen</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public string ProjectName { get; set; } = "Projekt";
    [Parameter] public int ParticipantNumber { get; set; }
    [Parameter] public Guid ParticipantId { get; set; }
    [Parameter] public string AccessToken { get; set; } = string.Empty;
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public ParticipantPermissions? ParticipantPermissions { get; set; }
    [Parameter] public TeamState? TeamState { get; set; }
    [Parameter] public TeamState[] AllTeams { get; set; } = [];
    [Parameter] public EventState[] PassiveEvents { get; set; } = [];
    [Parameter] public EventState[] ScheduledEvents { get; set; } = [];
    [Parameter] public string NameInput { get; set; } = string.Empty;
    [Parameter] public bool IsSavingName { get; set; }
    [Parameter] public EventCallback<string> NameInputChanged { get; set; }
    [Parameter] public EventCallback OnSaveName { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }
    [Parameter] public EventCallback<EventState> OnSelectPassiveEvent { get; set; }
    [Parameter] public HubConnection? HubConnection { get; set; }

    private string _activeTab = "home";
    private bool _isProfileMenuOpen;
    private ParticipantProfileActions? _profileActions;

    private int TotalTeamCount => AllTeams.Length;

    private void ToggleProfileMenu() => _isProfileMenuOpen = !_isProfileMenuOpen;

    private void CloseProfileMenu() => _isProfileMenuOpen = false;

    private Task ShowChatError(string message)
    {
        Notifications.Show(message, ParticipantToastSeverity.Error);
        return Task.CompletedTask;
    }

    private async Task ShowActions()
    {
        _activeTab = "profile";
        CloseProfileMenu();
        if (_profileActions is not null)
        {
            await _profileActions.ReturnToActionMenuAsync();
        }
    }
}
