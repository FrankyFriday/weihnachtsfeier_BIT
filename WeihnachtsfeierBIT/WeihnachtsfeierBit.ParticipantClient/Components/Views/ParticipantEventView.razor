@using System.Text.Json
@using WeihnachtsfeierBit.Framework

<div style="position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 9999; background: #ffffff; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box;">
    @if (ShowBackButton)
    {
        <div style="background: #f8faf9; padding: 12px 16px; border-bottom: 1px solid #dce5e2; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
            <FrameworkButton Label="◄ Zurück" Variant="secondary" OnClick="OnBack" />
            @if (Event.Slides.Length > 0 && _currentSlideIndex < Event.Slides.Length)
            {
                <FrameworkBadge Text="@GetFriendlyTypeName(Event.Slides[_currentSlideIndex].Type)" Variant="@Event.Slides[_currentSlideIndex].Type" />
            }
        </div>
    }

    @if (Event.Slides.Length > 0)
    {
        var slideIndex = Math.Clamp(_currentSlideIndex, 0, Event.Slides.Length - 1);
        var currentSlide = Event.Slides[slideIndex];

        <div style="flex: 1; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: stretch; overflow: hidden; box-sizing: border-box; position: relative;">
            @if (IsTeamExclusiveBlocked(currentSlide))
            {
                <div style="position: absolute; inset: 0; z-index: 50; background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(3px); display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px; text-align: center; box-sizing: border-box;">
                    <div style="background: #fffbeb; border: 1.5px solid #f59e0b; border-radius: 12px; padding: 24px; max-width: 400px; box-shadow: 0 4px 16px rgba(0,0,0,0.08);">
                        <span style="font-size: 36px; display: block; margin-bottom: 8px;">🔒</span>
                        <h3 style="margin: 0 0 8px 0; color: #b45309; font-size: 18px;">Team-exklusive Frage</h3>
                        <p style="margin: 0; color: #78350f; font-size: 14px; line-height: 1.4;">
                            Nur das aktive Team (<strong>@(Event.NavigationContext?.ActiveTeamName ?? "Team")</strong>) antwortet. Du bist im Live-Mitleser-Modus!
                        </p>
                    </div>
                </div>
            }

            <div style="@(IsTeamExclusiveBlocked(currentSlide) ? "pointer-events: none; opacity: 0.65; width: 100%; height: 100%; display: flex; flex-direction: column;" : "width: 100%; height: 100%; display: flex; flex-direction: column;")">
                @switch (currentSlide.Type.ToLowerInvariant())
                {
                    case "announcement":
                        <AnnouncementRenderer Event="Event" CurrentSlide="currentSlide" />
                        break;
                    case "poll":
                        <PollRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" ParticipantId="@ParticipantId" />
                        break;
                    case "quiz":
                        <QuizRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" ParticipantId="@ParticipantId" />
                        break;
                    case "ranking":
                        <RankingRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" Teams="Teams" />
                        break;
                    case "estimation":
                        <EstimationRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" ParticipantId="@ParticipantId" />
                        break;
                    case "buzzer":
                        <BuzzerRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" ParticipantId="@ParticipantId" />
                        break;
                    case "hitster":
                        <HitsterRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" ParticipantId="@ParticipantId" TeamId="@TeamId" />
                        break;
                    case "text":
                        <TextRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" />
                        break;
                    case "word_cloud":
                        <WordCloudRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" />
                        break;
                    case "slider":
                        <SliderRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" />
                        break;
                    case "rating":
                        <RatingRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" />
                        break;
                    case "ordering":
                        <OrderingRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" />
                        break;
                    case "countdown":
                        <CountdownRenderer Event="Event" CurrentSlide="currentSlide" />
                        break;
                    case "point_award":
                        <PointAwardRenderer Event="Event" CurrentSlide="currentSlide" AccessToken="@AccessToken" ProjectId="@ProjectId" Teams="Teams" />
                        break;
                    case "jeopardy":
                        <JeopardyRenderer Event="Event" CurrentSlide="currentSlide" />
                        break;
                    default:
                        <FallbackRenderer Event="Event" CurrentSlide="currentSlide" />
                        break;
                }
            </div>
        </div>

        @if (Event.NavigationMode == "self_paced" && Event.Slides.Length > 1)
        {
            <div style="background: #f8faf9; padding: 12px 16px; border-top: 1px solid #dce5e2; display: flex; align-items: center; justify-content: space-between;">
                <button type="button" class="mobile-button secondary" @onclick="() => StepSelfPacedSlide(-1)" disabled="@(_currentSlideIndex == 0)">◄ Vorherige</button>
                <span style="font-size: 13px; font-weight: 700; color: #105c4d;">Folie @(_currentSlideIndex + 1) von @Event.Slides.Length</span>
                <button type="button" class="mobile-button secondary" @onclick="() => StepSelfPacedSlide(1)" disabled="@(_currentSlideIndex >= Event.Slides.Length - 1)">Nächste ►</button>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter] public TeamSummary[] Teams { get; set; } = [];
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ParticipantId { get; set; }
    [Parameter] public Guid? TeamId { get; set; }
    [Parameter] public bool ShowBackButton { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private int _currentSlideIndex;

    protected override void OnParametersSet()
    {
        if (Event.NavigationMode == "host_controlled")
        {
            _currentSlideIndex = Event.CurrentSlideIndex;
        }
    }

    private void StepSelfPacedSlide(int delta)
    {
        _currentSlideIndex = Math.Clamp(_currentSlideIndex + delta, 0, Math.Max(0, Event.Slides.Length - 1));
    }

    private bool IsTeamExclusiveBlocked(EventSlideState currentSlide)
    {
        if (currentSlide.Parameters.ValueKind != JsonValueKind.Object) return false;
        if (!currentSlide.Parameters.TryGetProperty("teamMode", out var tmProp) || tmProp.ValueKind != JsonValueKind.String) return false;
        var teamMode = tmProp.GetString();
        if (!string.Equals(teamMode, "team_exclusive", StringComparison.OrdinalIgnoreCase)) return false;

        if (!Event.ActiveTeamId.HasValue) return false;
        if (!TeamId.HasValue) return true;

        return TeamId.Value != Event.ActiveTeamId.Value;
    }

    private static string GetFriendlyTypeName(string type) => type.ToLowerInvariant() switch
    {
        "announcement" => "Ankündigung",
        "poll" => "Abstimmung",
        "quiz" => "Quiz",
        "estimation" => "Schätzfrage",
        "buzzer" => "Buzzer",
        "hitster" => "Hitster · Spotify",
        "ranking" => "Rangliste",
        "text" => "Freitext",
        "word_cloud" => "Wortwolke",
        "slider" => "Schieberegler",
        "rating" => "Bewertung",
        "ordering" => "Reihenfolge",
        "countdown" => "Timer",
        "point_award" => "Punktevergabe",
        "jeopardy" => "Jeopardy",
        _ => "Event"
    };
}
