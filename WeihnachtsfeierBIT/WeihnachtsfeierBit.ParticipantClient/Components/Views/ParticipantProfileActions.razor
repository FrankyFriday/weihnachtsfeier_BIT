@using WeihnachtsfeierBit.Framework
@inject ProjectApiClient ProjectApiClient
@inject ParticipantNotificationService Notifications

<div @key="ActionViewKey" class="participant-action-view @(_isLeavingAction ? "is-leaving" : string.Empty)">
@if (_selectedInfoPage is not null)
{
    <!-- SUB-VIEW: INFO PAGE DETAIL (e.g. SPEISEKARTE, SHUTTLE, WLAN) -->
    <Card Class="settings-card participant-action-card participant-info-page" Style="border-radius: 16px;">
        <div class="participant-action-subview-toolbar">
            <button type="button" @onclick="ReturnToActionMenuAsync" class="participant-action-back">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                <span>Zurück zu Aktionen</span>
            </button>
        </div>

        <div class="participant-info-heading">
            <span class="participant-info-icon material-symbols-outlined" aria-hidden="true">@_selectedInfoPage.Icon</span>
            <h2>@_selectedInfoPage.Title</h2>
        </div>

        <FrameworkMarkdown Content="@_selectedInfoPage.ContentMarkdown" Class="participant-info-markdown" />
    </Card>
}
else if (_activeActionView == "name")
{
    <!-- SUB-VIEW: EDIT NAME -->
    <Card Class="settings-card participant-action-card" Style="border-radius: 16px;">
        <div class="participant-action-subview-toolbar">
            <button type="button" @onclick="ReturnToActionMenuAsync" class="participant-action-back">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                <span>Zurück zu Aktionen</span>
            </button>
        </div>

        @if (CanChangeName)
        {
            <h3 style="margin-top: 0; font-size: 17px; font-weight: 800; color: #1d2528;">Deinen Namen ändern</h3>
            <p class="framework-help-text" style="font-size: 13px;">Trage deinen Namen ein, damit deine Punkte und Ergebnisse im Team erscheinen.</p>

            <form @onsubmit="SaveNameAndCloseSubView" @onsubmit:preventDefault="true" style="display: flex; flex-direction: column; gap: 14px; margin-top: 14px;">
                <FrameworkFormGroup Label="Dein Name" ForId="my-name">
                    <FrameworkInputText Id="my-name" Value="@NameInput" ValueChanged="NameInputChanged" MaxLength="120" Placeholder="z. B. Alex" />
                </FrameworkFormGroup>
                <FrameworkButton Label="@(IsSavingName ? "Wird gespeichert..." : "Name speichern")" Variant="primary" Type="submit" Disabled="@IsSavingName" />
            </form>
        }
    </Card>
}
else if (_activeActionView == "team_name")
{
    <!-- SUB-VIEW: TEAM NAME SUGGESTIONS & VOTING -->
    <Card Class="settings-card participant-action-card" Style="border-radius: 16px;">
        <div class="participant-action-subview-toolbar">
            <button type="button" @onclick="ReturnToActionMenuAsync" class="participant-action-back">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                <span>Zurück zu Aktionen</span>
            </button>
        </div>

        <h3 style="margin-top: 0; font-size: 17px; font-weight: 800; color: #1d2528;">Teamnamen vorschlagen</h3>
        <p class="framework-help-text" style="font-size: 12px; margin-bottom: 12px;">Schlage einen Namen für dein Team vor! Sobald 50% deines Teams dafür stimmen, wird er automatisch als offizieller Teamname übernommen.</p>

        @if (CanSuggestTeamNames)
        {
            <form class="participant-team-form" @onsubmit="SubmitTeamNameSuggestionAsync" @onsubmit:preventDefault="true" style="display: flex; gap: 8px; margin-bottom: 14px;">
                <div style="flex: 1;">
                    <FrameworkInputText @bind-Value="_newTeamNameInput" Placeholder="Neuer Teamname..." MaxLength="60" />
                </div>
                <FrameworkButton Label="Vorschlagen" Variant="primary" Type="submit" Disabled="@(string.IsNullOrWhiteSpace(_newTeamNameInput))" />
            </form>
        }
        <FrameworkFlexColumn Gap="6px">
            @if (_teamSuggestions.Length == 0)
            {
                <p style="color: #657276; font-size: 12px; text-align: center; margin: 12px 0;">Noch keine Namensvorschläge eingereicht.</p>
            }
            else
            {
                @foreach (var sug in _teamSuggestions)
                {
                    <FrameworkListItem Style="padding: 8px 10px;">
                        <div style="min-width: 0; flex: 1;">
                            <strong style="display: block; font-size: 14px; color: #1d2528;">@sug.SuggestedName</strong>
                            <span style="font-size: 11px; color: #657276;">Von @sug.SubmittedBy &bull; @sug.Votes von @sug.RequiredVotes Stimmen benötigt</span>
                        </div>
                        @if (CanVoteTeamNames)
                        {
                            <button type="button" @onclick="() => ToggleTeamVoteAsync(sug.Id)" style="border: 1px solid @(sug.HasVoted ? "#105c4d" : "#cbd7d3"); background: @(sug.HasVoted ? "#e8f3ef" : "#ffffff"); color: @(sug.HasVoted ? "#105c4d" : "#475569"); border-radius: 6px; padding: 4px 10px; font-weight: 700; font-size: 12px; display: flex; align-items: center; gap: 4px; cursor: pointer; flex-shrink: 0;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">thumb_up</span>
                                <span>@sug.Votes</span>
                            </button>
                        }
                    </FrameworkListItem>
                }
            }
        </FrameworkFlexColumn>
    </Card>
}
else if (_activeActionView == "song_wishes")
{
    <!-- SUB-VIEW: DJ JUKEBOX & SONG WISHES -->
    <Card Class="settings-card participant-action-card" Style="border-radius: 16px;">
        <div class="participant-action-subview-toolbar">
            <button type="button" @onclick="ReturnToActionMenuAsync" class="participant-action-back">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                <span>Zurück zu Aktionen</span>
            </button>
        </div>

        <h3 style="margin-top: 0; font-size: 17px; font-weight: 800; color: #1d2528;">DJ-Jukebox & Musikwünsche</h3>
        <p class="framework-help-text" style="font-size: 12px; margin-bottom: 12px;">Wünsche dir Songs für die Party oder stimme für Songs anderer ab!</p>

        @if (CanSuggestSongs)
        {
            <form @onsubmit="SubmitSongWishAsync" @onsubmit:preventDefault="true" style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px;">
                <FrameworkInputText @bind-Value="_newSongTitleInput" Placeholder="Songtitel..." MaxLength="100" />
                <FrameworkFlexRow Class="participant-song-form-row" Gap="8px">
                    <div style="flex: 1;">
                        <FrameworkInputText @bind-Value="_newSongArtistInput" Placeholder="Künstler (optional)..." MaxLength="100" />
                    </div>
                    <FrameworkButton Label="Wünschen" Variant="primary" Type="submit" Disabled="@(string.IsNullOrWhiteSpace(_newSongTitleInput))" />
                </FrameworkFlexRow>
            </form>
        }
        <FrameworkFlexColumn Gap="6px">
            @if (_songWishes.Length == 0)
            {
                <p style="color: #657276; font-size: 12px; text-align: center; margin: 12px 0;">Noch keine Musikwünsche eingereicht.</p>
            }
            else
            {
                @foreach (var wish in _songWishes)
                {
                    <FrameworkListItem Style="padding: 8px 10px;">
                        <div style="min-width: 0; flex: 1;">
                            <strong style="display: block; font-size: 13px; color: #1d2528; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@wish.SongTitle</strong>
                            <span style="font-size: 11px; color: #657276; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @(string.IsNullOrWhiteSpace(wish.Artist) ? "Unbekannter Künstler" : wish.Artist) &bull; @wish.SubmittedBy
                            </span>
                        </div>
                        @if (CanVoteSongs)
                        {
                            <button type="button" @onclick="() => ToggleSongVoteAsync(wish.Id)" style="border: 1px solid @(wish.HasVoted ? "#105c4d" : "#cbd7d3"); background: @(wish.HasVoted ? "#e8f3ef" : "#ffffff"); color: @(wish.HasVoted ? "#105c4d" : "#475569"); border-radius: 6px; padding: 4px 8px; font-weight: 700; font-size: 12px; display: flex; align-items: center; gap: 4px; cursor: pointer; flex-shrink: 0;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">thumb_up</span>
                                <span>@wish.Votes</span>
                            </button>
                        }
                    </FrameworkListItem>
                }
            }
        </FrameworkFlexColumn>
    </Card>
}
else
{
    <div class="participant-action-menu">
        <section class="participant-action-category">
            <h2 class="mobile-eyebrow">PROFIL</h2>
            @if (CanChangeName)
            {
                <button type="button" class="participant-action-item" @onclick="OpenNameViewAsync">
                    <span class="participant-action-item-icon"><span class="material-symbols-outlined">edit</span></span>
                    <span class="participant-action-item-title">Name ändern</span>
                    <span class="material-symbols-outlined participant-action-chevron">chevron_right</span>
                </button>
            }
        </section>

        <section class="participant-action-category">
            <h2 class="mobile-eyebrow">TEAM & PARTY</h2>
            <button type="button" class="participant-action-item" @onclick="OpenTeamNameViewAsync">
                <span class="participant-action-item-icon"><span class="material-symbols-outlined">lightbulb</span></span>
                <span class="participant-action-item-title">Teamnamen</span>
                <span class="material-symbols-outlined participant-action-chevron">chevron_right</span>
            </button>
            <button type="button" class="participant-action-item" @onclick="OpenSongWishesViewAsync">
                <span class="participant-action-item-icon"><span class="material-symbols-outlined">music_note</span></span>
                <span class="participant-action-item-title">Musikwünsche</span>
                <span class="material-symbols-outlined participant-action-chevron">chevron_right</span>
            </button>
        </section>

        @if (_infoPages.Length > 0)
        {
            <section class="participant-action-category">
                <h2 class="mobile-eyebrow">INFORMATIONEN</h2>
                @foreach (var infoPage in _infoPages)
                {
                    <button type="button" class="participant-action-item" @onclick="() => OpenInfoPage(infoPage)">
                        <span class="participant-action-item-icon"><span class="material-symbols-outlined">@infoPage.Icon</span></span>
                        <span class="participant-action-item-title">@infoPage.Title</span>
                        <span class="material-symbols-outlined participant-action-chevron">chevron_right</span>
                    </button>
                }
            </section>
        }

        <section class="participant-action-category">
            <h2 class="mobile-eyebrow">SITZUNG</h2>
            <button type="button" class="participant-action-item participant-action-logout" @onclick="OnLogout">
                <span class="participant-action-item-icon"><span class="material-symbols-outlined">logout</span></span>
                <span class="participant-action-item-title">Abmelden</span>
                <span class="material-symbols-outlined participant-action-chevron">chevron_right</span>
            </button>
        </section>
    </div>
}
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string AccessToken { get; set; } = string.Empty;
    [Parameter] public string ProjectName { get; set; } = string.Empty;
    [Parameter] public int ParticipantNumber { get; set; }
    [Parameter] public ParticipantPermissions? ParticipantPermissions { get; set; }
    [Parameter] public string NameInput { get; set; } = string.Empty;
    [Parameter] public bool IsSavingName { get; set; }
    [Parameter] public EventCallback<string> NameInputChanged { get; set; }
    [Parameter] public EventCallback OnSaveName { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    private string? _activeActionView;
    private bool _isLeavingAction;
    private ProjectInfoPageDto[] _infoPages = [];
    private ProjectInfoPageDto? _selectedInfoPage;

    private TeamNameSuggestionDto[] _teamSuggestions = [];
    private string _newTeamNameInput = string.Empty;

    private SongWishDto[] _songWishes = [];
    private string _newSongTitleInput = string.Empty;
    private string _newSongArtistInput = string.Empty;
    private bool CanInteract => ParticipantPermissions?.HasPermission(ParticipantPermissionKeys.IsMuted) != false;
    private bool CanChangeName => CanInteract &&
        ParticipantPermissions?.HasPermission(ParticipantPermissionKeys.CanChangeName) != false;
    private bool CanSuggestTeamNames => CanInteract &&
        ParticipantPermissions?.HasPermission(ParticipantPermissionKeys.CanSuggestTeamNames) != false;
    private bool CanVoteTeamNames => CanInteract &&
        ParticipantPermissions?.HasPermission(ParticipantPermissionKeys.CanVoteTeamNames) != false;
    private bool CanSuggestSongs => CanInteract &&
        ParticipantPermissions?.HasPermission(ParticipantPermissionKeys.CanSuggestSongs) != false;
    private bool CanVoteSongs => CanInteract &&
        ParticipantPermissions?.HasPermission(ParticipantPermissionKeys.CanVoteSongs) != false;
    private string ActionViewKey => _selectedInfoPage is not null
        ? $"info:{_selectedInfoPage.Id}"
        : _activeActionView ?? "menu";

    public async Task ReturnToActionMenuAsync()
    {
        if (_activeActionView is null && _selectedInfoPage is null)
        {
            return;
        }

        _isLeavingAction = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(180);
        _activeActionView = null;
        _selectedInfoPage = null;
        _isLeavingAction = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task OpenNameViewAsync()
    {
        _activeActionView = "name";
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInfoPagesAsync();
    }

    private async Task LoadInfoPagesAsync()
    {
        if (string.IsNullOrEmpty(AccessToken)) return;
        try
        {
            _infoPages = await ProjectApiClient.GetInfoPagesAsync(AccessToken, ProjectId);
        }
        catch
        {
            Notifications.Show("Die Event-Informationen konnten nicht geladen werden.", ParticipantToastSeverity.Error);
        }
    }

    private void OpenInfoPage(ProjectInfoPageDto infoPage)
    {
        _selectedInfoPage = infoPage;
        _activeActionView = null;
    }

    private async Task OpenTeamNameViewAsync()
    {
        _activeActionView = "team_name";
        if (!CanSuggestTeamNames && !CanVoteTeamNames)
        {
            Notifications.Show("Vorschläge und Abstimmungen sind für dein Profil gesperrt.", ParticipantToastSeverity.Warning);
        }
        await LoadTeamSuggestionsAsync();
    }

    private async Task LoadTeamSuggestionsAsync()
    {
        if (string.IsNullOrEmpty(AccessToken)) return;
        try
        {
            _teamSuggestions = await ProjectApiClient.GetMyTeamNameSuggestionsAsync(AccessToken, ProjectId);
        }
        catch
        {
            Notifications.Show("Die Teamnamen konnten nicht geladen werden.", ParticipantToastSeverity.Error);
        }
    }

    private async Task SubmitTeamNameSuggestionAsync()
    {
        if (!CanSuggestTeamNames || string.IsNullOrWhiteSpace(_newTeamNameInput) || string.IsNullOrEmpty(AccessToken)) return;
        try
        {
            var text = _newTeamNameInput.Trim();
            _newTeamNameInput = string.Empty;
            await ProjectApiClient.SubmitTeamNameSuggestionAsync(AccessToken, ProjectId, text);
            await LoadTeamSuggestionsAsync();
        }
        catch (Exception ex)
        {
            Notifications.Show(ex.Message, ParticipantToastSeverity.Error);
        }
    }

    private async Task ToggleTeamVoteAsync(Guid suggestionId)
    {
        if (!CanVoteTeamNames || string.IsNullOrEmpty(AccessToken)) return;
        try
        {
            await ProjectApiClient.ToggleTeamNameVoteAsync(AccessToken, ProjectId, suggestionId);
            await LoadTeamSuggestionsAsync();
        }
        catch
        {
            Notifications.Show("Deine Stimme für den Teamnamen konnte nicht gespeichert werden.", ParticipantToastSeverity.Error);
        }
    }

    private async Task OpenSongWishesViewAsync()
    {
        _activeActionView = "song_wishes";
        if (!CanSuggestSongs && !CanVoteSongs)
        {
            Notifications.Show("Musikwünsche und Abstimmungen sind für dein Profil gesperrt.", ParticipantToastSeverity.Warning);
        }
        await LoadSongWishesAsync();
    }

    private async Task LoadSongWishesAsync()
    {
        if (string.IsNullOrEmpty(AccessToken)) return;
        try
        {
            _songWishes = await ProjectApiClient.GetSongWishesAsync(AccessToken, ProjectId);
        }
        catch
        {
            Notifications.Show("Die Musikwünsche konnten nicht geladen werden.", ParticipantToastSeverity.Error);
        }
    }

    private async Task SubmitSongWishAsync()
    {
        if (!CanSuggestSongs || string.IsNullOrWhiteSpace(_newSongTitleInput) || string.IsNullOrEmpty(AccessToken)) return;
        try
        {
            var title = _newSongTitleInput.Trim();
            var artist = _newSongArtistInput.Trim();
            _newSongTitleInput = string.Empty;
            _newSongArtistInput = string.Empty;
            await ProjectApiClient.SubmitSongWishAsync(AccessToken, ProjectId, title, artist);
            await LoadSongWishesAsync();
        }
        catch (Exception ex)
        {
            Notifications.Show(ex.Message, ParticipantToastSeverity.Error);
        }
    }

    private async Task ToggleSongVoteAsync(Guid wishId)
    {
        if (!CanVoteSongs || string.IsNullOrEmpty(AccessToken)) return;
        try
        {
            await ProjectApiClient.ToggleSongWishVoteAsync(AccessToken, ProjectId, wishId);
            await LoadSongWishesAsync();
        }
        catch
        {
            Notifications.Show("Deine Stimme für den Musikwunsch konnte nicht gespeichert werden.", ParticipantToastSeverity.Error);
        }
    }

    private async Task SaveNameAndCloseSubView()
    {
        if (!CanChangeName) return;
        if (OnSaveName.HasDelegate)
        {
            await OnSaveName.InvokeAsync();
        }
        await ReturnToActionMenuAsync();
    }
}
