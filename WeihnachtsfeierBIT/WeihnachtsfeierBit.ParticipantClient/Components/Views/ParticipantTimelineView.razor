@using WeihnachtsfeierBit.Framework

<Card Class="settings-card" Style="margin-bottom: 16px; border: 1.5px solid #dce5e2; border-radius: 12px; padding: 14px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 6px;">
        <div>
            <span class="mobile-eyebrow" style="font-size: 10px;">PROGRAMM & AKTIONEN</span>
            <h3 style="margin: 2px 0 0 0; font-size: 17px; font-weight: 800; color: #1d2528;">Ablauf & Umfragen</h3>
        </div>
        <FrameworkBadge Text="Live Stream" Variant="primary" />
    </div>

    @if ((PassiveEvents is null || !PassiveEvents.Any(e => !e.IsHidden)) && (ScheduledEvents is null || !ScheduledEvents.Any(e => !e.IsHidden)))
    {
        <p style="color: #657276; font-size: 13px; margin: 8px 0;">Derzeit sind keine geplanten Programmpunkte oder aktiven Aktionen verfügbar.</p>
    }
    else
    {
        <div class="vertical-timeline" style="display: flex; flex-direction: column;">
            <!-- 1. ACTIVE / PASSIVE AKTIONEN -->
            @if (PassiveEvents is not null)
            {
                @foreach (var ev in PassiveEvents.Where(e => !e.IsHidden))
                {
                    <div style="display: flex; gap: 12px; align-items: stretch; margin-bottom: 16px; position: relative;">
                        <!-- LEFT TIMELINE COLUMN -->
                        <div style="width: 20px; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; position: relative;">
                            <div style="position: absolute; top: 0; bottom: -16px; width: 3px; background: #cbd7d3; z-index: 1;"></div>
                            <div style="width: 16px; height: 16px; border-radius: 50%; background: #105c4d; border: 3px solid #ffffff; box-shadow: 0 0 0 2px #105c4d; z-index: 2; margin-top: 16px;"></div>
                        </div>

                        <!-- RIGHT CARD ITEM -->
                        <div style="flex: 1; min-width: 0;">
                            <div style="padding: 12px; border: 1.5px solid #105c4d; border-radius: 10px; background: #f0f8f4; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; box-shadow: 0 2px 6px rgba(16, 92, 77, 0.08);">
                                <div style="flex: 1; min-width: 130px;">
                                    <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-bottom: 2px;">
                                        <FrameworkBadge Text="@GetFriendlyTypeName(ev.Slides.Length > 0 ? ev.Slides[0].Type : "announcement")" Variant="@(ev.Slides.Length > 0 ? ev.Slides[0].Type : "announcement")" />
                                        <span style="font-size: 10px; font-weight: 800; color: #105c4d; text-transform: uppercase; display: inline-flex; align-items: center; gap: 3px;">
                                            <span class="material-symbols-outlined" style="font-size: 14px;">play_arrow</span>
                                            <span>JETZT BEREIT</span>
                                        </span>
                                    </div>
                                    <strong style="display: block; margin-top: 4px; font-size: 15px; color: #1d2528; word-break: break-word;">@ev.Title</strong>
                                </div>
                                <div style="flex-shrink: 0;">
                                    <FrameworkButton Label="Öffnen" Variant="primary" OnClick="() => OnSelectPassiveEvent.InvokeAsync(ev)" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- 2. SCHEDULED / KOMMENDE EVENTS -->
            @if (ScheduledEvents is not null)
            {
                var scheduledList = ScheduledEvents.Where(e => !e.IsHidden).ToList();
                @for (int i = 0; i < scheduledList.Count; i++)
                {
                    var ev = scheduledList[i];
                    var isLast = i == scheduledList.Count - 1;
                    var isActiveScheduled = ev.Mode == "active";
                    var isDueSoon = ev.ScheduledStartUtc.HasValue && ev.ScheduledStartUtc.Value <= DateTime.UtcNow.AddMinutes(15);

                    string dotColor = isActiveScheduled ? "#0284c7" : (isDueSoon ? "#d97706" : "#94a3b8");
                    string borderColor = isActiveScheduled ? "#0284c7" : (isDueSoon ? "#d97706" : "#e2e8f0");
                    string bgColor = isActiveScheduled ? "#f0f9ff" : (isDueSoon ? "#fffdf5" : "#ffffff");

                    <div style="display: flex; gap: 12px; align-items: stretch; margin-bottom: 14px; position: relative;">
                        <!-- LEFT TIMELINE COLUMN -->
                        <div style="width: 20px; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; position: relative;">
                            @if (!isLast)
                            {
                                <div style="position: absolute; top: 0; bottom: -14px; width: 3px; background: #cbd7d3; z-index: 1;"></div>
                            }
                            <div style="width: 14px; height: 14px; border-radius: 50%; background: @dotColor; border: 2.5px solid #ffffff; box-shadow: 0 0 0 2px @dotColor; z-index: 2; margin-top: 14px;"></div>
                        </div>

                        <!-- RIGHT CARD ITEM -->
                        <div style="flex: 1; min-width: 0;">
                            <div style="padding: 12px; border: 1.5px solid @borderColor; border-radius: 10px; background: @bgColor; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <div style="flex: 1; min-width: 120px;">
                                    <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-bottom: 2px;">
                                        @if (isActiveScheduled)
                                        {
                                            <span style="font-size: 10px; font-weight: 800; color: #0284c7; text-transform: uppercase; display: inline-flex; align-items: center; gap: 3px;">
                                                <span class="material-symbols-outlined" style="font-size: 14px;">schedule</span>
                                                <span>AKTIVES GEPLANTES EVENT</span>
                                            </span>
                                        }
                                        else if (isDueSoon)
                                        {
                                            <span style="font-size: 10px; font-weight: 800; color: #d97706; text-transform: uppercase; display: inline-flex; align-items: center; gap: 3px;">
                                                <span class="material-symbols-outlined" style="font-size: 14px;">schedule</span>
                                                <span>BALD FÄLLIG</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase;">GEPLANT</span>
                                        }
                                    </div>
                                    <strong style="display: block; font-size: 15px; color: #1e293b; word-break: break-word;">@ev.Title</strong>
                                    <span style="font-size: 12px; color: #64748b;">
                                        @(ev.Slides.Length > 1 ? $"Show ({ev.Slides.Length} Folien)" : "Event")
                                    </span>
                                </div>
                                <div style="flex-shrink: 0;">
                                    <FrameworkBadge Text="@(ev.ScheduledStartUtc.HasValue ? ev.ScheduledStartUtc.Value.ToLocalTime().ToString("HH:mm") + " Uhr" : "Geplant")" Variant="@(isActiveScheduled ? "primary" : (isDueSoon ? "warning" : "secondary"))" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</Card>

@code {
    [Parameter] public EventState[] PassiveEvents { get; set; } = [];
    [Parameter] public EventState[] ScheduledEvents { get; set; } = [];
    [Parameter] public EventCallback<EventState> OnSelectPassiveEvent { get; set; }

    private static string GetFriendlyTypeName(string type) => type.ToLowerInvariant() switch
    {
        "announcement" => "Ankündigung",
        "poll" => "Abstimmung",
        "quiz" => "Quiz",
        "estimation" => "Schätzfrage",
        "buzzer" => "Buzzer",
        "ranking" => "Rangliste",
        _ => "Event"
    };
}
