@using WeihnachtsfeierBit.Framework

<Card Class="settings-card" Style="margin-bottom: 8px; border: 1.5px solid #dce5e2; border-radius: 12px; padding: 8px 10px;">
    <div style="margin-bottom: 8px;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: #1d2528;">PROGRAMM</h3>
    </div>

    @if ((PassiveEvents is null || !PassiveEvents.Any(e => !e.IsHidden)) && (ScheduledEvents is null || !ScheduledEvents.Any(e => !e.IsHidden)))
    {
        <p style="color: #657276; font-size: 12px; margin: 4px 0;">Derzeit sind keine geplanten Programmpunkte oder aktiven Aktionen verfügbar.</p>
    }
    else
    {
        <FrameworkFlexColumn Class="vertical-timeline" Gap="8px">
            <!-- 1. ACTIVE / PASSIVE AKTIONEN -->
            @if (PassiveEvents is not null)
            {
                @foreach (var ev in PassiveEvents.Where(e => !e.IsHidden))
                {
                    <FrameworkFlexRow Align="stretch" Gap="8px" Style="position: relative;">
                        <!-- LEFT TIMELINE COLUMN -->
                        <div style="width: 16px; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; position: relative;">
                            <div style="position: absolute; top: 0; bottom: -8px; width: 2px; background: #cbd7d3; z-index: 1;"></div>
                            <div style="width: 12px; height: 12px; border-radius: 50%; background: #105c4d; border: 2px solid #ffffff; box-shadow: 0 0 0 2px #105c4d; z-index: 2; margin-top: 10px;"></div>
                        </div>

                        <!-- RIGHT CARD ITEM -->
                        <div style="flex: 1; min-width: 0;">
                            <div style="padding: 8px 10px; border: 1.5px solid #105c4d; border-radius: 8px; background: #f0f8f4; display: flex; justify-content: space-between; align-items: center; gap: 6px; flex-wrap: wrap; box-shadow: 0 2px 4px rgba(16, 92, 77, 0.06);">
                                <div style="flex: 1; min-width: 110px;">
                                    <!-- LÄUFT BADGE ABOVE TITLE -->
                                    <div style="margin-bottom: 2px;">
                                        <span style="font-size: 9px; font-weight: 800; color: #105c4d; text-transform: uppercase; display: inline-flex; align-items: center; gap: 2px;">
                                            <span class="material-symbols-outlined" style="font-size: 13px;">play_arrow</span>
                                            <span>LÄUFT</span>
                                        </span>
                                    </div>
                                    <strong style="display: block; font-size: 13px; color: #1d2528; word-break: break-word;">@ev.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(ev.Subtitle))
                                    {
                                        <span style="font-size: 11px; color: #657276; display: block; margin-top: 2px; word-break: break-word;">@ev.Subtitle</span>
                                    }
                                </div>
                                <div style="flex-shrink: 0;">
                                    <FrameworkButton Label="Öffnen" Variant="primary" OnClick="() => OnSelectPassiveEvent.InvokeAsync(ev)" />
                                </div>
                            </div>
                        </div>
                    </FrameworkFlexRow>
                }
            }

            <!-- 2. SCHEDULED / KOMMENDE EVENTS -->
            @if (ScheduledEvents is not null)
            {
                var scheduledList = ScheduledEvents.Where(e => !e.IsHidden).ToList();
                @for (int i = 0; i < scheduledList.Count; i++)
                {
                    var ev = scheduledList[i];
                    var isLast = i == scheduledList.Count - 1;
                    var isActiveScheduled = ev.Mode == "active";
                    var isDueSoon = ev.ScheduledStartUtc.HasValue && ev.ScheduledStartUtc.Value <= DateTime.UtcNow.AddMinutes(15);

                    string dotColor = isActiveScheduled ? "#0284c7" : (isDueSoon ? "#d97706" : "#94a3b8");
                    string borderColor = isActiveScheduled ? "#0284c7" : (isDueSoon ? "#d97706" : "#e2e8f0");
                    string bgColor = isActiveScheduled ? "#f0f9ff" : (isDueSoon ? "#fffdf5" : "#ffffff");

                    <FrameworkFlexRow Align="stretch" Gap="8px" Style="position: relative;">
                        <!-- LEFT TIMELINE COLUMN -->
                        <div style="width: 16px; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; position: relative;">
                            @if (!isLast)
                            {
                                <div style="position: absolute; top: 0; bottom: -8px; width: 2px; background: #cbd7d3; z-index: 1;"></div>
                            }
                            <div style="width: 11px; height: 11px; border-radius: 50%; background: @dotColor; border: 2px solid #ffffff; box-shadow: 0 0 0 2px @dotColor; z-index: 2; margin-top: 10px;"></div>
                        </div>

                        <!-- RIGHT CARD ITEM -->
                        <div style="flex: 1; min-width: 0;">
                            <div style="padding: 8px 10px; border: 1.5px solid @borderColor; border-radius: 8px; background: @bgColor; display: flex; justify-content: space-between; align-items: center; gap: 6px; flex-wrap: wrap;">
                                <div style="flex: 1; min-width: 110px;">
                                    <!-- BADGE ABOVE TITLE -->
                                    <div style="margin-bottom: 2px;">
                                        @if (isActiveScheduled)
                                        {
                                            <span style="font-size: 9px; font-weight: 800; color: #0284c7; text-transform: uppercase; display: inline-flex; align-items: center; gap: 2px;">
                                                <span class="material-symbols-outlined" style="font-size: 13px;">schedule</span>
                                                <span>AKTIV GEPLANT</span>
                                            </span>
                                        }
                                        else if (isDueSoon)
                                        {
                                            <span style="font-size: 9px; font-weight: 800; color: #d97706; text-transform: uppercase; display: inline-flex; align-items: center; gap: 2px;">
                                                <span class="material-symbols-outlined" style="font-size: 13px;">schedule</span>
                                                <span>STARTET BALD</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 9px; font-weight: 700; color: #64748b; text-transform: uppercase;">GEPLANT</span>
                                        }
                                    </div>
                                    <strong style="display: block; font-size: 13px; color: #1e293b; word-break: break-word;">@ev.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(ev.Subtitle))
                                    {
                                        <span style="font-size: 11px; color: #64748b; display: block; margin-top: 2px; word-break: break-word;">@ev.Subtitle</span>
                                    }
                                </div>
                                <div style="flex-shrink: 0;">
                                    <FrameworkBadge Text="@(ev.ScheduledStartUtc.HasValue ? ev.ScheduledStartUtc.Value.ToLocalTime().ToString("HH:mm") + " Uhr" : "Geplant")" Variant="@(isActiveScheduled ? "primary" : (isDueSoon ? "warning" : "secondary"))" />
                                </div>
                            </div>
                        </div>
                    </FrameworkFlexRow>
                }
            }
        </FrameworkFlexColumn>
    }
</Card>

@code {
    [Parameter] public EventState[] PassiveEvents { get; set; } = [];
    [Parameter] public EventState[] ScheduledEvents { get; set; } = [];
    [Parameter] public EventCallback<EventState> OnSelectPassiveEvent { get; set; }

    private static string GetFriendlyTypeName(string type) => type.ToLowerInvariant() switch
    {
        "announcement" => "Ankündigung",
        "poll" => "Abstimmung",
        "quiz" => "Quiz",
        "estimation" => "Schätzfrage",
        "buzzer" => "Buzzer",
        "ranking" => "Rangliste",
        _ => "Event"
    };
}
