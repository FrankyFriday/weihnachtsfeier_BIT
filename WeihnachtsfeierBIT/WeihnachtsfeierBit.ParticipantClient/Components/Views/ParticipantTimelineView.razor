@using WeihnachtsfeierBit.Framework

<Card Class="settings-card" Style="margin-bottom: 8px; border: 1.5px solid #dce5e2; border-radius: 12px; padding: 8px 10px;">
    <div style="margin-bottom: 8px;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: #1d2528;">PROGRAMM</h3>
    </div>

    @{
        var timelineEntries = TimelineEntries;
    }

    @if (timelineEntries.Length == 0)
    {
        <p style="color: #657276; font-size: 12px; margin: 4px 0;">Derzeit sind keine geplanten Programmpunkte oder aktiven Aktionen verfügbar.</p>
    }
    else
    {
        <FrameworkFlexColumn Class="vertical-timeline participant-programme-list" Gap="8px">
            @for (var index = 0; index < timelineEntries.Length; index++)
            {
                var entry = timelineEntries[index];
                var ev = entry.Event;
                var isScheduled = entry.IsScheduled;
                var isLast = index == timelineEntries.Length - 1;
                var isActiveScheduled = isScheduled && ev.Mode == "active";
                var isDueSoon = isScheduled && ev.ScheduledStartUtc.HasValue && ev.ScheduledStartUtc.Value <= DateTime.UtcNow.AddMinutes(15);
                var dotColor = !isScheduled ? "#105c4d" : isActiveScheduled ? "#0284c7" : isDueSoon ? "#d97706" : "#94a3b8";
                var borderColor = !isScheduled ? "#105c4d" : isActiveScheduled ? "#0284c7" : isDueSoon ? "#d97706" : "#e2e8f0";
                var bgColor = !isScheduled ? "#f0f8f4" : isActiveScheduled ? "#f0f9ff" : isDueSoon ? "#fffdf5" : "#ffffff";

                <FrameworkFlexRow Class="participant-timeline-item" Align="stretch" Gap="8px">
                    <div class="participant-timeline-rail">
                        @if (!isLast)
                        {
                            <div class="participant-timeline-line"></div>
                        }
                        <div class="participant-timeline-marker" style="background: @dotColor; box-shadow: 0 0 0 2px @dotColor;"></div>
                    </div>

                    <div style="flex: 1; min-width: 0;">
                        <div style="padding: 8px 10px; border: 1.5px solid @borderColor; border-radius: 8px; background: @bgColor; display: flex; justify-content: space-between; align-items: center; gap: 6px; flex-wrap: wrap; box-shadow: 0 2px 4px rgba(16, 92, 77, 0.06);">
                            <div style="flex: 1; min-width: 110px;">
                                <div style="margin-bottom: 2px;">
                                    @if (!isScheduled)
                                    {
                                        <span style="font-size: 9px; font-weight: 800; color: #105c4d; text-transform: uppercase; display: inline-flex; align-items: center; gap: 2px;">
                                            <span class="material-symbols-outlined" style="font-size: 13px;">play_arrow</span>
                                            <span>LÄUFT</span>
                                        </span>
                                    }
                                    else if (isActiveScheduled)
                                    {
                                        <span style="font-size: 9px; font-weight: 800; color: #0284c7; text-transform: uppercase; display: inline-flex; align-items: center; gap: 2px;">
                                            <span class="material-symbols-outlined" style="font-size: 13px;">schedule</span>
                                            <span>AKTIV GEPLANT</span>
                                        </span>
                                    }
                                    else if (isDueSoon)
                                    {
                                        <span style="font-size: 9px; font-weight: 800; color: #d97706; text-transform: uppercase; display: inline-flex; align-items: center; gap: 2px;">
                                            <span class="material-symbols-outlined" style="font-size: 13px;">schedule</span>
                                            <span>STARTET BALD</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 9px; font-weight: 700; color: #64748b; text-transform: uppercase;">GEPLANT</span>
                                    }
                                </div>
                                <strong style="display: block; font-size: 13px; color: #1d2528; word-break: break-word;">@ev.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(ev.Subtitle))
                                {
                                    <span style="font-size: 11px; color: #64748b; display: block; margin-top: 2px; word-break: break-word;">@ev.Subtitle</span>
                                }
                            </div>
                            @if (isScheduled)
                            {
                                <div style="flex-shrink: 0;">
                                    <FrameworkBadge Text="@(ev.ScheduledStartUtc.HasValue ? ev.ScheduledStartUtc.Value.ToLocalTime().ToString("HH:mm") + " Uhr" : "Geplant")" Variant="@(isActiveScheduled ? "primary" : (isDueSoon ? "warning" : "secondary"))" />
                                </div>
                            }
                            else
                            {
                                <div style="flex-shrink: 0;">
                                    <FrameworkButton Label="Öffnen" Variant="primary" OnClick="() => OnSelectPassiveEvent.InvokeAsync(ev)" />
                                </div>
                            }
                        </div>
                    </div>
                </FrameworkFlexRow>
            }
        </FrameworkFlexColumn>
    }
</Card>

@code {
    [Parameter] public EventState[] PassiveEvents { get; set; } = [];
    [Parameter] public EventState[] ScheduledEvents { get; set; } = [];
    [Parameter] public EventCallback<EventState> OnSelectPassiveEvent { get; set; }

    private (EventState Event, bool IsScheduled)[] TimelineEntries =>
        (PassiveEvents ?? [])
            .Where(e => !e.IsHidden)
            .Select(e => (Event: e, IsScheduled: false))
            .Concat((ScheduledEvents ?? [])
                .Where(e => !e.IsHidden)
                .OrderBy(e => e.ScheduledStartUtc ?? DateTime.MaxValue)
                .Select(e => (Event: e, IsScheduled: true)))
            .ToArray();
}
