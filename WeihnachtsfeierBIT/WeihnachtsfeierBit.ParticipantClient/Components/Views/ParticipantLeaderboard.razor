@using WeihnachtsfeierBit.Framework

@if (AllTeams.Length > 0)
{
    <Card Class="settings-card" Style="border-radius: 12px; padding: 14px;">
        <h3 style="margin: 0; font-size: 16px;">Gesamtrangliste</h3>
        <div style="display: grid; gap: 8px; margin-top: 10px;">
            @foreach (var team in AllTeams)
            {
                <div style="padding: 10px 12px; border: 1px solid #dce5e2; border-radius: 8px; background: @(team.Id == MyTeamId ? "#f0f8f4" : "#fff"); display: flex; align-items: center; gap: 10px;">
                    <span style="font-weight: 800; width: 22px; color: #105c4d; font-size: 14px;">#@team.Rank</span>
                    <span style="width: 12px; height: 12px; border-radius: 50%; background-color: @team.Color; display: inline-block; flex-shrink: 0;"></span>
                    <span style="flex: 1; font-weight: 700; color: #1d2528; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@team.DisplayName</span>
                    <strong style="color: #105c4d; font-size: 15px; flex-shrink: 0;">@team.Points Pkt.</strong>
                </div>
            }
        </div>
    </Card>
}

@code {
    [Parameter] public TeamState[] AllTeams { get; set; } = [];
    [Parameter] public Guid? MyTeamId { get; set; }
}
