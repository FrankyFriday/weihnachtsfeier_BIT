<section class="canvas-slide canvas-slide-poll">
    <h2>@CanvasSlideData.ReadString(Parameters, "question", Event.Title)</h2>
    <div class="canvas-poll-options">
        @foreach (var (option, index) in CanvasSlideData.ReadStringArray(Parameters, "options").Select((value, index) => (value, index)))
        {
            <div class="canvas-poll-option" style="--canvas-stagger: @(index * 70)ms">
                <span class="canvas-option-letter">@((char)('A' + index))</span>
                <span>@option</span>
            </div>
        }
    </div>
</section>

@inherits CanvasSlideRendererBase
