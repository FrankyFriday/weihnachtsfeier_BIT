@using System.Globalization
@implements IDisposable

@{
    var duration = Math.Max(0, CanvasSlideData.ReadInt(Parameters, "seconds", 60));
    var remaining = Math.Max(0, duration - _elapsedSeconds);
}

<section class="canvas-slide canvas-slide-countdown">
    <h2>@CanvasSlideData.ReadString(Parameters, "title", Event.Title)</h2>
    <div class="canvas-countdown-value">@FormatSeconds(remaining)</div>
    @if (!string.IsNullOrWhiteSpace(CanvasSlideData.ReadString(Parameters, "message")))
    {
        <p class="canvas-slide-copy">@CanvasSlideData.ReadString(Parameters, "message")</p>
    }
    <CanvasTimerBar RemainingSeconds="remaining"
                    TotalSeconds="duration"
                    IsPaused="Event.IsPaused"
                    Label="COUNTDOWN" />
</section>

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private Task? _timerTask;
    private int _elapsedSeconds;

    protected override void OnInitialized()
    {
        UpdateElapsed();
        _timerTask = UpdateTimerAsync(_cancellation.Token);
    }

    protected override void OnParametersSet() => UpdateElapsed();

    private void UpdateElapsed()
    {
        var elapsed = Event.AccumulatedElapsedSeconds;
        if (!Event.IsPaused)
        {
            var resumedAt = Event.LastResumedAtUtc ?? Event.StartedAtUtc;
            if (resumedAt != default)
            {
                elapsed += Math.Max(0, (int)(DateTime.UtcNow - resumedAt).TotalSeconds);
            }
        }

        _elapsedSeconds = Math.Max(0, elapsed);
    }

    private async Task UpdateTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!Event.IsPaused)
                {
                    UpdateElapsed();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string FormatSeconds(int seconds) =>
        TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(@"mm\:ss", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}

@inherits CanvasSlideRendererBase
