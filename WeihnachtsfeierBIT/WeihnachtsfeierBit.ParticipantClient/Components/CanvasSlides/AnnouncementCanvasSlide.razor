    <h2>@CanvasSlideData.ReadString(Parameters, "title", Event.Title)</h2>
    <p class="canvas-slide-copy">@CanvasSlideData.ReadString(Parameters, "message")</p>
</section>

@inherits CanvasSlideRendererBase
