@using System.Text.Json
@using WeihnachtsfeierBit.Framework

<div class="mobile-card">
    <div class="mobile-card-header">
        <span class="mobile-eyebrow">SCHÄTZFRAGE</span>
        <h1>@ReadString(Event.Parameters, "question")</h1>
    </div>

    @if (_submitted)
    {
        <div class="mobile-alert success">Dein Schätzwert von @_estimationInput @ReadString(Event.Parameters, "unit") wurde gespeichert!</div>
    }
    else
    {
        <form @onsubmit="SubmitEstimation" @onsubmit:preventDefault="true" class="mobile-form" style="margin-top: 16px;">
            <div class="mobile-field">
                <label for="est-val">Dein Schätzwert (@ReadString(Event.Parameters, "unit"))</label>
                <input id="est-val" type="number" step="any" class="mobile-input large-text" @bind="_estimationInput" required />
            </div>
            <button type="submit" class="mobile-button primary" disabled="@_isSubmitting">
                Schätzung abgeben
            </button>
        </form>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Inject] private ProjectApiClient ProjectApiClient { get; set; } = null!;

    private double _estimationInput;
    private bool _submitted;
    private bool _isSubmitting;

    private async Task SubmitEstimation()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            if (!string.IsNullOrEmpty(AccessToken))
            {
                var payload = JsonSerializer.SerializeToElement(new { estimationValue = _estimationInput });
                await ProjectApiClient.SubmitEventResponseAsync(AccessToken, ProjectId, Event.EventId, payload);
            }
            _submitted = true;
        }
        catch
        {
            _submitted = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ReadString(JsonElement elem, string prop) =>
        elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.String
            ? val.GetString() ?? string.Empty
            : string.Empty;
}
