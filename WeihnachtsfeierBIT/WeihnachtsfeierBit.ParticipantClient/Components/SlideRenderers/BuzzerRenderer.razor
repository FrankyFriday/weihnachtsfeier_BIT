@using System.Text.Json
@inject IJSRuntime JS

<div style="flex: 1; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px; box-sizing: border-box; text-align: center; background: #ffffff;">
    <span class="mobile-eyebrow" style="margin-bottom: 12px; font-size: 14px;">BUZZER-RUNDE</span>
    <h1 style="font-size: 28px; font-weight: 800; margin: 0 0 32px 0; color: #1d2528; max-width: 500px;">@ReadString(CurrentSlide.Parameters, "question")</h1>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mobile-alert error" style="font-size: 15px; padding: 12px 16px; margin-bottom: 16px;">@_errorMessage</div>
    }

    @if (_buzzed)
    {
        <div class="mobile-alert success" style="font-size: 22px; padding: 28px 40px; display: flex; align-items: center; gap: 8px; justify-content: center;">
            <span class="material-symbols-outlined" style="font-size: 28px;">check_circle</span>
            <span>Du hast gebuzzert!</span>
        </div>
    }
    else
    {
        <div style="display: flex; justify-content: center;">
            <button type="button" class="buzzer-button-animated" @onclick="SubmitBuzzer" disabled="@_isSubmitting" style="width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, #ef4444 0%, #dc2626 100%); color: #fff; font-size: 28px; font-weight: 800; border: none; cursor: pointer;">
                BUZZER!
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ParticipantId { get; set; }
    [Inject] private ProjectApiClient ProjectApiClient { get; set; } = null!;

    private bool _buzzed;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override void OnParametersSet()
    {
        CheckExistingResponse();
    }

    private void CheckExistingResponse()
    {
        if (ParticipantId == Guid.Empty) return;

        var myResp = Event.Responses.FirstOrDefault(r => r.SlideId == CurrentSlide.SlideId && r.ParticipantId == ParticipantId);
        if (myResp is not null)
        {
            _buzzed = true;
        }
        else
        {
            _buzzed = false;
        }
    }

    private async Task SubmitBuzzer()
    {
        if (_isSubmitting) return;
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            try
            {
                await JS.InvokeVoidAsync("eval", "navigator.vibrate && navigator.vibrate([100, 50, 100])");
            }
            catch
            {
            }

            if (!string.IsNullOrEmpty(AccessToken))
            {
                var payload = JsonSerializer.SerializeToElement(new { buzzedAtUtc = DateTime.UtcNow });
                await ProjectApiClient.SubmitEventResponseAsync(AccessToken, ProjectId, Event.EventId, CurrentSlide.SlideId, payload);
                _buzzed = true;
            }
            else
            {
                _errorMessage = "Keine aktive Sitzung vorhanden.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Fehler beim Übertragen: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ReadString(JsonElement elem, string prop) =>
        elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.String
            ? val.GetString() ?? string.Empty
            : string.Empty;
}
