@using System.Text.Json

<div style="flex: 1; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px; box-sizing: border-box; text-align: center; background: #ffffff;">
    <span class="mobile-eyebrow" style="margin-bottom: 12px; font-size: 14px;">ABSTIMMUNG</span>
    <h1 style="font-size: 28px; font-weight: 800; margin: 0 0 24px 0; color: #1d2528; max-width: 500px;">@ReadString(CurrentSlide.Parameters, "question")</h1>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mobile-alert error" style="font-size: 15px; padding: 12px 16px; margin-bottom: 16px;">@_errorMessage</div>
    }

    @if (_submitted && !AllowChangeVote)
    {
        <div class="mobile-alert success" style="font-size: 18px; padding: 20px;">
            Deine Stimme für "<strong>@_selectedOption</strong>" wurde abgegeben!
        </div>
    }
    else
    {
        @if (_submitted && AllowChangeVote)
        {
            <div style="margin-bottom: 16px; font-size: 14px; color: #105c4d; font-weight: 700;">
                Gewählt: "@_selectedOption" • Klicke eine andere Option, um deine Meinung zu ändern.
            </div>
        }

        <div style="display: grid; gap: 12px; width: 100%; max-width: 450px;">
            @foreach (var opt in ReadStringList(CurrentSlide.Parameters, "options"))
            {
                var isSelected = string.Equals(opt, _selectedOption, StringComparison.Ordinal);
                <button type="button" class="mobile-button @(isSelected ? "primary" : "secondary")" @onclick="() => SubmitPoll(opt)" disabled="@_isSubmitting" style="min-height: 56px; font-size: 18px; font-weight: 700; border: @(isSelected ? "3px solid #105c4d" : "none");">
                    @(isSelected ? "✓ " : "")@opt
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ParticipantId { get; set; }
    [Inject] private ProjectApiClient ProjectApiClient { get; set; } = null!;

    private bool _submitted;
    private string? _selectedOption;
    private bool _isSubmitting;
    private string? _errorMessage;

    private bool AllowChangeVote => ReadBool(CurrentSlide.Parameters, "allowChangeVote", defaultValue: true);

    protected override void OnParametersSet()
    {
        CheckExistingResponse();
    }

    private void CheckExistingResponse()
    {
        if (ParticipantId == Guid.Empty) return;

        var myResp = Event.Responses.FirstOrDefault(r => r.SlideId == CurrentSlide.SlideId && r.ParticipantId == ParticipantId);
        if (myResp is not null && myResp.ResponseData.ValueKind == JsonValueKind.Object)
        {
            if (myResp.ResponseData.TryGetProperty("selectedOption", out var optVal) && optVal.ValueKind == JsonValueKind.String)
            {
                _selectedOption = optVal.GetString();
                _submitted = !string.IsNullOrEmpty(_selectedOption);
            }
        }
        else
        {
            _submitted = false;
            _selectedOption = null;
        }
    }

    private async Task SubmitPoll(string option)
    {
        if (_isSubmitting) return;
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            if (!string.IsNullOrEmpty(AccessToken))
            {
                var payload = JsonSerializer.SerializeToElement(new { selectedOption = option });
                await ProjectApiClient.SubmitEventResponseAsync(AccessToken, ProjectId, Event.EventId, CurrentSlide.SlideId, payload);
                _selectedOption = option;
                _submitted = true;
            }
            else
            {
                _errorMessage = "Keine aktive Sitzung vorhanden.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Fehler beim Übertragen: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ReadString(JsonElement elem, string prop) =>
        elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.String
            ? val.GetString() ?? string.Empty
            : string.Empty;

    private static bool ReadBool(JsonElement elem, string prop, bool defaultValue = false) =>
        elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var val) && (val.ValueKind == JsonValueKind.True || val.ValueKind == JsonValueKind.False)
            ? val.GetBoolean()
            : defaultValue;

    private static List<string> ReadStringList(JsonElement elem, string prop)
    {
        var list = new List<string>();
        if (elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var arr) && arr.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in arr.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String)
                {
                    list.Add(item.GetString() ?? string.Empty);
                }
            }
        }
        return list;
    }
}
