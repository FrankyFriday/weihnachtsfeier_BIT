@using System.Text.Json
@inject ParticipantNotificationService Notifications

<div style="flex: 1; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px; box-sizing: border-box; text-align: center; background: #ffffff;">
    <span class="mobile-eyebrow" style="margin-bottom: 12px; font-size: 14px;">QUIZ-FRAGE</span>
    <h1 style="font-size: 28px; font-weight: 800; margin: 0 0 24px 0; color: #1d2528; max-width: 500px;">@ReadString(CurrentSlide.Parameters, "question")</h1>

    @if (_submitted)
    {
        <div style="font-size: 14px; color: #536164; text-align: center;">
            @if (_selectedAnswerText is not null)
            {
                <div style="font-size: 16px; margin-top: 8px; color: #1d2528; font-weight: 700;">Deine Auswahl: @_selectedAnswerText</div>
            }
        </div>
    }
    else
    {
        <div style="display: grid; gap: 12px; width: 100%; max-width: 450px;">
            @for (int i = 0; i < ReadStringList(CurrentSlide.Parameters, "answers").Count; i++)
            {
                var index = i;
                var ans = ReadStringList(CurrentSlide.Parameters, "answers")[index];
                <button type="button" class="mobile-button secondary" @onclick="() => SubmitQuiz(index)" disabled="@_isSubmitting" style="min-height: 52px; font-size: 17px; font-weight: 700;">
                    @(index + 1). @ans
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ParticipantId { get; set; }
    [Inject] private ProjectApiClient ProjectApiClient { get; set; } = null!;

    private bool _submitted;
    private string? _selectedAnswerText;
    private bool _isSubmitting;

    protected override void OnParametersSet()
    {
        CheckExistingResponse();
    }

    private void CheckExistingResponse()
    {
        if (ParticipantId == Guid.Empty) return;

        var myResp = Event.Responses.FirstOrDefault(r => r.SlideId == CurrentSlide.SlideId && r.ParticipantId == ParticipantId);
        if (myResp is not null && myResp.ResponseData.ValueKind == JsonValueKind.Object)
        {
            if (myResp.ResponseData.TryGetProperty("answerIndex", out var ansVal) && ansVal.ValueKind == JsonValueKind.Number)
            {
                int ansIdx = ansVal.GetInt32();
                var answers = ReadStringList(CurrentSlide.Parameters, "answers");
                if (ansIdx >= 0 && ansIdx < answers.Count)
                {
                    _selectedAnswerText = $"{ansIdx + 1}. {answers[ansIdx]}";
                }
                _submitted = true;
            }
        }
        else
        {
            _submitted = false;
            _selectedAnswerText = null;
        }
    }

    private async Task SubmitQuiz(int answerIndex)
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            if (!string.IsNullOrEmpty(AccessToken))
            {
                var payload = JsonSerializer.SerializeToElement(new { answerIndex });
                await ProjectApiClient.SubmitEventResponseAsync(AccessToken, ProjectId, Event.EventId, CurrentSlide.SlideId, payload);
                var answers = ReadStringList(CurrentSlide.Parameters, "answers");
                if (answerIndex >= 0 && answerIndex < answers.Count)
                {
                    _selectedAnswerText = $"{answerIndex + 1}. {answers[answerIndex]}";
                }
                _submitted = true;
                Notifications.Show("Deine Antwort wurde eingereicht!", ParticipantToastSeverity.Success);
            }
            else
            {
                Notifications.Show("Keine aktive Sitzung vorhanden.", ParticipantToastSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Notifications.Show("Fehler beim Übertragen: " + ex.Message, ParticipantToastSeverity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ReadString(JsonElement elem, string prop) =>
        elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.String
            ? val.GetString() ?? string.Empty
            : string.Empty;

    private static List<string> ReadStringList(JsonElement elem, string prop)
    {
        var list = new List<string>();
        if (elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var arr) && arr.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in arr.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String)
                {
                    list.Add(item.GetString() ?? string.Empty);
                }
            }
        }
        return list;
    }
}
