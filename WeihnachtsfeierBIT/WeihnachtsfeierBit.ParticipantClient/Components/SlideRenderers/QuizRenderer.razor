@using System.Text.Json
@using WeihnachtsfeierBit.Framework

<div class="mobile-card">
    <div class="mobile-card-header">
        <span class="mobile-eyebrow">QUIZ-FRAGE</span>
        <h1>@ReadString(Event.Parameters, "question")</h1>
    </div>

    @if (_submitted)
    {
        <div class="mobile-alert success">Deine Antwort wurde abgegeben!</div>
    }
    else
    {
        <div style="display: grid; gap: 10px; margin-top: 16px;">
            @for (int i = 0; i < ReadStringList(Event.Parameters, "answers").Count; i++)
            {
                var index = i;
                var ans = ReadStringList(Event.Parameters, "answers")[index];
                <button type="button" class="mobile-button secondary" @onclick="() => SubmitQuiz(index)" disabled="@_isSubmitting">
                    @(index + 1). @ans
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Inject] private ProjectApiClient ProjectApiClient { get; set; } = null!;

    private bool _submitted;
    private bool _isSubmitting;

    private async Task SubmitQuiz(int answerIndex)
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            if (!string.IsNullOrEmpty(AccessToken))
            {
                var payload = JsonSerializer.SerializeToElement(new { answerIndex });
                await ProjectApiClient.SubmitEventResponseAsync(AccessToken, ProjectId, Event.EventId, payload);
            }
            _submitted = true;
        }
        catch
        {
            _submitted = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ReadString(JsonElement elem, string prop) =>
        elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var val) && val.ValueKind == JsonValueKind.String
            ? val.GetString() ?? string.Empty
            : string.Empty;

    private static List<string> ReadStringList(JsonElement elem, string prop)
    {
        var list = new List<string>();
        if (elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty(prop, out var arr) && arr.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in arr.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String)
                {
                    list.Add(item.GetString() ?? string.Empty);
                }
            }
        }
        return list;
    }
}
