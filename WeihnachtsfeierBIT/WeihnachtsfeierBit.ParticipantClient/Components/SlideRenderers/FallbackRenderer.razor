@using WeihnachtsfeierBit.Framework

<div style="flex: 1; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 32px; box-sizing: border-box; text-align: center; background: #ffffff;">
    <h2 style="font-size: 24px; color: #1d2528;">Unbekannter Slide-Typ '@CurrentSlide.Type'</h2>
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
}
