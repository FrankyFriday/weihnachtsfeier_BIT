@using System.Text.Json
@using WeihnachtsfeierBit.Framework

<section style="display:flex;flex:1;min-height:0;flex-direction:column;align-items:center;overflow:auto;padding:24px 16px;background:#f6f8f7;color:#17211f;text-align:center;">
    <span class="mobile-eyebrow">HITSTER</span>
    <h1 style="margin:8px 0 4px;font-size:28px;">@ReadString(CurrentSlide.Parameters, "title", "Hitster")</h1>
    <p style="max-width:520px;color:#52615d;">@ReadString(CurrentSlide.Parameters, "instructions", "Ordnet den Song in die Zeitleiste ein.")</p>
    <button class="mobile-button secondary" style="margin-bottom:12px;" @onclick="() => _showTeamChat = true">
        Team-Chat öffnen
    </button>

    @if (GameStarted)
    {
        @if (Finished)
        {
            <div class="mobile-alert success">
                @if (WinnerNames.Length > 0)
                {
                    <span>Spiel beendet! @string.Join(", ", WinnerNames) gewinnt.</span>
                }
                else
                {
                    <span>Spiel beendet.</span>
                }
            </div>
        }
        else
        {
            <p style="font-weight:700;">Runde @ReadInt(Game, "round") · @ReadString(Game, "currentTeamName") ist dran</p>
        }

        @if (ReadString(Game, "phase") == "playing" && !Finished)
        {
            @if (IsMyTurn)
            {
                <p>Wo gehört der Song in die Zeitleiste?</p>
                <div class="mobile-alert">
                    @ReadInt(VoteSummary, "submittedVotes") von @ReadInt(VoteSummary, "eligibleVoters") Teammitgliedern haben abgestimmt.
                    Noch offen: @ReadInt(VoteSummary, "remainingVotes").
                    Stimmen können bis zum Aufdecken geändert werden; bei Gleichstand zählt die früheste Position.
                </div>
                @if (HasGuess)
                {
                    <div class="mobile-alert">Die Abstimmung ist beendet. Die Spielleitung deckt den Song gleich auf.</div>
                }
                else
                {
                    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px;max-width:720px;">
                        @for (var index = 0; index <= MyTimeline.Length; index++)
                        {
                            var position = index;
                            <button class="mobile-button primary" aria-pressed="@(_myVotePosition == position)" style="@(_myVotePosition == position ? "outline:3px solid #17211f;" : null)" disabled="@_busy" @onclick="() => VoteAsync(position)">
                                @GetPositionLabel(position) (@GetPositionVoteCount(position))
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="mobile-alert">Warte auf den Zug von @ReadString(Game, "currentTeamName").</div>
            }
        }
        else if (ReadString(Game, "phase") == "revealed")
        {
            var song = ReadObject(Game, "currentSong");
            <div class="mobile-alert @(ReadBool(Game, "lastGuessCorrect") ? "success" : "error")">
                @(ReadBool(Game, "lastGuessCorrect") ? "Richtig!" : "Leider falsch.")
                @ReadString(song, "title") · @ReadString(song, "artist") (@ReadInt(song, "year"))
            </div>
            @if (ReadBool(VoteSummary, "tied"))
            {
                <div class="mobile-alert">Bei Gleichstand wurde die früheste Position gewählt.</div>
            }
        }

        <div style="display:grid;gap:16px;width:100%;max-width:720px;margin-top:20px;">
            @foreach (var team in ReadTeams())
            {
                <article style="padding:16px;border-radius:12px;background:white;box-shadow:0 2px 10px #182c2412;text-align:left;">
                    <h2 style="margin:0 0 10px;font-size:18px;">@team.Name <small>(@team.Timeline.Length/@ReadInt(Game, "cardsToWin", 10))</small></h2>
                    <div style="display:flex;flex-wrap:wrap;gap:8px;">
                        @foreach (var card in team.Timeline)
                        {
                            <span style="padding:8px 10px;border-radius:8px;background:#e7f1ee;">@card.Title · @card.Year</span>
                        }
                        @if (team.Timeline.Length == 0)
                        {
                            <span>Noch keine Karten</span>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="mobile-alert">Die Spielleitung bereitet Hitster vor.</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mobile-alert error" role="alert">@_error</div>
    }

    @if (_showTeamChat)
    {
        <div style="position:fixed;inset:0;z-index:10001;display:flex;flex-direction:column;padding:12px;background:#fff;box-sizing:border-box;">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:4px 0 12px;">
                <strong>Team-Chat</strong>
                <button type="button" class="mobile-button secondary" @onclick="() => _showTeamChat = false">Zurück zu Hitster</button>
            </div>
            <div style="flex:1;min-height:0;">
                <FrameworkChat ProjectId="@ProjectId" AccessToken="@AccessToken" ParticipantId="@ParticipantId" IsAdmin="false" />
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ParticipantId { get; set; }
    [Parameter] public Guid? TeamId { get; set; }
    [Inject] private ProjectApiClient ProjectApiClient { get; set; } = null!;

    private bool _busy;
    private bool _showTeamChat;
    private string? _error;
    private JsonElement Game => ReadObject(CurrentSlide.Parameters, "game");
    private bool GameStarted => ReadBool(Game, "started");
    private bool Finished => ReadBool(Game, "finished");
    private string[] WinnerNames => ReadStringArray(Game, "winnerNames");
    private Guid CurrentTeamId => GuidValue(Game, "currentTeamId");
    private bool IsMyTurn => TeamId is Guid teamId && teamId == CurrentTeamId;
    private JsonElement VoteSummary => ReadObject(Game, "voteSummary");
    private bool HasGuess => Game.ValueKind == JsonValueKind.Object &&
        Game.TryGetProperty("guessPosition", out var guess) && guess.ValueKind == JsonValueKind.Number;
    private TeamTimeline[] Teams => ReadTeams();
    private TimelineCard[] MyTimeline => Teams.FirstOrDefault(team => team.Id == TeamId)?.Timeline ?? [];
    private int? _myVotePosition;
    private int _voteRound;

    protected override void OnParametersSet()
    {
        var round = ReadInt(Game, "round");
        if (round != _voteRound)
        {
            _voteRound = round;
            _myVotePosition = null;
        }
    }

    private async Task VoteAsync(int position)
    {
        if (_busy || string.IsNullOrWhiteSpace(AccessToken))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await ProjectApiClient.SubmitHitsterVoteAsync(
                AccessToken, ProjectId, Event.EventId, CurrentSlide.SlideId, position);
            _myVotePosition = result.MyVotePosition;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string GetPositionLabel(int position) =>
        position == 0 ? "Ganz vorne" :
        position == MyTimeline.Length ? "Ganz hinten" :
        $"Zwischen {MyTimeline[position - 1].Year} und {MyTimeline[position].Year}";

    private int GetPositionVoteCount(int position)
    {
        if (VoteSummary.ValueKind != JsonValueKind.Object ||
            !VoteSummary.TryGetProperty("positions", out var positions) ||
            positions.ValueKind != JsonValueKind.Array)
        {
            return 0;
        }

        foreach (var vote in positions.EnumerateArray())
        {
            if (ReadInt(vote, "position", -1) == position)
            {
                return ReadInt(vote, "votes");
            }
        }

        return 0;
    }

    private TeamTimeline[] ReadTeams()
    {
        if (Game.ValueKind != JsonValueKind.Object ||
            !Game.TryGetProperty("teams", out var teams) ||
            teams.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return teams.EnumerateArray().Select(team => new TeamTimeline(
            GuidValue(team, "id"),
            ReadString(team, "name", "Team"),
            ReadCards(team))).ToArray();
    }

    private static TimelineCard[] ReadCards(JsonElement team) =>
        team.TryGetProperty("timeline", out var cards) && cards.ValueKind == JsonValueKind.Array
            ? cards.EnumerateArray().Select(card => new TimelineCard(
                ReadString(card, "title", "Song"),
                ReadInt(card, "year"))).ToArray()
            : [];

    private static JsonElement ReadObject(JsonElement value, string property) =>
        value.ValueKind == JsonValueKind.Object &&
        value.TryGetProperty(property, out var item) &&
        item.ValueKind == JsonValueKind.Object ? item : default;

    private static string ReadString(JsonElement value, string property, string fallback = "") =>
        value.ValueKind == JsonValueKind.Object &&
        value.TryGetProperty(property, out var item) &&
        item.ValueKind == JsonValueKind.String ? item.GetString() ?? fallback : fallback;

    private static int ReadInt(JsonElement value, string property, int fallback = 0) =>
        value.ValueKind == JsonValueKind.Object &&
        value.TryGetProperty(property, out var item) &&
        item.TryGetInt32(out var result) ? result : fallback;

    private static bool ReadBool(JsonElement value, string property) =>
        value.ValueKind == JsonValueKind.Object &&
        value.TryGetProperty(property, out var item) &&
        item.ValueKind == JsonValueKind.True;

    private static Guid GuidValue(JsonElement value, string property) =>
        Guid.TryParse(ReadString(value, property), out var result) ? result : Guid.Empty;

    private static string[] ReadStringArray(JsonElement value, string property) =>
        value.ValueKind == JsonValueKind.Object &&
        value.TryGetProperty(property, out var item) &&
        item.ValueKind == JsonValueKind.Array
            ? item.EnumerateArray().Where(entry => entry.ValueKind == JsonValueKind.String)
                .Select(entry => entry.GetString() ?? string.Empty).ToArray()
            : [];

    private sealed record TimelineCard(string Title, int Year);
    private sealed record TeamTimeline(Guid Id, string Name, TimelineCard[] Timeline);
}
