@using System.Text.Json
@using WeihnachtsfeierBit.Framework
@inject ProjectApiClient ProjectApiClient

<div style="flex: 1; width: 100%; padding: 16px 14px; box-sizing: border-box; background: #ffffff; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
        <span class="mobile-eyebrow" style="margin-bottom: 6px; font-size: 11px;">FREITEXT-FRAGE</span>
        <h2 style="font-size: 20px; font-weight: 800; margin: 0 0 16px 0; color: #1d2528;">@_question</h2>

        <form @onsubmit="SubmitTextAsync" @onsubmit:preventDefault="true" style="display: flex; flex-direction: column; gap: 12px;">
            <textarea value="@_textInput" @oninput="e => _textInput = e.Value?.ToString() ?? string.Empty" rows="4" maxlength="@_maxLength" placeholder="@_placeholder" style="width: 100%; padding: 12px; border: 1.5px solid #dce5e2; border-radius: 10px; font-family: inherit; font-size: 14px; box-sizing: border-box; resize: vertical;"></textarea>

            @if (!string.IsNullOrEmpty(_error))
            {
                <FrameworkNotice Message="@_error" Severity="error" />
            }

            @if (_submitted)
            {
                <FrameworkNotice Message="Deine Antwort wurde erfolgreich eingesendet!" Severity="success" />
            }

            <FrameworkButton Label="@(_submitted ? "Antwort aktualisieren" : "Antwort absenden")" Variant="primary" Type="submit" Busy="_isSubmitting" Disabled="@(string.IsNullOrWhiteSpace(_textInput))" />
        </form>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventState Event { get; set; } = null!;
    [Parameter, EditorRequired] public EventSlideState CurrentSlide { get; set; } = null!;
    [Parameter] public string? AccessToken { get; set; }
    [Parameter] public Guid ProjectId { get; set; }

    private string _textInput = string.Empty;
    private bool _isSubmitting;
    private bool _submitted;
    private string? _error;

    private string _question => ReadString(CurrentSlide.Parameters, "question");
    private string _placeholder => ReadString(CurrentSlide.Parameters, "placeholder");
    private int _maxLength => ReadInt(CurrentSlide.Parameters, "maxLength", 200);

    private async Task SubmitTextAsync()
    {
        if (string.IsNullOrWhiteSpace(_textInput) || string.IsNullOrEmpty(AccessToken)) return;
        _isSubmitting = true;
        _error = null;

        try
        {
            var payload = JsonSerializer.SerializeToElement(new { text = _textInput.Trim() });
            await ProjectApiClient.SubmitEventResponseAsync(AccessToken, ProjectId, Event.EventId, CurrentSlide.SlideId, payload);
            _submitted = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ReadString(JsonElement el, string prop) =>
        el.ValueKind == JsonValueKind.Object && el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

    private static int ReadInt(JsonElement el, string prop, int def) =>
        el.ValueKind == JsonValueKind.Object && el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt32() : def;
}
