@page "/beamer/{Code}"
@page "/canvas/{Code}"
@layout WeihnachtsfeierBit.ParticipantClient.Components.Layout.CanvasLayout
@using System.Text
@using System.Globalization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using QRCoder
@using WeihnachtsfeierBit.Framework
@using WeihnachtsfeierBit.ParticipantClient.Components.CanvasSlides
@implements IAsyncDisposable
@inject ProjectApiClient ProjectApiClient
@inject IConfiguration Configuration
@inject ILogger<Canvas> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>@(_state?.ProjectName ?? "Beamer")</PageTitle>

<main class="canvas-page" style="@CanvasScaleStyle">
    @if (_isLoading)
    {
        <div class="canvas-message">Beameransicht wird geladen …</div>
    }

    else if (!string.IsNullOrEmpty(_errorMessage) && _state is null)
    {
        <div class="canvas-message canvas-error" role="alert">@_errorMessage</div>
    }
    else if (_sessionEnded)
    {
        <div class="canvas-message">
            <div class="canvas-event-type">SESSION BEENDET</div>
            <h1>Vielen Dank fürs Mitspielen!</h1>
        </div>
    }
    else if (_state is not null)
    {
        var displaySettings = _state.DisplaySettings ?? CanvasDisplaySettings.Default;
        var activeTeam = _state.ActiveTeamId is Guid activeTeamId
            ? _state.Teams.FirstOrDefault(team => team.Id == activeTeamId)
            : null;
        var showActiveTeam = displaySettings.ShowActiveTeam && activeTeam is not null;
        var showHeader = displaySettings.ShowProjectTitle ||
                         showActiveTeam ||
                         (displaySettings.QrCodeMode == CanvasDisplaySettings.QrCodeCard &&
                          !string.IsNullOrEmpty(_qrCodeDataUri));

        <div class="canvas-surface @(showHeader ? "has-header" : null)">
        @if (showHeader)
        {
            <header class="canvas-header">
                @if (displaySettings.ShowProjectTitle)
                {
                    <div class="canvas-brand">
                        <h1>@_state.ProjectName</h1>
                    </div>
                }
                @if (showActiveTeam)
                {
                    <div class="canvas-active-team" aria-live="polite">
                        <span>JETZT AM ZUG</span>
                        <strong>Team @activeTeam!.DisplayName</strong>
                    </div>
                }
                <div class="canvas-header-actions">
                    @if (displaySettings.QrCodeMode == CanvasDisplaySettings.QrCodeCard &&
                         !string.IsNullOrEmpty(_qrCodeDataUri))
                    {
                        <aside class="canvas-join-card" aria-label="Session beitreten">
                            <div class="canvas-join-copy">
                                <strong>@Code</strong>
                            </div>
                            <img class="canvas-join-qr" src="@_qrCodeDataUri" alt="QR-Code zum Beitreten zur Session" />
                        </aside>
                    }
                </div>
            </header>
        }

        <div class="canvas-content scoreboard-@displaySettings.ScoreboardLayout">
            <section class="canvas-event" aria-live="polite" @ref="_eventContainerElement">
                <div class="canvas-event-fit @(_state.Event is null ? null : "has-event")" @ref="_eventContentElement">
                    @if (_state.Event is CanvasEventState activeEvent)
                    {
                        var workflow = QuestionWorkflowViewState.Read(activeEvent.Parameters);
                        @if (displaySettings.ShowEventTypeLabel)
                        {
                            <div class="canvas-event-type">@GetEventTypeLabel(activeEvent.SlideType)</div>
                        }
                        var transitionKey = $"{activeEvent.EventId}:{activeEvent.SlideId}:{activeEvent.SlideType}:{workflow.Phase}";
                        <CanvasSlideView @key="transitionKey" Event="activeEvent" Teams="_mappedTeams" PointLogs="_state.PointLogs" />
                    }
                    else
                    {
                        @if (displaySettings.ShowEventTypeLabel)
                        {
                            <div class="canvas-event-type">BEREIT</div>
                        }
                        <h2>Die nächste Runde startet gleich</h2>
                        <p class="canvas-message-text">Der aktuelle Punktestand wird hier angezeigt.</p>
                    }
                </div>
            </section>

            @if (displaySettings.ScoreboardLayout == CanvasDisplaySettings.ScoreboardRight)
            {
                <section class="canvas-scoreboard" aria-label="Punktestand" @ref="_scoreboardContainerElement">
                    <div class="canvas-scoreboard-fit" @ref="_scoreboardContentElement">
                        <div class="canvas-scoreboard-heading">
                            <div class="canvas-event-type">PUNKTSTAND</div>
                        </div>
                        @if (_state.Teams.Length == 0)
                        {
                            <p class="canvas-empty">Noch keine Teams angelegt.</p>
                        }
                        else
                        {
                            <div class="canvas-scoreboard-chart">
                                <FrameworkChart Teams="_mappedTeams" ChartType="bar_chart" />
                            </div>
                        }
                    </div>
                </section>
            }
            else if (displaySettings.ScoreboardLayout == CanvasDisplaySettings.ScoreboardBottom)
            {
                <section class="canvas-scoreboard canvas-scoreboard-bottom" aria-label="Team-Punkte" @ref="_scoreboardContainerElement">
                    <div class="canvas-scoreboard-fit" @ref="_scoreboardContentElement">
                        @if (_state.Teams.Length == 0)
                        {
                            <span class="canvas-empty">Noch keine Teams angelegt.</span>
                        }
                        else
                        {
                            @foreach (var team in _state.Teams.OrderBy(team => team.Rank))
                            {
                                <div class="canvas-score-point">
                                    <span class="canvas-score-rank">@team.Rank</span>
                                    <span class="canvas-score-team">@team.DisplayName</span>
                                    <strong>@team.Points Pkt.</strong>
                                </div>
                            }
                        }
                    </div>
                </section>
            }
        </div>

        @if (displaySettings.QrCodeMode == CanvasDisplaySettings.QrCodePopup &&
             !string.IsNullOrEmpty(_qrCodeDataUri))
        {
            <aside class="canvas-join-overlay" aria-label="Teilnahmeinformationen" @ref="_popupContainerElement">
                <div class="canvas-join-popup" @ref="_popupContentElement">
                    <div class="canvas-event-type">JETZT MITMACHEN</div>
                    <h2>Mit dem Smartphone teilnehmen</h2>
                    <p>Scanne den QR-Code oder öffne die Teilnehmerseite und gib den Session-Code ein.</p>
                    <img src="@_qrCodeDataUri" alt="QR-Code zum Beitreten zur Session" />
                    <div class="canvas-join-code-label">SESSION-CODE</div>
                    <strong class="canvas-join-code">@Code</strong>
                </div>
            </aside>
        }
        </div>
    }
</main>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    private CanvasGameState? _state;
    private HubConnection? _hubConnection;
    private IJSObjectReference? _canvasFitModule;
    private IJSObjectReference? _eventFitObserver;
    private IJSObjectReference? _scoreboardFitObserver;
    private IJSObjectReference? _popupFitObserver;
    private string? _scoreboardFitLayout;
    private ElementReference _eventContainerElement;
    private ElementReference _eventContentElement;
    private ElementReference _scoreboardContainerElement;
    private ElementReference _scoreboardContentElement;
    private ElementReference _popupContainerElement;
    private ElementReference _popupContentElement;
    private CancellationTokenSource? _connectionCancellation;
    private Task? _connectionRecoveryTask;
    private bool _isLoading = true;
    private bool _sessionEnded;
    private string? _errorMessage;
    private string? _qrCodeDataUri;

    private string CanvasScaleStyle
    {
        get
        {
            var settings = _state?.DisplaySettings ?? CanvasDisplaySettings.Default;
            var eventScale = settings.EventScalePercent / 100d;
            var scoreboardScale = settings.ScoreboardScalePercent / 100d;
            return $"--canvas-font-scale:{Scale(settings.FontScalePercent)};" +
                   $"--canvas-spacing-scale:{Scale(settings.SpacingScalePercent)};" +
                   $"--canvas-event-scale:{Scale(settings.FontScalePercent, settings.EventScalePercent)};" +
                   $"--canvas-scoreboard-scale:{Scale(settings.FontScalePercent, settings.ScoreboardScalePercent)};" +
                   $"--canvas-qr-scale:{Scale(settings.QrCodeScalePercent)};" +
                   $"--canvas-popup-scale:{Scale(settings.FontScalePercent, settings.QrCodeScalePercent)};" +
                   $"--canvas-event-column-weight:{ScaleWeight(1.25d * eventScale)}fr;" +
                   $"--canvas-scoreboard-column-weight:{ScaleWeight(0.85d * scoreboardScale)}fr;" +
                   $"--canvas-event-row-weight:{ScaleWeight(eventScale)}fr;" +
                   $"--canvas-scoreboard-row-weight:{ScaleWeight(0.18d * scoreboardScale)}fr;";
        }
    }

    private static string Scale(int percent) =>
        (percent / 100d).ToString("0.##", CultureInfo.InvariantCulture);

    private static string Scale(int firstPercent, int secondPercent) =>
        ((firstPercent / 100d) * (secondPercent / 100d))
            .ToString("0.####", CultureInfo.InvariantCulture);

    private static string ScaleWeight(double value) =>
        value.ToString("0.####", CultureInfo.InvariantCulture);

    private TeamSummary[] _mappedTeams =>
        _state?.Teams.Select(t => new TeamSummary(t.Id, t.DisplayName, t.Color, t.Points)).ToArray() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        await StopConnectionAsync();

        _isLoading = true;
        _errorMessage = null;
        _state = null;
        _sessionEnded = false;

        if (Code.Length != 6 || !Code.All(char.IsAsciiDigit))
        {
            _errorMessage = "Der Beamer-Link enthält keinen gültigen Session-Code.";
            _isLoading = false;
            return;
        }

        try
        {
            UpdateQrCode();
            await ConnectAsync();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void UpdateQrCode()
    {
        var target = Navigation.ToAbsoluteUri($"{Navigation.BaseUri}{Uri.EscapeDataString(Code)}").AbsoluteUri;
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(target, QRCodeGenerator.ECCLevel.M);
        var svg = new SvgQRCode(data).GetGraphic(6);
        _qrCodeDataUri = $"data:image/svg+xml;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(svg))}";
    }

    private async Task ConnectAsync()
    {
        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https+http://apiservice";
        var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/canvas";

        var connection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .Build();
        _hubConnection = connection;

        connection.On<CanvasGameState>("CanvasStateUpdated", state =>
            InvokeAsync(async () =>
            {
                _state = state;
                StateHasChanged();
            }));

        connection.On("CanvasSessionEnded", () => InvokeAsync(() =>
        {
            _sessionEnded = true;
            StateHasChanged();
        }));

        _connectionCancellation = new CancellationTokenSource();
        _connectionRecoveryTask = RecoverConnectionAsync(connection, Code, _connectionCancellation.Token);

        _state = await ProjectApiClient.GetCanvasStateAsync(Code);
    }

    private async Task RecoverConnectionAsync(HubConnection connection, string code, CancellationToken cancellationToken)
    {
        await HubConnectionRecovery.RunAsync(
            connection,
            async token =>
            {
                await connection.SendAsync("JoinCanvas", code, token);
                var state = await ProjectApiClient.GetCanvasStateAsync(code, token);
                await InvokeAsync(() =>
                {
                    _state = state;
                    _sessionEnded = false;
                    StateHasChanged();
                });
            },
            exception => Logger.LogWarning(exception, "Die Live-Verbindung der Beameransicht wird erneut aufgebaut."),
            _ => Task.CompletedTask,
            cancellationToken);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_state is null || _sessionEnded)
        {
            _eventFitObserver = await DisposeFitObserverAsync(_eventFitObserver);
            _scoreboardFitObserver = await DisposeFitObserverAsync(_scoreboardFitObserver);
            _popupFitObserver = await DisposeFitObserverAsync(_popupFitObserver);
            _scoreboardFitLayout = null;
            return;
        }

        try
        {
            _canvasFitModule ??= await JavaScript.InvokeAsync<IJSObjectReference>(
                "import", "./js/canvas-fit.js");

            if (_eventFitObserver is null)
            {
                _eventFitObserver = await _canvasFitModule.InvokeAsync<IJSObjectReference>(
                    "observeCanvasFit", _eventContainerElement, _eventContentElement);
            }
            else
            {
                await _eventFitObserver.InvokeVoidAsync("refresh");
            }

            var displaySettings = _state.DisplaySettings ?? CanvasDisplaySettings.Default;
            if (displaySettings.ScoreboardLayout == CanvasDisplaySettings.ScoreboardHidden)
            {
                _scoreboardFitObserver = await DisposeFitObserverAsync(_scoreboardFitObserver);
                _scoreboardFitLayout = displaySettings.ScoreboardLayout;
            }
            else if (_scoreboardFitObserver is null ||
                     _scoreboardFitLayout != displaySettings.ScoreboardLayout)
            {
                _scoreboardFitObserver = await DisposeFitObserverAsync(_scoreboardFitObserver);
                _scoreboardFitObserver = await _canvasFitModule.InvokeAsync<IJSObjectReference>(
                    "observeCanvasFit", _scoreboardContainerElement, _scoreboardContentElement);
                _scoreboardFitLayout = displaySettings.ScoreboardLayout;
            }
            else
            {
                await _scoreboardFitObserver.InvokeVoidAsync("refresh");
            }

            if (displaySettings.QrCodeMode == CanvasDisplaySettings.QrCodePopup &&
                !string.IsNullOrEmpty(_qrCodeDataUri))
            {
                if (_popupFitObserver is null)
                {
                    _popupFitObserver = await _canvasFitModule.InvokeAsync<IJSObjectReference>(
                        "observeCanvasFit", _popupContainerElement, _popupContentElement);
                }
                else
                {
                    await _popupFitObserver.InvokeVoidAsync("refresh");
                }
            }
            else
            {
                _popupFitObserver = await DisposeFitObserverAsync(_popupFitObserver);
            }
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception, "Die Beamer-Größenanpassung wurde wegen einer getrennten UI-Verbindung übersprungen.");
        }
    }

    private async Task<IJSObjectReference?> DisposeFitObserverAsync(IJSObjectReference? observer)
    {
        if (observer is null)
        {
            return null;
        }

        try
        {
            await observer.InvokeVoidAsync("dispose");
            await observer.DisposeAsync();
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception, "Die Beamer-Größenanpassung konnte nach dem Trennen der UI-Verbindung nicht bereinigt werden.");
        }

        return null;
    }

    private async Task StopConnectionAsync()
    {
        _connectionCancellation?.Cancel();
        if (_connectionRecoveryTask is not null)
        {
            await _connectionRecoveryTask;
            _connectionRecoveryTask = null;
        }

        _connectionCancellation?.Dispose();
        _connectionCancellation = null;
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
            _hubConnection = null;
        }
    }

    private static string GetEventTypeLabel(string slideType) => slideType.ToLowerInvariant() switch
    {
        "announcement" => "ANKÜNDIGUNG",
        "poll" => "ABSTIMMUNG",
        "quiz" => "QUIZ",
        "estimation" => "SCHÄTZFRAGE",
        "buzzer" => "BUZZER",
        "ranking" => "PUNKTSTAND",
        "hitster" => "HITSTER · SPOTIFY",
        "jeopardy" => "JEOPARDY",
        "pantomime" => "PANTOMIME",
        "pointaward" => "PUNKTEVERGABE",
        "text" => "FREITEXT",
        "wordcloud" => "WORTWOLKE",
        "slider" => "SCHIEBEREGLER",
        "rating" => "BEWERTUNG",
        "ordering" => "REIHENFOLGE",
        "countdown" => "COUNTDOWN",
        _ => "EVENT"
    };

    public async ValueTask DisposeAsync()
    {
        await StopConnectionAsync();
        _eventFitObserver = await DisposeFitObserverAsync(_eventFitObserver);
        _scoreboardFitObserver = await DisposeFitObserverAsync(_scoreboardFitObserver);
        _popupFitObserver = await DisposeFitObserverAsync(_popupFitObserver);
        if (_canvasFitModule is not null)
        {
            try
            {
                await _canvasFitModule.DisposeAsync();
            }
            catch (JSDisconnectedException exception)
            {
                Logger.LogDebug(exception, "Das Beamer-JavaScript-Modul konnte nach dem Trennen der UI-Verbindung nicht freigegeben werden.");
            }
        }
    }
}
