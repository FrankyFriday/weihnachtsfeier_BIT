@page "/beamer/{Code}"
@page "/canvas/{Code}"
@layout WeihnachtsfeierBit.ParticipantClient.Components.Layout.CanvasLayout
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using WeihnachtsfeierBit.Framework
@implements IAsyncDisposable
@inject ProjectApiClient ProjectApiClient
@inject IConfiguration Configuration
@inject ILogger<Canvas> Logger

<PageTitle>@(_state?.ProjectName ?? "Beamer") | WeihnachtsfeierBIT</PageTitle>

<main class="canvas-page">
    @if (_isLoading)
    {
        <div class="canvas-message">Beameransicht wird geladen …</div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage) && _state is null)
    {
        <div class="canvas-message canvas-error" role="alert">@_errorMessage</div>
    }
    else if (_sessionEnded)
    {
        <div class="canvas-message">
            <div class="canvas-event-type">SESSION BEENDET</div>
            <h1>Vielen Dank fürs Mitspielen!</h1>
        </div>
    }
    else if (_state is not null)
    {
        <header class="canvas-header">
            <div>
                <div class="canvas-eyebrow">LIVE · @_state.ProjectName</div>
                <h1>WeihnachtsfeierBIT</h1>
            </div>
            <div class="canvas-connection">
                <span class="canvas-connection-dot @(_isConnected ? "connected" : "")"></span>
                @_connectionStatus
            </div>
        </header>

        <div class="canvas-content">
            <section class="canvas-event" aria-live="polite">
                @if (_state.Event is CanvasEventState activeEvent)
                {
                    <div class="canvas-event-type">@GetEventTypeLabel(activeEvent.SlideType)</div>
                    <h2>@GetEventHeading(activeEvent)</h2>
                    @if (activeEvent.SlideType.Equals("announcement", StringComparison.OrdinalIgnoreCase))
                    {
                        <p class="canvas-message-text">@ReadString(activeEvent.Parameters, "message")</p>
                    }
                    else if (activeEvent.SlideType.Equals("poll", StringComparison.OrdinalIgnoreCase) ||
                             activeEvent.SlideType.Equals("quiz", StringComparison.OrdinalIgnoreCase))
                    {
                        var options = ReadStringList(activeEvent.Parameters,
                            activeEvent.SlideType.Equals("poll", StringComparison.OrdinalIgnoreCase) ? "options" : "answers");
                        @if (options.Length > 0)
                        {
                            <ol class="canvas-options">
                                @foreach (var option in options)
                                {
                                    <li>@option</li>
                                }
                            </ol>
                        }
                    }
                    else if (activeEvent.SlideType.Equals("estimation", StringComparison.OrdinalIgnoreCase))
                    {
                        <p class="canvas-unit">@ReadString(activeEvent.Parameters, "unit")</p>
                    }
                    else if (activeEvent.SlideType.Equals("ranking", StringComparison.OrdinalIgnoreCase))
                    {
                        <div style="margin-top: 16px; width: 100%;">
                            <FrameworkChart Teams="_mappedTeams" ChartType="@GetChartType(activeEvent)" PointLogs="_state.PointLogs" />
                        </div>
                    }
                    else if (activeEvent.SlideType.Equals("hitster", StringComparison.OrdinalIgnoreCase))
                    {
                        var game = ReadObject(activeEvent.Parameters, "game");
                        @if (ReadBool(game, "started"))
                        {
                            @if (ReadBool(game, "finished"))
                            {
                                <p class="canvas-message-text">
                                    @if (ReadStringList(game, "winnerNames") is { Length: > 0 } winners)
                                    {
                                        <span>Spiel beendet · @string.Join(", ", winners) @(winners.Length == 1 ? "hat" : "haben") gewonnen.</span>
                                    }
                                    else
                                    {
                                        <span>Spiel beendet.</span>
                                    }
                                </p>
                            }
                            else
                            {
                                <p class="canvas-message-text">Runde @ReadInt(game, "round") · @ReadString(game, "currentTeamName") ist dran</p>
                            }
                            @if (ReadString(game, "phase") == "revealed")
                            {
                                var song = ReadObject(game, "currentSong");
                                <h3>@ReadString(song, "title") · @ReadString(song, "artist") (@ReadInt(song, "year"))</h3>
                            }
                            <div class="canvas-hitster-teams">
                                @if (game.TryGetProperty("teams", out var teams) && teams.ValueKind == JsonValueKind.Array)
                                {
                                    @foreach (var team in teams.EnumerateArray())
                                    {
                                        <div>
                                            <strong>@ReadString(team, "name")</strong>
                                            <ol class="canvas-options">
                                                @if (team.TryGetProperty("timeline", out var timeline) && timeline.ValueKind == JsonValueKind.Array)
                                                {
                                                    @foreach (var card in timeline.EnumerateArray())
                                                    {
                                                        <li>@ReadString(card, "title") · @ReadInt(card, "year")</li>
                                                    }
                                                }
                                            </ol>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <p class="canvas-message-text">Die Spielleitung bereitet Hitster vor.</p>
                        }
                    }
                }
                else
                {
                    <div class="canvas-event-type">BEREIT</div>
                    <h2>Die nächste Runde startet gleich</h2>
                    <p class="canvas-message-text">Der aktuelle Punktestand wird live angezeigt.</p>
                }
            </section>

            <section class="canvas-scoreboard" aria-label="Live-Punktestand">
                <div class="canvas-scoreboard-heading">
                    <div class="canvas-event-type">LIVE-PUNKTSTAND</div>
                    <h2>Teams</h2>
                    @if (_state.Teams.Length > 0)
                    {
                        <p>@_state.Teams.Length @(_state.Teams.Length == 1 ? "Team" : "Teams") im Wettbewerb</p>
                    }
                </div>
                @if (_state.Teams.Length == 0)
                {
                    <p class="canvas-empty">Noch keine Teams angelegt.</p>
                }
                else
                {
                    <div style="margin-top: 12px;">
                        <FrameworkChart Teams="_mappedTeams" ChartType="bar_chart" />
                    </div>
                }
            </section>
        </div>
    }
</main>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    private CanvasGameState? _state;
    private HubConnection? _hubConnection;
    private CancellationTokenSource? _connectionCancellation;
    private Task? _connectionRecoveryTask;
    private bool _isLoading = true;
    private bool _isConnected;
    private bool _sessionEnded;
    private string _connectionStatus = "Verbinde …";
    private string? _errorMessage;

    private TeamSummary[] _mappedTeams =>
        _state?.Teams.Select(t => new TeamSummary(t.Id, t.DisplayName, "#105c4d", t.Points)).ToArray() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        await StopConnectionAsync();

        _isLoading = true;
        _errorMessage = null;
        _state = null;
        _sessionEnded = false;
        _isConnected = false;

        if (Code.Length != 6 || !Code.All(char.IsAsciiDigit))
        {
            _errorMessage = "Der Beamer-Link enthält keinen gültigen Session-Code.";
            _isLoading = false;
            return;
        }

        try
        {
            await ConnectAsync();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ConnectAsync()
    {
        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https+http://apiservice";
        var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/canvas";

        var connection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .Build();
        _hubConnection = connection;

        connection.On<CanvasGameState>("CanvasStateUpdated", state =>
            InvokeAsync(async () =>
            {
                _state = state;
                StateHasChanged();
            }));

        connection.On("CanvasSessionEnded", () => InvokeAsync(() =>
        {
            _sessionEnded = true;
            _connectionStatus = "Session beendet";
            StateHasChanged();
        }));

        _connectionCancellation = new CancellationTokenSource();
        _connectionRecoveryTask = RecoverConnectionAsync(connection, Code, _connectionCancellation.Token);

        _state = await ProjectApiClient.GetCanvasStateAsync(Code);
    }

    private async Task RecoverConnectionAsync(HubConnection connection, string code, CancellationToken cancellationToken)
    {
        await HubConnectionRecovery.RunAsync(
            connection,
            async token =>
            {
                await connection.SendAsync("JoinCanvas", code, token);
                var state = await ProjectApiClient.GetCanvasStateAsync(code, token);
                await InvokeAsync(() =>
                {
                    _state = state;
                    _sessionEnded = false;
                    StateHasChanged();
                });
            },
            exception => Logger.LogWarning(exception, "Die Live-Verbindung der Beameransicht wird erneut aufgebaut."),
            isConnected => InvokeAsync(() =>
            {
                _isConnected = isConnected;
                _connectionStatus = isConnected
                    ? "Live aktualisiert"
                    : "Verbindung wird automatisch wiederhergestellt";
                StateHasChanged();
            }),
            cancellationToken);
    }

    private async Task StopConnectionAsync()
    {
        _connectionCancellation?.Cancel();
        if (_connectionRecoveryTask is not null)
        {
            await _connectionRecoveryTask;
            _connectionRecoveryTask = null;
        }

        _connectionCancellation?.Dispose();
        _connectionCancellation = null;
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
            _hubConnection = null;
        }
    }

    private static string GetChartType(CanvasEventState activeEvent)
    {
        var chartType = ReadString(activeEvent.Parameters, "chartType");
        return !string.IsNullOrEmpty(chartType) ? chartType : "bar_chart";
    }

    private static string GetEventTypeLabel(string slideType) => slideType.ToLowerInvariant() switch
    {
        "announcement" => "ANKÜNDIGUNG",
        "poll" => "ABSTIMMUNG",
        "quiz" => "QUIZ",
        "estimation" => "SCHÄTZFRAGE",
        "buzzer" => "BUZZER",
        "ranking" => "PUNKTSTAND",
        "hitster" => "HITSTER · SPOTIFY",
        _ => "LIVE-EVENT"
    };

    private static string GetEventHeading(CanvasEventState activeEvent)
    {
        var parameterName = activeEvent.SlideType.ToLowerInvariant() switch
        {
            "announcement" => "title",
            "poll" => "question",
            "quiz" => "question",
            "estimation" => "question",
            "buzzer" => "question",
            _ => string.Empty
        };

        return string.IsNullOrEmpty(parameterName)
            ? activeEvent.Title
            : ReadString(activeEvent.Parameters, parameterName) is { Length: > 0 } heading
                ? heading
                : activeEvent.Title;
    }

    private static string ReadString(JsonElement parameters, string propertyName) =>
        parameters.ValueKind == JsonValueKind.Object &&
        parameters.TryGetProperty(propertyName, out var value) &&
        value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;

    private static JsonElement ReadObject(JsonElement parameters, string propertyName) =>
        parameters.ValueKind == JsonValueKind.Object &&
        parameters.TryGetProperty(propertyName, out var value) &&
        value.ValueKind == JsonValueKind.Object ? value : default;

    private static int ReadInt(JsonElement parameters, string propertyName) =>
        parameters.ValueKind == JsonValueKind.Object &&
        parameters.TryGetProperty(propertyName, out var value) &&
        value.TryGetInt32(out var result) ? result : 0;

    private static bool ReadBool(JsonElement parameters, string propertyName) =>
        parameters.ValueKind == JsonValueKind.Object &&
        parameters.TryGetProperty(propertyName, out var value) &&
        value.ValueKind == JsonValueKind.True;

    private static string[] ReadStringList(JsonElement parameters, string propertyName)
    {
        if (parameters.ValueKind != JsonValueKind.Object ||
            !parameters.TryGetProperty(propertyName, out var value) ||
            value.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return value.EnumerateArray()
            .Where(item => item.ValueKind == JsonValueKind.String)
            .Select(item => item.GetString() ?? string.Empty)
            .ToArray();
    }

    public async ValueTask DisposeAsync()
    {
        await StopConnectionAsync();
    }
}
