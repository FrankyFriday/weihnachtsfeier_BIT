@page "/"
@page "/{CodeOrParam}"
@using Microsoft.AspNetCore.SignalR.Client
@inject ProjectApiClient ProjectApiClient
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ILogger<PlayHome> Logger
@implements IAsyncDisposable

<PageTitle>@(_resolvedSession?.ProjectName ?? _project?.Name ?? "Teilnehmer") | WeihnachtsfeierBIT</PageTitle>

@if (_isLoading)
{
    <div style="max-width: 400px; margin: 100px auto; padding: 20px;">
        <FrameworkLoading Message="Wird geladen ..." />
    </div>
}
else if (!_isLoggedIn)
{
    <ParticipantLoginView SessionCodeInput="@_sessionCodeInput"
                          ResolvedSession="@_resolvedSession"
                          Project="_project"
                          ErrorMessage="@_errorMessage"
                          IsSubmitting="@_isSubmitting"
                          ParticipantNumberInput="@_participantNumberInput"
                          SessionCodeChanged="v => _sessionCodeInput = v"
                          ParticipantNumberChanged="v => _participantNumberInput = v"
                          OnCheckCode="CheckCodeAsync"
                          OnLogin="LoginByCodeAsync"
                          OnResetCode="ResetCode" />
}
else if (_isDisconnected)
{
    <!-- FULLSCREEN DISCONNECTED OVERLAY -->
    <div style="position: fixed; inset: 0; z-index: 99999; background: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center;">
        <span class="material-symbols-outlined" style="font-size: 64px; color: #dc2626; margin-bottom: 16px;">wifi_off</span>
        <h2 style="font-size: 22px; font-weight: 800; color: #1d2528; margin: 0 0 8px 0;">Verbindung unterbrochen</h2>
        <p style="font-size: 14px; color: #64748b; margin: 0 0 24px 0; max-width: 320px;">Es konnte keine Verbindung zum Spielserver hergestellt werden. Bitte überprüfe deine Internetverbindung.</p>
        <FrameworkButton Label="Neu verbinden" Variant="primary" OnClick="ReconnectSignalRAsync" Busy="_isReconnecting" />
    </div>
}
else if (_isSessionEnded)
{
    <!-- FULLSCREEN SESSION ENDED OVERLAY -->
    <div style="position: fixed; inset: 0; z-index: 99999; background: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center;">
        <span class="material-symbols-outlined" style="font-size: 64px; color: #105c4d; margin-bottom: 16px;">celebration</span>
        <h2 style="font-size: 22px; font-weight: 800; color: #1d2528; margin: 0 0 8px 0;">Session beendet</h2>
        <p style="font-size: 14px; color: #64748b; margin: 0 0 24px 0; max-width: 320px;">Vielen Dank für deine Teilnahme! Die Session wurde vom Spielleiter beendet.</p>
        <FrameworkButton Label="Neue Session beitreten" Variant="primary" OnClick="ResetSessionAndGoToJoin" />
    </div>
}
else if (_liveGameState?.IsPaused == true)
{
    <!-- FULLSCREEN SESSION PAUSED OVERLAY -->
    <div style="position: fixed; inset: 0; z-index: 99999; background: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center;">
        <span class="material-symbols-outlined" style="font-size: 64px; color: #105c4d; margin-bottom: 16px;">pause_circle</span>
        <h2 style="font-size: 22px; font-weight: 800; color: #1d2528; margin: 0 0 8px 0;">Session aktuell pausiert</h2>
        <p style="font-size: 14px; color: #64748b; margin: 0 0 24px 0; max-width: 320px;">Der Spielleiter hat die Session vorübergehend pausiert. Bitte gedulde dich einen kurzen Moment...</p>
        <div style="width: 32px; height: 32px; border: 3px solid #e8f3ef; border-top-color: #105c4d; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
    </div>
}
else if (_liveGameState?.ActiveEvent is EventState activeEv && !activeEv.IsHidden)
{
    <ParticipantEventView Event="activeEv" Teams="CurrentTeamsSummary" AccessToken="@_accessToken" ProjectId="@ProjectId" ParticipantId="@(_participant?.Id ?? Guid.Empty)" TeamId="@_participant?.TeamId" ShowBackButton="false" />
}
else if (_selectedPassiveEvent is EventState passiveEv)
{
    <ParticipantEventView Event="passiveEv" Teams="CurrentTeamsSummary" AccessToken="@_accessToken" ProjectId="@ProjectId" ParticipantId="@(_participant?.Id ?? Guid.Empty)" TeamId="@_participant?.TeamId" ShowBackButton="true" OnBack="ClosePassiveEvent" />
}
else
{
    <ParticipantDashboardView ProjectName="@(_resolvedSession?.ProjectName ?? _project?.Name ?? "Projekt")"
                              ParticipantNumber="@(_participant?.Number ?? 0)"
                              ParticipantId="@(_participant?.Id ?? Guid.Empty)"
                              AccessToken="@(_accessToken ?? string.Empty)"
                              ProjectId="@ProjectId"
                              TeamState="CurrentTeamState"
                              AllTeams="AllTeamStates"
                              PassiveEvents="_liveGameState?.PassiveEvents ?? []"
                              ScheduledEvents="_liveGameState?.ScheduledEvents ?? []"
                              NameInput="@_nameInput"
                              IsSavingName="@_isSavingName"
                              ErrorMessage="@_errorMessage"
                              SuccessMessage="@_successMessage"
                              NameInputChanged="v => _nameInput = v"
                              OnSaveName="SaveMyNameAsync"
                              OnSelectPassiveEvent="OpenPassiveEvent"
                              HubConnection="_hubConnection" />
}

@code {
    [Parameter] public string? CodeOrParam { get; set; }

    private Guid ProjectId { get; set; }
    private string? _sessionCodeInput;
    private ResolveCodeResponse? _resolvedSession;

    private string? _accessToken;
    private ParticipantSummary? _participant;
    private ProjectResponse? _project;
    private ProjectGameState? _liveGameState;
    private EventState? _selectedPassiveEvent;

    private bool _isLoggedIn;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool _isSavingName;
    private bool _isDisconnected;
    private bool _isReconnecting;
    private bool _isSessionEnded;

    private string? _errorMessage;
    private string? _successMessage;

    private int _participantNumberInput = 10;
    private string _nameInput = string.Empty;

    private HubConnection? _hubConnection;
    private CancellationTokenSource? _connectionCancellation;
    private Task? _connectionRecoveryTask;

    private TeamState? CurrentTeamState { get; set; }

    private TeamState[] AllTeamStates => _liveGameState?.Teams ?? [];

    private TeamSummary[] CurrentTeamsSummary => _liveGameState?.Teams.Select(t => new TeamSummary(t.Id, t.DisplayName, t.Color, t.Points)).ToArray() ?? [];

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        if (!string.IsNullOrWhiteSpace(CodeOrParam))
        {
            var code = CodeOrParam.Trim().ToUpperInvariant();
            if (code.Length == 6 && code.All(char.IsLetterOrDigit))
            {
                _sessionCodeInput = code;
                await CheckCodeAsync();
            }
        }
        _isLoading = false;
    }

    private async Task CheckCodeAsync()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_sessionCodeInput))
        {
            _errorMessage = "Bitte gib einen 6-stelligen Code ein.";
            return;
        }

        _isSubmitting = true;
        try
        {
            _resolvedSession = await ProjectApiClient.ResolveCodeAsync(_sessionCodeInput);
            ProjectId = _resolvedSession.ProjektId;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task LoginByCodeAsync()
    {
        if (_resolvedSession is null || string.IsNullOrWhiteSpace(_sessionCodeInput)) return;
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var login = await ProjectApiClient.LoginByCodeAsync(
                _sessionCodeInput,
                _participantNumberInput);

            _accessToken = login.AccessToken;
            _participant = new ParticipantSummary(login.ParticipantId ?? login.SessionId, _participantNumberInput, login.DisplayName, login.TeamId);
            _nameInput = login.DisplayName;
            _isLoggedIn = true;

            await SetupSignalRAsync();
            _liveGameState = await ProjectApiClient.GetSessionStateAsync(_accessToken, ProjectId);
            UpdateCurrentTeamState();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetCode()
    {
        _resolvedSession = null;
        _project = null;
        _sessionCodeInput = string.Empty;
        _errorMessage = null;
    }

    private void OpenPassiveEvent(EventState ev) => _selectedPassiveEvent = ev;
    private void ClosePassiveEvent() => _selectedPassiveEvent = null;

    private async Task SaveMyNameAsync()
    {
        if (string.IsNullOrWhiteSpace(_accessToken) || string.IsNullOrWhiteSpace(_nameInput)) return;

        _isSavingName = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            _participant = await ProjectApiClient.UpdateMyNameAsync(_accessToken, ProjectId, _nameInput.Trim());
            _successMessage = "Dein Name wurde gespeichert.";
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSavingName = false;
        }
    }

    private async Task SetupSignalRAsync()
    {
        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https+http://apiservice";
        var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/gamestate";

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
                options.AccessTokenProvider = () => Task.FromResult<string?>(_accessToken))
            .Build();

        _hubConnection.On<ProjectGameState>("GameStateUpdated", (state) =>
        {
            if (state.ProjectId == ProjectId)
            {
                return InvokeAsync(() => ApplyLiveGameState(state));
            }

            return Task.CompletedTask;
        });

        _hubConnection.On("SessionRevoked", () =>
        {
            return InvokeAsync(() =>
            {
                _accessToken = null;
                _participant = null;
                _liveGameState = null;
                _selectedPassiveEvent = null;
                CurrentTeamState = null;
                _isLoggedIn = false;
                _connectionCancellation?.Cancel();
                _errorMessage = "Deine Sitzung wurde beendet. Bitte melde dich erneut an.";
                StateHasChanged();
            });
        });

        _connectionCancellation = new CancellationTokenSource();
        _connectionRecoveryTask = RecoverConnectionAsync(_hubConnection, _connectionCancellation.Token);
    }

    private async Task ReconnectSignalRAsync()
    {
        _isReconnecting = true;
        try
        {
            if (_hubConnection is not null && _hubConnection.State != HubConnectionState.Disconnected)
            {
                await _hubConnection.StopAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Die Teilnehmersitzung konnte nicht sofort neu verbunden werden.");
            _isDisconnected = true;
        }
        finally
        {
            _isReconnecting = false;
        }
    }

    private async Task RecoverConnectionAsync(HubConnection connection, CancellationToken cancellationToken)
    {
        await HubConnectionRecovery.RunAsync(
            connection,
            async token =>
            {
                await connection.SendAsync("JoinProject", ProjectId, token);
                var state = await ProjectApiClient.GetSessionStateAsync(_accessToken!, ProjectId, token);
                await InvokeAsync(() => ApplyLiveGameState(state));
            },
            exception => Logger.LogWarning(exception, "Die Spielverbindung wird automatisch wiederhergestellt."),
            isConnected => InvokeAsync(() =>
            {
                _isDisconnected = !isConnected;
                StateHasChanged();
            }),
            cancellationToken);
    }

    private void ApplyLiveGameState(ProjectGameState state)
    {
        _liveGameState = state;
        _isDisconnected = false;
        _isSessionEnded = state.IsEnded;
        UpdateCurrentTeamState();

        if (_selectedPassiveEvent is not null)
        {
            _selectedPassiveEvent = state.PassiveEvents
                .FirstOrDefault(e => e.EventId == _selectedPassiveEvent.EventId);
        }

        StateHasChanged();
    }

    private void ResetSessionAndGoToJoin()
    {
        _isLoggedIn = false;
        _accessToken = null;
        _participant = null;
        _liveGameState = null;
        _isSessionEnded = false;
        _isDisconnected = false;
        Navigation.NavigateTo("/", forceLoad: false);
    }

    private void UpdateCurrentTeamState()
    {
        if (_liveGameState is null || _participant is null) return;

        var myTeam = _liveGameState.Teams.FirstOrDefault(t => t.Members.Any(m => m.Id == _participant.Id) || (_participant.TeamId.HasValue && t.Id == _participant.TeamId.Value));
        CurrentTeamState = myTeam;
    }

    public async ValueTask DisposeAsync()
    {
        _connectionCancellation?.Cancel();
        if (_connectionRecoveryTask is not null)
        {
            await _connectionRecoveryTask;
        }

        _connectionCancellation?.Dispose();
        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.SendAsync("LeaveProject", ProjectId);
                await _hubConnection.DisposeAsync();
            }
            catch
            {
            }
        }
    }
}
