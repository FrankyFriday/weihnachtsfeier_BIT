@page "/play/{ProjectId:guid}"
@page "/play"
@inject ProjectApiClient ProjectApiClient
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.SignalR.Client
@using WeihnachtsfeierBit.Framework
@implements IAsyncDisposable

<PageTitle>@( _project?.Name ?? "Teilnehmer" ) | WeihnachtsfeierBIT</PageTitle>

<div class="play-container">
    @if (ProjectId == Guid.Empty)
    {
        <div class="mobile-card">
            <h2>Projekt auswählen</h2>
            <p>Bitte rufe die Adresse mit einer gültigen Projekt-ID auf, z. B. <code>/play/PROJEKT-ID</code>.</p>
        </div>
    }
    else if (_isLoading)
    {
        <div class="mobile-card text-center">
            <div class="spinner"></div>
            <p style="margin-top: 12px; color: #657276;">Wird geladen ...</p>
        </div>
    }
    else if (!_isLoggedIn)
    {
        <div class="mobile-card">
            <div class="mobile-card-header">
                <span class="mobile-eyebrow">TEILNEHMER-LOGIN</span>
                <h1>@(_project?.Name ?? "Willkommen!")</h1>
                <p>Gib deine persönliche Teilnehmernummer ein, um deinem Team beizutreten.</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mobile-alert error">@_errorMessage</div>
            }

            <form @onsubmit="LoginAsync" @onsubmit:preventDefault="true" class="mobile-form">
                <div class="mobile-field">
                    <label for="participant-number">Deine Nummer</label>
                    <input id="participant-number" type="number" min="1" class="mobile-input large-text" @bind="_participantNumberInput" placeholder="z. B. 12" required />
                </div>
                <button type="submit" class="mobile-button primary" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Melde an ..." : "Anmelden & Beitreten")
                </button>
            </form>
        </div>
    }
    else
    {
        <header class="play-header">
            <div>
                <span class="mobile-eyebrow">@_project?.Name</span>
                <h2>Teilnehmer #@_participant?.Number</h2>
            </div>
            <div class="connection-status @(_isConnected ? "online" : "offline")">
                <span class="status-dot"></span>
                @(_isConnected ? "Live" : "Verbinde ...")
            </div>
        </header>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mobile-alert error">@_errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="mobile-alert success">@_successMessage</div>
        }

        <!-- Hero Team Card -->
        @if (CurrentTeamState is not null)
        {
            <div class="mobile-card hero-team-card" style="border-top: 6px solid @CurrentTeamState.Color;">
                <div class="hero-team-header">
                    <span class="hero-team-badge" style="background-color: @CurrentTeamState.Color;">
                        #@CurrentTeamState.Rank
                    </span>
                    <div>
                        <span class="mobile-eyebrow">DEIN TEAM</span>
                        <h1 class="hero-team-title">@CurrentTeamState.DisplayName</h1>
                    </div>
                </div>

                <div class="hero-stats-grid">
                    <div class="stat-box">
                        <span class="stat-label">Rang</span>
                        <strong class="stat-value">#@CurrentTeamState.Rank <small>/ @TotalTeamCount</small></strong>
                    </div>
                    <div class="stat-box">
                        <span class="stat-label">Punktestand</span>
                        <strong class="stat-value">@CurrentTeamState.Points <small>Pkt.</small></strong>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="mobile-card warning-card">
                <h3>Kein Team zugewiesen</h3>
                <p>Du bist aktuell noch keinem Team zugeordnet. Der Moderator weist dich gleich zu!</p>
            </div>
        }

        <!-- Profil Name Form -->
        <div class="mobile-card">
            <h3>Dein Profil</h3>
            <form @onsubmit="SaveMyNameAsync" @onsubmit:preventDefault="true" class="mobile-form inline-form">
                <div class="mobile-field" style="flex: 1;">
                    <label for="my-name">Dein Name</label>
                    <input id="my-name" type="text" maxlength="120" class="mobile-input" @bind="_nameInput" placeholder="z. B. Alex" />
                </div>
                <button type="submit" class="mobile-button secondary" disabled="@_isSavingName" style="align-self: flex-end;">
                    @(_isSavingName ? "..." : "Speichern")
                </button>
            </form>
        </div>

        <!-- Teammates List -->
        @if (CurrentTeamState is not null && CurrentTeamState.Members.Length > 0)
        {
            <div class="mobile-card">
                <h3>Team-Mitglieder (@CurrentTeamState.Members.Length)</h3>
                <ul class="member-list">
                    @foreach (var member in CurrentTeamState.Members)
                    {
                        <li class="member-item @(member.Id == _participant?.Id ? "me" : "")">
                            <span class="member-number">#@member.Number</span>
                            <span class="member-name">@(string.IsNullOrWhiteSpace(member.Name) ? "Unbenannt" : member.Name)</span>
                            @if (member.Id == _participant?.Id)
                            {
                                <span class="me-tag">(Du)</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Leaderboard -->
        @if (AllTeamStates.Length > 0)
        {
            <div class="mobile-card">
                <h3>Gesamtrangliste</h3>
                <div class="leaderboard-list">
                    @foreach (var team in AllTeamStates)
                    {
                        <div class="leaderboard-item @(team.Id == CurrentTeamState?.Id ? "my-team" : "")">
                            <span class="lb-rank">#@team.Rank</span>
                            <span class="lb-color-dot" style="background-color: @team.Color;"></span>
                            <span class="lb-name">@team.DisplayName</span>
                            <strong class="lb-points">@team.Points Pkt.</strong>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private string? _accessToken;
    private ParticipantSummary? _participant;
    private ProjectResponse? _project;
    private ProjectGameState? _liveGameState;

    private bool _isLoggedIn;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool _isSavingName;
    private bool _isConnected;

    private string? _errorMessage;
    private string? _successMessage;

    private int _participantNumberInput = 10;
    private string _nameInput = string.Empty;

    private HubConnection? _hubConnection;

    private TeamState? CurrentTeamState
    {
        get;
        set;
    }

    private TeamState[] AllTeamStates => _liveGameState?.Teams ?? [];
    private int TotalTeamCount => AllTeamStates.Length;

    protected override async Task OnInitializedAsync()
    {
        if (ProjectId == Guid.Empty)
        {
            _isLoading = false;
            return;
        }

        try
        {
            var projectTask = ProjectApiClient.GetProjectAsync(string.Empty, ProjectId);
            _project = await projectTask;
        }
        catch
        {
            // Project might require auth or not found
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoginAsync()
    {
        if (_isSubmitting || ProjectId == Guid.Empty) return;

        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            var session = await ProjectApiClient.LoginParticipantAsync(ProjectId, _participantNumberInput);
            _accessToken = session.AccessToken;
            _isLoggedIn = true;

            await LoadProfileAsync();
            await SetupSignalRAsync();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task LoadProfileAsync()
    {
        if (string.IsNullOrEmpty(_accessToken)) return;

        try
        {
            _participant = await ProjectApiClient.GetMyProfileAsync(_accessToken, ProjectId);
            _nameInput = _participant.Name ?? string.Empty;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task SaveMyNameAsync()
    {
        if (_isSavingName || string.IsNullOrEmpty(_accessToken) || _participant is null) return;

        _errorMessage = null;
        _successMessage = null;
        _isSavingName = true;

        try
        {
            _participant = await ProjectApiClient.UpdateMyNameAsync(_accessToken, ProjectId, _nameInput.Trim());
            _successMessage = "Dein Name wurde gespeichert.";
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSavingName = false;
        }
    }

    private async Task SetupSignalRAsync()
    {
        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https+http://apiservice";
        var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/gamestate";

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<ProjectGameState>("GameStateUpdated", (state) =>
        {
            if (state.ProjectId == ProjectId)
            {
                _liveGameState = state;
                UpdateCurrentTeamState();
                InvokeAsync(StateHasChanged);
            }
        });

        _hubConnection.Reconnecting += _ =>
        {
            _isConnected = false;
            InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };

        _hubConnection.Reconnected += _ =>
        {
            _isConnected = true;
            InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };

        try
        {
            await _hubConnection.StartAsync();
            await _hubConnection.SendAsync("JoinProject", ProjectId);
            _isConnected = true;
        }
        catch
        {
            _isConnected = false;
        }
    }

    private void UpdateCurrentTeamState()
    {
        if (_liveGameState is null || _participant is null) return;

        var myTeam = _liveGameState.Teams.FirstOrDefault(t => t.Members.Any(m => m.Id == _participant.Id) || (_participant.TeamId.HasValue && t.Id == _participant.TeamId.Value));
        CurrentTeamState = myTeam;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.SendAsync("LeaveProject", ProjectId);
                await _hubConnection.DisposeAsync();
            }
            catch
            {
            }
        }
    }
}
