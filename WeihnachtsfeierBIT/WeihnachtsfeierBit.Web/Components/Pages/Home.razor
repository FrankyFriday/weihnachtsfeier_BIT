@page "/"
@layout WeihnachtsfeierBit.Web.Components.Layout.LandingLayout
@inject NavigationManager Navigation

<PageTitle>Session beitreten | WeihnachtsfeierBIT</PageTitle>

<main class="join-page">
    <div class="join-container">
        <header class="join-header">
            <a class="join-brand" href="/" aria-label="WeihnachtsfeierBIT Startseite">
                <span class="join-brand-mark material-symbols-outlined" aria-hidden="true">celebration</span>
                <span>WeihnachtsfeierBIT</span>
            </a>
            <a class="join-admin-link" href="/admin">Admin <span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
        </header>

        <section class="join-content" aria-labelledby="join-title">
            <span class="join-icon material-symbols-outlined" aria-hidden="true">sports_esports</span>
            <h1 id="join-title">Session beitreten</h1>
            <p class="join-description">Gib den Session-Code ein, um weiterzumachen.</p>

            <Card Class="join-card">
                <div class="join-card-content">
                    <form class="join-form" @onsubmit="JoinSession" @onsubmit:preventDefault="true">
                        <label for="session-code">Session-Code</label>
                        <FrameworkInputText Id="session-code"
                                           Value="@_sessionCode"
                                           ValueChanged="UpdateSessionCode"
                                           MaxLength="6"
                                           Placeholder="6-stelliger Code"
                                           autocomplete="off"
                                           autocapitalize="characters"
                                           spellcheck="false"
                                           aria-describedby="session-code-help" />
                        <FrameworkButton Label="Beitreten"
                                         Type="submit"
                                         Icon="arrow_forward"
                                         Class="join-submit"
                                         Disabled="@(_sessionCode.Length != 6)" />
                    </form>
                    <p id="session-code-help" class="join-help">Den Code bekommst du von der Spielleitung.</p>
                    @if (!string.IsNullOrEmpty(_sessionCodeError))
                    {
                        <p class="join-error" role="alert">@_sessionCodeError</p>
                    }
                </div>
            </Card>
        </section>
    </div>
</main>

@code {
    private string _sessionCode = string.Empty;
    private string? _sessionCodeError;

    private void UpdateSessionCode(string? value)
    {
        _sessionCode = value ?? string.Empty;
        _sessionCodeError = null;
    }

    private void JoinSession()
    {
        var code = _sessionCode.Trim().ToUpperInvariant();
        if (code.Length != 6 || !code.All(char.IsLetterOrDigit))
        {
            _sessionCodeError = "Bitte gib einen gültigen 6-stelligen Session-Code ein.";
            return;
        }

        Navigation.NavigateTo($"/play/{Uri.EscapeDataString(code)}", forceLoad: true);
    }
}
