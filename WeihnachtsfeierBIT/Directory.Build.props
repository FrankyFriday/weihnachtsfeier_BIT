<Project>
  <PropertyGroup>
    <DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>
    <BuildCompressedStaticWebAssets>false</BuildCompressedStaticWebAssets>
  </PropertyGroup>

  <Target Name="ApplyCompressionNegotiation" />
  <Target Name="BuildCompressedStaticWebAssets" />
</Project>