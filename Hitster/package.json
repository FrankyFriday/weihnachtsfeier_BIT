{
  "name": "hitster-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "import": "node --env-file=.env --import tsx src/import-playlist.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
